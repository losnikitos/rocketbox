<% content_for(:title, "Rocketbox for #{@use_case[:label]}") %>

<section class="pb-12 pt-4 lg:pb-16 lg:pt-2">
  <p class="text-sm font-medium text-ink-500"><%= @use_case[:label] %></p>
  <h1 class="mt-3 max-w-3xl font-manrope text-[clamp(2rem,5vw,3.75rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-ink-900 text-balance">
    <%= @use_case[:headline] %>
  </h1>
  <p class="mt-6 max-w-xl text-[17px] font-medium leading-relaxed text-ink-500">
    <%= @use_case[:lede] %>
  </p>
  <%= render "shared/waitlist_cta", container_class: "mt-8 flex flex-wrap items-center gap-3" %>
</section>

<section class="border-t border-ink-900/10 py-12 lg:py-16" aria-labelledby="demo-heading">
  <h2 id="demo-heading" class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 sm:text-3xl">
    You send a photo. We make the reel.
  </h2>
  <p class="mt-3 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
    Same workflow for every shop: a still from the floor becomes a short video ready for your socials.
  </p>

  <div class="mt-10 space-y-14">
    <% @use_case[:demos].each do |demo| %>
      <%= render "use_cases/demo_pair", demo: demo %>
    <% end %>
    <% if @use_case[:account] %>
      <%= render "use_cases/instagram_account", account: @use_case[:account] %>
    <% end %>
    <% if @use_case[:maps] %>
      <%= render "use_cases/google_maps_listing", maps: @use_case[:maps] %>
    <% end %>
    <% if @use_case[:contact_card] %>
      <%= render "use_cases/contact_card", contact_card: @use_case[:contact_card] %>
    <% end %>
  </div>
</section>

<section class="border-t border-ink-900/10 py-12 lg:py-16" aria-labelledby="how-heading">
  <h2 id="how-heading" class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 sm:text-3xl">
    How it works
  </h2>
  <ol class="mt-8 grid gap-8 sm:grid-cols-3">
    <li>
      <p class="text-sm font-medium text-ink-500">1</p>
      <h3 class="mt-2 font-manrope text-lg font-extrabold tracking-[-0.02em] text-ink-900">Send the media</h3>
      <p class="mt-2 text-[15px] font-medium leading-relaxed text-ink-500">Photo or clip from the chair, the plate, or the bay. No shoot day.</p>
    </li>
    <li>
      <p class="text-sm font-medium text-ink-500">2</p>
      <h3 class="mt-2 font-manrope text-lg font-extrabold tracking-[-0.02em] text-ink-900">We edit and post</h3>
      <p class="mt-2 text-[15px] font-medium leading-relaxed text-ink-500">Cut, caption, and publish to your socials on a cadence that fits the shop.</p>
    </li>
    <li>
      <p class="text-sm font-medium text-ink-500">3</p>
      <h3 class="mt-2 font-manrope text-lg font-extrabold tracking-[-0.02em] text-ink-900">You keep working</h3>
      <p class="mt-2 text-[15px] font-medium leading-relaxed text-ink-500">Stay on the craft. Marketing runs in the background without another hire.</p>
    </li>
  </ol>
</section>

<section class="border-t border-ink-900/10 py-12 lg:py-16">
  <h2 class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 sm:text-3xl">
    Ready when you are
  </h2>
  <p class="mt-3 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
    Start with <%= @use_case[:label].downcase %>. Expand when the next location opens.
  </p>
  <%= render "shared/waitlist_cta", container_class: "mt-8 flex flex-wrap items-center gap-3" %>
</section>
