<%# locals: demo (photo:, video:, caption:, video_is_image?:) %>
<figure class="grid items-end gap-6 sm:grid-cols-2 sm:gap-8">
  <div>
    <p class="mb-3 text-xs font-medium uppercase tracking-wide text-ink-500">You send</p>
    <%= image_tag demo[:photo], alt: "#{demo[:caption]} — photo you send", class: "w-full object-cover", loading: "lazy" %>
  </div>
  <div>
    <p class="mb-3 text-xs font-medium uppercase tracking-wide text-ink-500">We make</p>
    <%= render layout: "shared/iphone_frame", locals: { username: demo[:caption].to_s.parameterize, caption: demo[:caption] } do %>
      <% if demo[:video_is_image] %>
        <%= image_tag demo[:video], alt: "#{demo[:caption]} — reel placeholder", class: "h-full w-full object-cover", loading: "lazy" %>
      <% else %>
        <video
          class="h-full w-full object-cover"
          src="<%= demo[:video] %>"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="<%= demo[:caption] %> — reel we generate"
        ></video>
      <% end %>
    <% end %>
  </div>
</figure>
