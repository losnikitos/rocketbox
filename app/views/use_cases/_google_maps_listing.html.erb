<%# locals: maps (…), headed: (default true) %>
<% maps = local_assigns.fetch(:maps) %>
<% headed = local_assigns.fetch(:headed, true) %>
<figure>
  <% if headed %>
    <p class="mb-3 text-xs font-medium uppercase tracking-wide text-ink-500">Your Google Maps page</p>
    <p class="mb-4 max-w-sm text-[13px] font-medium leading-relaxed text-ink-500">
      The same sends land on your listing so searchers see fresh work.
    </p>
  <% end %>
  <%= render layout: "shared/iphone_shell" do %>
    <div class="flex h-full flex-col overflow-hidden bg-[#F1F3F4] text-ink-900" aria-label="<%= maps[:name] %> Google Maps listing">
      <%# sheet handle + map peek %>
      <div class="relative h-8 shrink-0 bg-[#E8EAED]">
        <div class="absolute inset-x-0 bottom-0 h-5 rounded-t-2xl bg-white" aria-hidden="true">
          <div class="mx-auto mt-1.5 h-1 w-8 rounded-full bg-ink-900/15"></div>
        </div>
      </div>

      <div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-t-2xl bg-white">
        <%# header %>
        <div class="shrink-0 px-3 pt-1">
          <div class="flex items-start justify-between gap-2">
            <p class="text-[15px] font-semibold leading-tight tracking-tight"><%= maps[:name] %></p>
            <div class="flex shrink-0 items-center gap-2.5 pt-0.5 text-ink-500">
              <%= heroicon "bookmark", variant: :outline, options: { class: "size-3.5" } %>
              <%= heroicon "share", variant: :outline, options: { class: "size-3.5" } %>
              <%= heroicon "x-mark", variant: :mini, options: { class: "size-3.5" } %>
            </div>
          </div>

          <div class="mt-0.5 flex flex-wrap items-center gap-x-1 text-[9px] leading-tight text-ink-500">
            <span class="font-medium tabular-nums text-ink-900"><%= maps[:rating] %></span>
            <span class="tracking-tighter text-[#F9AB00]" aria-hidden="true">★★★★★</span>
            <span class="tabular-nums">(<%= maps[:reviews] %>)</span>
            <%= heroicon "information-circle", variant: :mini, options: { class: "size-2.5 text-ink-400" } %>
          </div>

          <div class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-[9px] text-ink-500">
            <span class="inline-flex items-center gap-0.5">
              <%= heroicon "map", variant: :mini, options: { class: "size-2.5" } %>
              <%= maps[:travel] %>
            </span>
            <span><%= maps[:category] %></span>
          </div>

          <p class="mt-0.5 text-[9px] font-medium text-[#1E8E3E]"><%= maps[:status] %></p>
        </div>

        <%# actions %>
        <div class="mt-2 flex shrink-0 gap-1.5 overflow-hidden px-3">
          <span class="inline-flex items-center gap-1 rounded-full bg-[#00897B] px-2.5 py-1 text-[9px] font-medium text-white">
            <%= heroicon "arrow-right", variant: :mini, options: { class: "size-3" } %>
            Directions
          </span>
          <span class="inline-flex items-center gap-1 rounded-full border border-[#00897B]/40 bg-[#E0F2F1] px-2.5 py-1 text-[9px] font-medium text-[#00897B]">
            <%= heroicon "paper-airplane", variant: :mini, options: { class: "size-3" } %>
            Start
          </span>
          <span class="inline-flex items-center gap-1 rounded-full border border-[#00897B]/40 bg-[#E0F2F1] px-2.5 py-1 text-[9px] font-medium text-[#00897B]">
            <%= heroicon "calendar", variant: :mini, options: { class: "size-3" } %>
            Book
          </span>
          <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-[#00897B]/40 bg-[#E0F2F1] text-[#00897B]">
            <%= heroicon "phone", variant: :mini, options: { class: "size-3" } %>
          </span>
        </div>

        <%# media collage: 2 stacked left + tall right %>
        <div class="mt-2.5 grid shrink-0 grid-cols-2 gap-1 px-3" style="height: 5.5rem;">
          <div class="grid grid-rows-2 gap-1">
            <% maps[:collage].first(2).each do |tile| %>
              <div class="relative overflow-hidden rounded-md bg-ink-100">
                <%= image_tag tile[:src], alt: "", class: "absolute inset-0 h-full w-full object-cover", loading: "lazy" %>
                <% if tile[:reel] %>
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
                    <span class="flex size-5 items-center justify-center rounded-full bg-black/45 text-white">
                      <%= heroicon "play", variant: :mini, options: { class: "size-3" } %>
                    </span>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="relative overflow-hidden rounded-md bg-ink-100">
            <%= image_tag maps[:collage][2][:src], alt: "", class: "absolute inset-0 h-full w-full object-cover", loading: "lazy" %>
          </div>
        </div>

        <%# tabs %>
        <div class="mt-2 flex shrink-0 gap-3 overflow-hidden border-b border-ink-900/10 px-3 text-[9px] font-medium text-ink-500">
          <span class="border-b-2 border-[#00897B] pb-1.5 text-[#00897B]">Overview</span>
          <span class="pb-1.5">Services</span>
          <span class="pb-1.5">Reviews</span>
          <span class="pb-1.5">Photos</span>
          <span class="pb-1.5">Updates</span>
        </div>

        <%# delivery hours (replaces Know before you go) %>
        <div class="mx-3 mt-2 shrink-0 rounded-xl bg-[#EEF3FF] px-2.5 py-2">
          <div class="flex items-center gap-1.5">
            <%= heroicon "clock", variant: :mini, options: { class: "size-3.5 text-[#1A73E8]" } %>
            <p class="text-[10px] font-semibold text-ink-900">Delivery hours</p>
          </div>
          <ul class="mt-1.5 space-y-0.5">
            <% maps[:delivery_hours].each do |row| %>
              <li class="flex justify-between text-[9px] text-ink-700">
                <span><%= row[:day] %></span>
                <span class="tabular-nums <%= row[:hours] == "Closed" ? "text-ink-500" : "font-medium" %>"><%= row[:hours] %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <%# hours accordion %>
        <div class="mx-3 mt-2 flex shrink-0 items-center gap-1.5 rounded-xl bg-ink-900/[0.04] px-2.5 py-2">
          <%= heroicon "clock", variant: :mini, options: { class: "size-3.5 text-ink-700" } %>
          <span class="flex-1 text-[10px] font-semibold">Hours</span>
          <%= heroicon "chevron-down", variant: :mini, options: { class: "size-3.5 text-ink-500" } %>
        </div>
      </div>
    </div>
  <% end %>
</figure>
