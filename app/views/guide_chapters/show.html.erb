<% content_for(:title, "#{@chapter.title} — #{@guide.title} — Rocketbox") %>

<article class="pb-16 pt-4 lg:pb-24 lg:pt-2">
  <header class="max-w-3xl border-b border-ink-900/10 pb-10">
    <p class="text-sm font-semibold uppercase tracking-wide text-ink-500">
      <%= link_to "Guides", guides_path, class: "text-ink-500 hover:text-ink-900" %>
      <span class="text-ink-300">/</span>
      <%= link_to @guide.title, guide_path(@guide), class: "text-ink-500 hover:text-ink-900" %>
      <span class="text-ink-300">/</span>
      <span>Chapter</span>
    </p>
    <div class="mt-3">
      <%= render "guides/access_badge", guide: @guide %>
    </div>
    <h1 class="mt-4 font-manrope text-[clamp(2.25rem,5vw,4.5rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-ink-900 text-balance">
      <%= @chapter.title %>
    </h1>
    <% if @chapter.lede.present? %>
      <p class="mt-6 max-w-2xl text-[17px] font-medium leading-relaxed text-ink-500">
        <%= @chapter.lede %>
      </p>
    <% end %>
  </header>

  <div class="mt-10 grid gap-12 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
    <nav class="lg:sticky lg:top-8 lg:self-start" aria-label="Rules">
      <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Rules</p>
      <ol class="mt-3 space-y-2">
        <% @chapter.rules.each do |rule| %>
          <li>
            <%= link_to "##{rule.fragment}",
                  class: "flex gap-2 text-[15px] font-medium text-ink-500 no-underline hover:text-ink-900" do %>
              <span class="font-mono text-ink-400"><%= rule.label %></span>
              <span><%= rule.title %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </nav>

    <div class="guide-body max-w-3xl space-y-16 text-[17px] font-medium leading-relaxed text-ink-600
      [&_h2]:scroll-mt-24 [&_h2]:font-manrope [&_h2]:text-3xl [&_h2]:font-extrabold [&_h2]:tracking-[-0.03em] [&_h2]:text-ink-900
      [&_p]:mt-4 [&_p]:first:mt-0
      [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5
      [&_strong]:font-semibold [&_strong]:text-ink-900
      [&_a]:font-medium [&_a]:text-rocket [&_a]:underline">
      <% @chapter.rules.each do |rule| %>
        <section id="<%= rule.fragment %>" aria-labelledby="<%= rule.fragment %>-title">
          <p class="font-mono text-sm text-ink-400"><%= rule.label %></p>
          <h2 id="<%= rule.fragment %>-title"><%= rule.title %></h2>
          <div class="mt-4">
            <%= render_guide_markdown(rule.body) %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</article>
