<% content_for(:title, "Join the waitlist — Rocketbox") %>

<section class="mx-auto max-w-lg pb-16 pt-4 lg:pb-20 lg:pt-2">
  <h1 class="font-manrope text-[clamp(2rem,5vw,3rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-ink-900 text-balance">
    Join the closed beta
  </h1>
  <p class="mt-4 text-[17px] font-medium leading-relaxed text-ink-500">
    Tell us about your business. If it’s a fit, we’ll send a personalized pack. Like it — full onboarding comes next.
  </p>

  <%= form_with model: @entry, url: try_path, class: "mt-10 space-y-5" do |form| %>
    <% if @entry.errors.any? %>
      <div class="<%= tw_alert_error_classes %> space-y-1" role="alert">
        <p class="font-medium"><%= pluralize(@entry.errors.count, "issue") %> to fix:</p>
        <ul class="list-inside list-disc text-sm">
          <% @entry.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :business_link, "Business link", class: tw_label_classes %>
      <%= form.text_field :business_link, required: true, autofocus: true, autocomplete: "url", placeholder: "Website or Instagram", class: tw_input_classes %>
    </div>

    <div>
      <%= form.label :email, class: tw_label_classes %>
      <%= form.email_field :email, required: true, autocomplete: "email", class: tw_input_classes %>
    </div>

    <div>
      <%= form.label :phone, class: tw_label_classes %>
      <%= form.telephone_field :phone, required: true, autocomplete: "tel", class: tw_input_classes %>
    </div>

    <div class="pt-1">
      <%= form.submit "Join waitlist", class: tw_btn_primary_classes %>
    </div>
  <% end %>
</section>
