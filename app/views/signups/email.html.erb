<% content_for(:title, "Your email — Rocketbox") %>

<%= render layout: "shared/auth_card" do %>
  <h1 class="text-center font-manrope text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Your email</h1>
  <p class="mt-1 text-center text-sm text-ink-600">We’ll send a confirmation code here.</p>

  <%= form_with url: sign_up_email_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email, "Email", class: tw_label_classes %>
      <%= form.email_field :email, value: @email, required: true, autofocus: true, autocomplete: "email", class: tw_input_classes %>
    </div>
    <div class="pt-1">
      <%= form.submit "Continue", class: tw_btn_primary_classes %>
    </div>
  <% end %>
<% end %>
