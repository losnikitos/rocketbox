<% content_for(:title, "Your name — Rocketbox") %>

<%= render layout: "shared/auth_card" do %>
  <h1 class="text-center font-manrope text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Your name</h1>
  <p class="mt-1 text-center text-sm text-ink-600">What should we call you?</p>

  <%= form_with url: sign_up_name_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :name, "Name", class: tw_label_classes %>
      <%= form.text_field :name, value: @name, required: true, autofocus: true, autocomplete: "name", class: tw_input_classes %>
    </div>
    <div class="pt-1">
      <%= form.submit "Continue", class: tw_btn_primary_classes %>
    </div>
  <% end %>
<% end %>
