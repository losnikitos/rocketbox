<% content_for(:title, "Your phone — Rocketbox") %>
<% content_for :top_right do %>
  <%= button_to "Skip", sign_up_phone_skip_path, method: :post, class: "text-sm font-medium text-ink-500 transition-colors hover:text-ink-900" %>
<% end %>

<%= render layout: "shared/auth_card" do %>
  <h1 class="text-center font-manrope text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Your phone number</h1>
  <p class="mt-1 text-center text-sm text-ink-600">So we can reach you on WhatsApp.</p>

  <%= form_with url: sign_up_phone_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :phone, "Phone number", class: tw_label_classes %>
      <%= form.telephone_field :phone, required: true, autofocus: true, autocomplete: "tel", class: tw_input_classes %>
    </div>
    <div class="pt-1">
      <%= form.submit "Continue", class: tw_btn_primary_classes %>
    </div>
  <% end %>
<% end %>
