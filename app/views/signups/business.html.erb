<% content_for(:title, "Your business — Rocketbox") %>

<%= render layout: "shared/auth_card" do %>
  <h1 class="text-center font-manrope text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Name of your business</h1>
  <p class="mt-1 text-center text-sm text-ink-600">We’ll use this across your marketing.</p>

  <%= form_with url: sign_up_business_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :business_name, "Business name", class: tw_label_classes %>
      <%= form.text_field :business_name, value: @business_name, required: true, autofocus: true, autocomplete: "organization", class: tw_input_classes %>
    </div>
    <div class="pt-1">
      <%= form.submit "Continue", class: tw_btn_primary_classes %>
    </div>
  <% end %>
<% end %>
