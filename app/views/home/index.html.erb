<% content_for(:title, "Rocketbox — Marketing for your business") %>

<% content_for :background do %>
  <div
    class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
    data-controller="hero-wave"
    aria-hidden="true"
  >
    <canvas data-hero-wave-target="canvas" class="absolute inset-0 h-full w-full"></canvas>
  </div>
<% end %>

<section class="pb-12 pt-4 lg:pb-16 lg:pt-2">
  <p class="text-sm font-medium text-ink-500">
    From the creators of
    <%= link_to "TADAAA!", "https://tadaaa.co.uk", target: "_blank", rel: "noopener", class: "font-semibold text-rocket hover:text-rocket-hover" %>
  </p>
  <h1 class="mt-6 font-manrope text-[clamp(2.5rem,6vw,5.5rem)] font-extrabold leading-[1.02] tracking-[-0.035em] text-ink-900 text-balance">
    We handle marketing for you<br class="hidden sm:block" />
    while you work.
  </h1>
  <p class="mt-6 max-w-xl text-[17px] font-medium leading-relaxed text-ink-500">
    Instagram for your business — Reels, Stories, and posts — without you doing the marketing.
  </p>
  <%= render "shared/get_started_cta", container_class: "mt-8 flex flex-wrap items-center gap-3" %>
</section>

<%= render "home/proof" %>
