<% content_for(:title, "Rocketbox — Marketing for small businesses") %>

<% content_for :background do %>
  <div
    class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
    data-controller="hero-wave"
    aria-hidden="true"
  >
    <canvas data-hero-wave-target="canvas" class="absolute inset-0 h-full w-full"></canvas>
  </div>
<% end %>

<section class="pb-16 pt-4 lg:pb-20 lg:pt-2">
  <h1 class="mt-6 font-manrope text-[clamp(2.5rem,6vw,5.5rem)] font-extrabold leading-[1.02] tracking-[-0.035em] text-ink-900 text-balance">
    Grow your business<br class="hidden sm:block" />
    while you do the work.
  </h1>
  <p class="mt-6 max-w-xl text-[17px] font-medium leading-relaxed text-ink-500">
    We handle the marketing side — social posts, promotions, and advertising — so you can stay focused on your craft.
  </p>
  <%= render "shared/subscription_action_buttons", container_class: "mt-8 flex flex-wrap items-center gap-3" %>
</section>
