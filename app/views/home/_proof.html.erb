<% barbershops = UseCasesController::REGISTRY.fetch("barbershops") %>
<% demos = barbershops.fetch(:demos) %>
<% account = barbershops.fetch(:account) %>

<section class="border-t border-ink-900/10 py-12 lg:py-16" aria-labelledby="proof-heading">
  <h2 id="proof-heading" class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 sm:text-3xl">
    How it works
  </h2>
  <p class="mt-3 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
    Send what you already capture at work. We turn it into posts and keep your presence fresh.
  </p>

  <%# Step 1: you send %>
  <div class="mt-10">
    <div class="flex gap-4">
      <span class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 tabular-nums" aria-hidden="true">1</span>
      <div>
        <h3 class="font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">You send while you work</h3>
        <p class="mt-1 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
          A quick photo or clip from the floor — no shoot, no schedule.
        </p>
      </div>
    </div>

    <div
      class="swiper mx-auto mt-8 w-56 overflow-visible py-6 sm:w-72"
      data-controller="swiper"
      data-swiper-effect="cards"
    >
      <div class="swiper-wrapper">
        <% demos.each do |demo| %>
          <div class="swiper-slide !h-auto overflow-hidden rounded-2xl ring-1 ring-ink-900/10 shadow-xl">
            <%= image_tag demo[:photo], class: "aspect-[3/4] w-full object-cover", loading: "lazy", alt: demo[:caption] %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Step 2: we keep channels updated %>
  <div class="mt-12">
    <div class="flex gap-4">
      <span class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 tabular-nums" aria-hidden="true">2</span>
      <div>
        <h3 class="font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">We keep your channels updated</h3>
        <p class="mt-1 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
          Reels, feed, Google Maps, and print when you need it — from the same sends.
        </p>
      </div>
    </div>

    <% slide = "flex w-full flex-col items-center text-center rb-surface-raised rb-shadow-card p-5 [&_figure]:flex [&_figure]:w-full [&_figure]:justify-center" %>
    <div
      class="swiper mt-8 -mx-4 pb-8 sm:-mx-6 lg:-mx-8"
      data-controller="swiper"
    >
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="<%= slide %>">
            <%= render "use_cases/instagram_account", account: account, headed: false %>
            <h3 class="mt-5 font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">Instagram</h3>
            <p class="mt-1 text-[13px] font-medium leading-relaxed text-ink-500">
              Your feed stays full from a week of sends.
            </p>
          </div>
        </div>

        <% demos.each do |demo| %>
          <div class="swiper-slide">
            <div class="<%= slide %>">
              <%= render layout: "shared/iphone_frame", locals: { username: account[:username] } do %>
                <% if demo[:video_is_image] %>
                  <%= image_tag demo[:video], alt: "", class: "h-full w-full object-cover", loading: "lazy" %>
                <% else %>
                  <video
                    class="h-full w-full object-cover"
                    src="<%= demo[:video] %>"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  ></video>
                <% end %>
              <% end %>
              <h3 class="mt-5 font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">Reel</h3>
              <p class="mt-1 text-[13px] font-medium leading-relaxed text-ink-500">
                Chair-side stills posted as reels, ready to watch.
              </p>
            </div>
          </div>
        <% end %>

        <div class="swiper-slide">
          <div class="<%= slide %>">
            <%= render "use_cases/google_maps_listing", maps: barbershops.fetch(:maps), headed: false %>
            <h3 class="mt-5 font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">Google Maps</h3>
            <p class="mt-1 text-[13px] font-medium leading-relaxed text-ink-500">
              Your listing stays fresh so searchers see recent work.
            </p>
          </div>
        </div>

        <div class="swiper-slide">
          <div class="<%= slide %>">
            <%= render "use_cases/contact_card", contact_card: barbershops.fetch(:contact_card), headed: false %>
            <h3 class="mt-5 font-manrope text-xl font-extrabold tracking-[-0.02em] text-ink-900">Contact cards</h3>
            <p class="mt-1 text-[13px] font-medium leading-relaxed text-ink-500">
              Same brand, printed — order cards when you need them.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="mt-10">
    <%= link_to "More examples", use_case_path("barbershops"), class: "rb-text-link text-[15px] font-medium" %>
  </p>
</section>
