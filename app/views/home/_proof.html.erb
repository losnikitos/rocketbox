<% barbershops = UseCasesController::REGISTRY.fetch("barbershops") %>
<% demos = barbershops.fetch(:demos) %>
<% account = barbershops.fetch(:account) %>

<section class="border-t border-ink-900/10 py-12 lg:py-16" aria-labelledby="proof-heading">
  <h2 id="proof-heading" class="font-manrope text-2xl font-extrabold tracking-[-0.03em] text-ink-900 sm:text-3xl">
    From your sends
  </h2>
  <p class="mt-3 max-w-xl text-[15px] font-medium leading-relaxed text-ink-500">
    One quick send from the floor. We turn it into content that keeps your presence fresh.
  </p>

  <%= render "home/demo", demos: demos, account: account %>
  <%= render "home/deliverables",
        demos: demos,
        account: account,
        maps: barbershops.fetch(:maps),
        contact_card: barbershops.fetch(:contact_card) %>

  <p class="mt-10">
    <%= link_to "More examples", use_case_path("barbershops"), class: "rb-text-link text-[15px] font-medium" %>
  </p>
</section>
