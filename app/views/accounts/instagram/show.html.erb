<% content_for(:title, "Instagram — Rocketbox") %>

<% if !Current.account.instagram_authorized? %>
  <p class="text-sm text-ink-500">Not connected yet.</p>
  <%= link_to "Connect Instagram", profile_instagram_authorize_path, class: "rb-btn-primary mt-4 px-4 py-2 text-sm" %>
<% else %>
  <% profile = Current.account.instagram_profile.to_h %>
  <% handle = profile["username"] %>
  <% username = capture do %>
    <% if handle.present? %>
      <%= link_to handle, "https://www.instagram.com/#{handle}", target: "_blank", rel: "noopener", class: "hover:underline" %>
    <% else %>
      Instagram
    <% end %>
  <% end %>

  <% if flash[:just_authorized] || params[:just_authorized] %>
    <div
      class="fixed inset-0 z-50 flex items-end justify-center bg-ink-900/40 sm:items-center"
      role="status"
      data-just-authorized
      onclick="this.remove()"
    >
      <div
        class="relative flex h-1/2 w-full flex-col items-center justify-center gap-2 rounded-t-2xl bg-white px-6 py-8 text-center sm:h-auto sm:max-w-sm sm:rounded-2xl sm:shadow-lg"
        onclick="event.stopPropagation()"
      >
        <button
          type="button"
          class="absolute top-3 right-3 rounded-lg p-1.5 text-ink-400 hover:bg-ink-900/5 hover:text-ink-900"
          aria-label="Dismiss"
          onclick="this.closest('[data-just-authorized]').remove()"
        >
          <%= heroicon "x-mark", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
        </button>
        <%= heroicon "check-circle", variant: :solid, options: { class: "size-16 text-signal-green", "aria-hidden": true } %>
        <p class="text-xl font-semibold text-ink-900">Authorized</p>
        <p class="text-sm text-ink-500">You can close this page now</p>
      </div>
    </div>
  <% end %>

  <div class="relative">
    <%= button_to profile_instagram_refresh_path,
          form: { class: "absolute top-0 right-0" },
          class: "rounded-lg p-1.5 text-ink-400 hover:bg-ink-900/5 hover:text-ink-900",
          aria: { label: "Fetch info" } do %>
      <%= heroicon "arrow-path", options: { class: "size-5", "aria-hidden": true } %>
    <% end %>

    <section class="mx-auto flex w-full max-w-3xl flex-col gap-6 sm:flex-row sm:items-start sm:gap-16 sm:px-6">
      <div class="flex items-center gap-4 sm:contents">
        <% if Current.account.instagram_avatar.attached? %>
          <%= image_tag Current.account.instagram_avatar, alt: "", class: "size-20 shrink-0 rounded-full object-cover ring-1 ring-ink-900/10 sm:size-36" %>
        <% else %>
          <span class="flex size-20 shrink-0 items-center justify-center rounded-full bg-ink-900/5 text-ink-400 sm:size-36">
            <%= heroicon "user", options: { class: "size-10 sm:size-16", "aria-hidden": true } %>
          </span>
        <% end %>
        <h2 class="min-w-0 flex-1 text-xl text-ink-900 sm:hidden"><%= username %></h2>
      </div>

      <div class="min-w-0 flex-1 space-y-4 sm:pt-2">
        <h2 class="hidden text-xl text-ink-900 sm:block"><%= username %></h2>

        <% if profile.blank? %>
          <p class="text-sm text-ink-500">No profile info fetched yet.</p>
        <% else %>
          <ul class="flex w-full justify-between gap-6 text-ink-900 sm:w-auto sm:justify-start sm:gap-10">
            <% { "media_count" => "posts", "followers_count" => "followers", "follows_count" => "following" }.each do |key, label| %>
              <li class="flex flex-col">
                <span class="font-semibold"><%= number_with_delimiter(profile[key].to_i) %></span>
                <span><%= label %></span>
              </li>
            <% end %>
          </ul>

          <div class="space-y-0.5 text-sm text-ink-900">
            <% if profile["name"].present? %>
              <p class="font-semibold"><%= profile["name"] %></p>
            <% end %>
            <% if profile["account_type"].present? %>
              <p class="text-ink-500"><%= profile["account_type"].humanize %></p>
            <% end %>
            <% if profile["biography"].present? %>
              <p class="whitespace-pre-line break-words"><%= profile["biography"] %></p>
            <% end %>
            <% if (website = profile["website"]).present? %>
              <%= link_to website.sub(%r{\Ahttps?://}, "").delete_suffix("/"), website, target: "_blank", rel: "noopener", class: "font-semibold text-rocket hover:underline" %>
            <% end %>
          </div>
        <% end %>

        <%= button_to "Disconnect", instagram_profile_path, method: :delete,
              form: { class: "w-full sm:w-auto", data: { turbo_confirm: "Disconnect #{handle.presence || "Instagram"}?" } },
              class: "w-full cursor-pointer rounded-lg border border-signal-red/40 bg-white px-3 py-1.5 text-sm font-semibold text-signal-red hover:bg-ink-900/5 sm:w-auto" %>
      </div>
    </section>
  </div>
<% end %>
