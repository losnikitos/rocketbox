<% content_for(:title, "#{@storyboard.name} — Storyboard — Rocketbox") %>
<% content_for(:fit, "true") %>
<% scenes = @storyboard.scenes(video_index: @video_index) %>

<% content_for(:breadcrumbs) do %>
  <%= link_to storyboards_path, class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
    <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Storyboard
  <% end %>
  <span class="text-sm text-ink-400">/</span>
  <span class="text-sm text-ink-700" aria-current="page"><%= @storyboard.name %></span>
<% end %>

<div class="flex min-w-0 flex-1 flex-col gap-4 md:min-h-0 md:gap-0">
  <div class="relative flex min-w-0 flex-1 items-center justify-center rounded-lg bg-ink-900 md:m-2">
    <div class="max-h-[70vh] w-full max-w-md overflow-hidden md:max-h-[calc(100vh-14rem)]"
         style="aspect-ratio: <%= @storyboard.size.join(" / ") %>">
      <iframe name="storyboard_preview" src="<%= canvas_storyboard_path(@storyboard, scene: @scene.slug, video: @video_index) %>"
              title="<%= @scene.label %> preview" class="size-full"></iframe>
    </div>
  </div>

  <nav aria-label="Scenes"
       class="relative flex shrink-0 gap-2 overflow-x-auto p-2 md:border-t md:border-ink-900/10 md:px-4 md:py-3">
    <ol class="flex gap-2.5">
      <% scenes.each_with_index do |scene, i| %>
        <%
          thumb = scene.image || scene.from
          current = scene == @scene
          thumb_url = thumb && Storyboard.preview_url(thumb)
          from_url = scene.from && Storyboard.preview_url(scene.from)
          to_url = scene.to && Storyboard.preview_url(scene.to)
        %>
        <li class="shrink-0">
          <%= link_to storyboard_path(@storyboard, scene: scene.slug, video: @video_index),
                class: "relative block w-32 overflow-hidden rounded-lg border-2 border-transparent bg-ink-900 hover:border-ink-900/30 aria-[current=page]:border-rocket",
                style: "aspect-ratio: #{@storyboard.size.join(" / ")}",
                aria: { current: ("page" if current), label: "#{i + 1}. #{scene.label}" },
                title: scene.label do %>
            <% if scene.transition? %>
              <span class="absolute inset-0 bg-cover bg-center" style="background-image: url(<%= from_url %>)"></span>
              <span class="absolute inset-0 bg-cover bg-center opacity-50" style="background-image: url(<%= to_url %>)"></span>
              <span class="absolute inset-x-0 bottom-0 bg-black/60 px-1 py-0.5 text-center text-[10px] font-medium text-white">↔</span>
            <% elsif thumb_url %>
              <span class="absolute inset-0 bg-cover bg-center" style="background-image: url(<%= thumb_url %>)"></span>
            <% end %>
            <% if scene.overlay? || scene.cta? %>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent px-1 pb-1 pt-4 text-center text-[9px] leading-tight font-medium text-white">
                <%= scene.overlay? ? "Rule" : "CTA" %>
              </span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>
</div>

<% content_for(:aside) do %>
  <div class="space-y-4">
    <div class="rb-surface-raised space-y-3 p-4">
      <div>
        <h1 class="text-lg font-semibold text-ink-900"><%= @scene.label %></h1>
        <p class="mt-1 text-sm text-ink-500">
          <%= @scene.kind.to_s.humanize %>
          · video <%= @video_index + 1 %>/<%= @settings.videos.size %>
        </p>
      </div>
      <% if @scene.text.present? %>
        <p class="whitespace-pre-line text-sm text-ink-900"><%= @scene.text %></p>
      <% end %>
      <% if @scene.href.present? %>
        <p class="text-sm">
          <%= link_to @scene.href, @scene.href, class: "underline underline-offset-2 hover:text-rocket", target: "_blank", rel: "noopener" %>
        </p>
      <% end %>
      <p class="text-xs text-ink-500"><%= @storyboard.size.join(" × ") %> px · guide <code class="font-mono"><%= @storyboard.guide_slug %></code></p>
      <% if @scene.renderable? %>
        <%= link_to storyboard_path(@storyboard, scene: @scene.slug, video: @video_index, format: :png),
              class: "rb-btn-primary inline-flex gap-1.5 px-3.5 py-2 text-sm" do %>
          <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Download PNG
        <% end %>
      <% else %>
        <p class="text-sm text-ink-500">Transitions use <%= StoryboardSetting::TRANSITIONS[@settings.transition_type] %> in the rendered MP4.</p>
      <% end %>
    </div>

    <%= render "accounts/storyboards/settings", settings: @settings, storyboard: @storyboard, video_index: @video_index, renders: @renders %>
  </div>
<% end %>
