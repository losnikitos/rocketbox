<% content_for(:title, "Storyboard — Rocketbox") %>

<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @storyboards.each do |board| %>
    <% first = board.scenes.first %>
    <li class="overflow-hidden rounded-2xl border border-ink-900/10 bg-ink-900"
        style="aspect-ratio: <%= board.size.join(" / ") %>">
      <div class="relative size-full">
        <iframe src="<%= canvas_storyboard_path(board, scene: first.slug) %>" title="<%= board.name %>"
                loading="lazy" tabindex="-1" class="pointer-events-none absolute inset-0 size-full"></iframe>
        <%= link_to storyboard_path(board), class: "absolute inset-0 flex flex-col items-start" do %>
          <span class="w-full bg-linear-to-b from-black/60 to-transparent p-4 pb-10 text-sm font-semibold text-white">
            <%= board.name %>
          </span>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
