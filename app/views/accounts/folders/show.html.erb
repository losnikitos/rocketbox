<% content_for(:title, "#{@folder&.path || "Folders"} — Rocketbox") %>
<% admin = Current.user&.admin? %>
<% menu_css = "inset-auto m-0 top-[calc(anchor(bottom)+4px)] [position-try-fallbacks:flip-block,flip-inline] rounded-lg border border-ink-900/15 bg-white p-1 shadow-lg" %>
<% tile_css = "relative min-w-0 rounded-xl p-2 hover:bg-ink-900/5" %>
<% link_css = "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" %>
<% name_css = "mt-2 flex items-center justify-center gap-1 text-sm font-medium text-ink-900" %>

<% content_for(:header_actions) do %>
  <% if @folder %>
    <label for="library-upload-input" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "arrow-up-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Upload
    </label>
  <% end %>
  <% if admin && @folder&.root? %>
    <button type="button" popovertarget="new-folder" style="anchor-name: --new-folder" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "folder-plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      New folder
    </button>
    <%= form_with url: library_folders_path(@folder.slug), id: "new-folder", html: { popover: "", style: "position-anchor: --new-folder" },
          class: "#{menu_css} right-[calc(anchor(right))] p-2" do |f| %>
      <div class="flex gap-2">
        <%= f.text_field "folder[name]", required: true, placeholder: "Exterior", "aria-label": "Folder name", class: tw_input_classes %>
        <%= f.button "Create", class: "rb-btn-primary px-3.5 py-2 text-sm" %>
      </div>
    <% end %>
  <% end %>
  <% if admin && @folder && !@folder.root? %>
    <button type="button" popovertarget="rename-folder" style="anchor-name: --rename-folder" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "pencil", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Rename
    </button>
    <%= form_with url: library_folders_path(@folder.root.slug, @folder.slug), method: :patch, id: "rename-folder", html: { popover: "", style: "position-anchor: --rename-folder" },
          class: "#{menu_css} right-[calc(anchor(right))] p-2" do |f| %>
      <div class="flex gap-2">
        <%= f.text_field "folder[name]", value: @folder.name, required: true, "aria-label": "Folder name", class: tw_input_classes %>
        <%= f.button "Save", class: "rb-btn-primary px-3.5 py-2 text-sm" %>
      </div>
    <% end %>
    <%= button_to library_folders_path(@folder.root.slug, @folder.slug), method: :delete,
          form: { data: { turbo_confirm: "Delete #{@folder.name}? Its media moves to #{@folder.parent.name}." } },
          class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" do %>
      <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Delete
    <% end %>
  <% end %>
  <%= render "shared/admin_links/folders" %>
<% end %>

<nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1 text-sm font-medium">
  <% crumbs = [ [ "All files", library_folders_path ], *[ @folder&.parent, @folder ].compact.map { [ it.name, folder_path(it) ] } ] %>
  <% crumbs.each_with_index do |(label, path), index| %>
    <% if index.positive? %><%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %><% end %>
    <% if index == crumbs.size - 1 %>
      <span class="text-ink-900" aria-current="page"><%= label %></span>
    <% else %>
      <%= link_to label, path, class: "text-ink-500 hover:text-ink-900" %>
    <% end %>
  <% end %>
</nav>

<% if @folder %>
  <%= form_with url: library_media_index_path, multipart: true, class: "hidden", data: { controller: "drop-upload" } do %>
    <%= hidden_field_tag :folder_id, @folder.id %>
    <%= hidden_field_tag :source_id, nil, data: { drop_upload_target: "source" } %>
    <%= file_field_tag "files[]", multiple: true, accept: "image/*,video/*,.heic,.heif", id: "library-upload-input",
          data: { drop_upload_target: "input", action: "change->drop-upload#changed" } %>
  <% end %>
<% end %>

<% folders = @folder ? @folder.children.to_a : Folder.roots.sort_by { Folder::ROOTS.index(it.slug) || Folder::ROOTS.size } %>
<% media_groups = @library_media.to_a.group_by(&:original) %>
<% move_targets = Folder.grouped_options if admin && media_groups.any? %>
<div class="flex flex-col gap-6 lg:flex-row">
  <div class="min-w-0 flex-1">
    <% if folders.any? || media_groups.any? %>
      <ul aria-label="Folders and files" class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8">
        <% folders.each do |folder| %>
          <% previews = @folder_media[folder.id].to_a.first(12) %>
          <li class="<%= tile_css %>">
            <%= link_to folder_path(folder), class: link_css do %>
              <% if previews.any? %>
                <span class="group/thumb relative block aspect-square w-full overflow-hidden rounded-lg bg-ink-900/5"
                      data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
                  <% previews.each_with_index do |preview, index| %>
                    <span class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
                      <%= render "accounts/library/file", media: preview, css: "size-full object-cover" %>
                    </span>
                  <% end %>
                  <span class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-0.5 bg-white group-hover/thumb:hidden">
                    <% 4.times do |index| %>
                      <span class="relative min-h-0 overflow-hidden bg-ink-900/5">
                        <%= render "accounts/library/file", media: previews[index], css: "absolute inset-0 size-full object-cover" if previews[index] %>
                      </span>
                    <% end %>
                  </span>
                </span>
              <% else %>
                <span class="flex aspect-square w-full items-center justify-center">
                  <%= heroicon "folder", variant: :solid, options: { class: "size-20 text-sky-400", "aria-hidden": true } %>
                </span>
              <% end %>
              <span class="<%= name_css %>">
                <%= heroicon "folder", variant: :micro, options: { class: "size-4 shrink-0 text-sky-400", "aria-hidden": true } %>
                <span class="truncate"><%= folder.name %></span>
              </span>
            <% end %>
            <div class="absolute top-3 right-3"><%= render "shared/admin_links/folder", folder: %></div>
          </li>
        <% end %>

        <%# A source with versions spans a full row, its tiles on the same columns; dropping onto it attaches a version. %>
        <% media_groups.each do |source, group| %>
          <% grouped = group.size > 1 %>
          <% if grouped %>
            <li aria-label="Versions of one source" data-source-id="<%= source.id %>"
                class="col-span-full grid grid-cols-subgrid rounded-xl bg-white outline-2 outline-ink-900/10 data-drop-over:outline-rocket">
              <%= link_to library_item_path(source), class: "col-span-full flex items-center gap-2 px-2 pt-2 text-xs font-medium text-ink-600 hover:text-ink-900" do %>
                <%= render "accounts/library/file", media: source, css: "size-6 rounded object-cover" %>
                Source
              <% end %>
              <ul class="col-span-full grid grid-cols-subgrid gap-y-3">
          <% end %>
          <% group.each do |media| %>
            <% name = media.file.attached? ? media.file.filename.to_s : media.kind %>
            <%= tag.li class: [ tile_css, ("data-drop-over:outline-2 data-drop-over:outline-rocket" unless grouped) ], data: { source_id: (source.id unless grouped) } do %>
              <%= link_to library_item_path(media), id: "folder-media-#{media.id}", class: link_css do %>
                <%= render "accounts/library/file", media:, css: "aspect-square w-full rounded-lg object-cover" %>
                <span class="<%= name_css %>"><span class="truncate"><%= name %></span></span>
              <% end %>
              <div class="absolute top-3 right-3"><%= render "shared/admin_links/library_media", library_media: media, links: { move: true }, move_targets: %></div>
            <% end %>
          <% end %>
          <% if grouped %>
              </ul>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% elsif @folder %>
      <p class="text-sm text-ink-600">This folder is empty. Drop photos or videos anywhere here to upload.</p>
    <% end %>
  </div>

  <% if @folder %>
    <aside aria-labelledby="folder-recipes-heading" class="shrink-0 lg:w-72">
      <h2 id="folder-recipes-heading" class="mb-2 px-2 text-sm font-bold text-ink-900">Recipes</h2>
      <% if @recipes.any? %>
        <ul class="flex flex-col gap-0.5">
          <% @recipes.each do |recipe| %>
            <li><%= render "accounts/recipes/row", recipe:, path: new_recipe_run_path(recipe) %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-2 text-sm text-ink-600">No recipes use this folder.</p>
      <% end %>
    </aside>
  <% end %>
</div>
