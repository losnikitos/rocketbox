<% content_for(:title, "#{@folder&.path || "Media"} — Rocketbox") %>
<% admin = Current.user&.admin? %>
<% menu_css = "inset-auto m-0 top-[calc(anchor(bottom)+4px)] [position-try-fallbacks:flip-block,flip-inline] rounded-lg border border-ink-900/15 bg-white p-1 shadow-lg" %>
<% tile_css = "group relative min-w-0 rounded-xl p-2 hover:bg-ink-900/5" %>
<% tile_menu_css = "absolute top-3 right-3 opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100 has-[:popover-open]:opacity-100" %>
<% link_css = "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" %>
<% name_css = "mt-2 flex items-center justify-center gap-1 text-sm font-medium text-ink-900" %>

<% content_for(:header_actions) do %>
  <% if @folder %>
    <label for="library-upload-input" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "arrow-up-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Upload
    </label>
  <% end %>
  <% if admin && !@folder&.parent_id %>
    <button type="button" popovertarget="new-folder" style="anchor-name: --new-folder" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "folder-plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      New folder
    </button>
    <%= form_with url: (@folder ? folder_path(@folder) : library_folders_path), id: "new-folder", html: { popover: "", style: "position-anchor: --new-folder" },
          class: "#{menu_css} right-[calc(anchor(right))] p-2" do |f| %>
      <div class="flex gap-2">
        <%= f.text_field "folder[name]", required: true, placeholder: "Exterior", "aria-label": "Folder name", class: tw_input_classes %>
        <%= f.button "Create", class: "rb-btn-primary px-3.5 py-2 text-sm" %>
      </div>
    <% end %>
  <% end %>
  <% if @folder %>
    <%= render "shared/admin_links/folder", folder: @folder, trigger_class: "cursor-pointer rounded-full p-2 text-ink-500 transition hover:bg-ink-900/5 hover:text-ink-900" %>
  <% else %>
    <%= render "shared/admin_links/folders" %>
  <% end %>
<% end %>

<% if @folder %>
  <%= form_with url: library_media_index_path, multipart: true, class: "hidden", data: { controller: "drop-upload", action: "dragstart@document->drop-upload#internalStart dragend@document->drop-upload#internalEnd" } do %>
    <%= hidden_field_tag :folder_id, @folder.id %>
    <%= hidden_field_tag :source_id, nil, data: { drop_upload_target: "source" } %>
    <%= file_field_tag "files[]", multiple: true, accept: "image/*,video/*,.heic,.heif", id: "library-upload-input",
          data: { drop_upload_target: "input", action: "change->drop-upload#changed" } %>
  <% end %>
<% end %>

<% folders = @folder ? @folder.children.to_a : Folder.roots.ordered.to_a %>
<% media_groups = @library_media.to_a.group_by(&:original) %>
<% move_targets = Folder.grouped_options if admin && media_groups.any? %>
<%# Bleeds into main's lg:p-8 so the recipes divider spans the full panel height. %>
<div class="flex flex-col lg:-m-8 lg:min-h-[calc(100%+4rem)] lg:flex-row">
  <% if move_targets %>
    <%= form_with url: "", method: :patch, class: "hidden", data: { drag_move_target: "form" } do %>
      <%= hidden_field_tag "library_media[folder_id]", nil, id: nil, data: { drag_move_target: "value" } %>
    <% end %>
  <% end %>
  <div class="@container min-w-0 flex-1 lg:p-8">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1 text-sm font-medium">
      <% crumbs = [ [ "All files", library_folders_path ], *[ @folder&.parent, @folder ].compact.map { [ it.name, folder_path(it) ] } ] %>
      <% crumbs.each_with_index do |(label, path), index| %>
        <% if index.positive? %><%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %><% end %>
        <% if index == crumbs.size - 1 %>
          <span class="text-ink-900" aria-current="page"><%= label %></span>
        <% else %>
          <%= link_to label, path, class: "text-ink-500 hover:text-ink-900" %>
        <% end %>
      <% end %>
    </nav>

    <% if folders.any? || media_groups.any? %>
      <ul aria-label="Folders and files" class="grid grid-cols-2 gap-3 @lg:grid-cols-3 @2xl:grid-cols-4 @4xl:grid-cols-5 @6xl:grid-cols-6">
        <% folders.each do |folder| %>
          <% previews = @folder_media[folder.id].to_a.first(12) %>
          <li class="<%= tile_css %>">
            <%= link_to folder_path(folder), class: link_css do %>
              <% if previews.any? %>
                <span class="group/thumb relative block aspect-2/3 w-full overflow-hidden rounded-lg bg-ink-900/5"
                      data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
                  <% previews.each_with_index do |preview, index| %>
                    <span class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
                      <%= render "accounts/library/file", media: preview, css: "size-full object-cover" %>
                    </span>
                  <% end %>
                  <span class="absolute inset-0 grid grid-cols-2 grid-rows-2 gap-0.5 bg-white group-hover/thumb:hidden">
                    <% 4.times do |index| %>
                      <span class="relative min-h-0 overflow-hidden bg-ink-900/5">
                        <%= render "accounts/library/file", media: previews[index], css: "absolute inset-0 size-full object-cover" if previews[index] %>
                      </span>
                    <% end %>
                  </span>
                </span>
              <% else %>
                <span class="flex aspect-2/3 w-full items-center justify-center">
                  <%= heroicon "folder", variant: :solid, options: { class: "size-20 #{folder_color(folder)}", "aria-hidden": true } %>
                </span>
              <% end %>
              <span class="<%= name_css %>">
                <%= heroicon "folder", variant: :micro, options: { class: "size-4 shrink-0 #{folder_color(folder)}", "aria-hidden": true } %>
                <span class="truncate"><%= folder.name %></span>
              </span>
            <% end %>
            <div class="<%= tile_menu_css %>"><%= render "shared/admin_links/folder", folder: %></div>
          </li>
        <% end %>

        <%# A source with versions spans a full row, its tiles on the same columns; dropping onto it attaches a version. %>
        <% media_groups.each do |source, group| %>
          <% grouped = group != [ source ] %>
          <% if grouped %>
            <li aria-label="Versions of one source" data-source-id="<%= source.id %>"
                class="col-span-full grid grid-cols-subgrid rounded-xl data-drop-over:outline-2 data-drop-over:outline-rocket">
              <%= link_to library_item_path(source), title: "Source", "aria-label": "Source", class: "relative self-start rounded-xl p-2 hover:bg-ink-900/5" do %>
                <%= render "accounts/library/file", media: source, css: "aspect-2/3 w-full rounded-lg object-cover opacity-50" %>
                <%= heroicon "arrow-right", variant: :mini, options: { class: "absolute top-1/2 -right-4 size-5 -translate-y-1/2 text-ink-400", "aria-hidden": true } %>
              <% end %>
              <ul class="col-start-2 -col-end-1 grid grid-cols-subgrid gap-y-3">
          <% end %>
          <% (grouped ? group - [ source ] : group).each do |media| %>
            <% name = media.file.attached? ? media.file.filename.to_s : media.kind %>
            <%= tag.li class: [ tile_css, ("data-drop-over:outline-2 data-drop-over:outline-rocket" unless grouped) ], data: { source_id: (source.id unless grouped) } do %>
              <%= link_to library_item_path(media), id: "folder-media-#{media.id}", class: link_css,
                    draggable: ("true" if move_targets), data: { move_url: (library_media_path(media) if move_targets) } do %>
                <% generated = media.generated_media.select { it.file.attached? }.sort_by(&:created_at).reverse %>
                <span class="relative block">
                  <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full rounded-lg object-cover", play: true %>
                  <% if media.tags.any? %>
                    <span class="absolute top-1.5 left-1.5 right-10 flex flex-wrap gap-1"><%= render partial: "accounts/tags/tag", collection: media.tags.sort_by(&:name), as: :tag %></span>
                  <% end %>
                  <% if generated.any? %>
                    <span class="absolute inset-x-1.5 bottom-1.5 flex gap-1 overflow-x-auto [scrollbar-width:none]" aria-hidden="true">
                      <% generated.first(5).each do |version| %>
                        <span class="w-10.5 shrink-0 overflow-hidden rounded-md border-2 border-white shadow">
                          <%= render "accounts/library/file", media: version, css: "aspect-2/3 w-full object-cover" %>
                        </span>
                      <% end %>
                    </span>
                  <% end %>
                </span>
                <span class="<%= name_css %>"><span class="truncate"><%= name %></span></span>
              <% end %>
              <div class="<%= tile_menu_css %>"><%= render "shared/admin_links/library_media", library_media: media, links: { move: true }, move_targets: %></div>
            <% end %>
          <% end %>
          <% if grouped %>
              </ul>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% elsif @folder %>
      <p class="text-sm text-ink-600">This folder is empty. Drop photos or videos anywhere here to upload.</p>
    <% end %>
  </div>

  <% if @folder %>
    <aside aria-label="Recipes" class="shrink-0 border-ink-900/10 max-lg:mt-6 max-lg:border-t max-lg:pt-6 lg:w-80 lg:border-l lg:px-6 lg:py-8">
      <% [ [ "read", "Read", "arrow-long-right", "text-signal-green", "bg-signal-green/10", @read_recipes, "No recipes read from this folder." ],
           [ "write", "Write", "arrow-long-left", "text-sky-500", "bg-sky-500/10", @write_recipes, "No recipes write to this folder." ] ].each do |key, title, arrow, color, bg, recipes, empty| %>
        <section aria-labelledby="folder-recipes-<%= key %>" class="border-ink-900/10 not-first:mt-5 not-first:border-t not-first:pt-5">
          <h3 id="folder-recipes-<%= key %>" class="<%= bg %> relative mb-1 rounded-lg px-2 py-1.5 text-sm font-semibold text-ink-900">
            <%= heroicon arrow, options: { class: "absolute top-1/2 right-full size-10 -translate-y-1/2 #{color} max-lg:hidden", "aria-hidden": true } %>
            <%= title %>
          </h3>
          <% if recipes.any? %>
            <ul class="flex flex-col gap-0.5">
              <% recipes.each do |recipe| %>
                <li><%= render "accounts/recipes/row", recipe:, path: recipe_path(recipe), arrow: key == "write" ? "arrow-left" : "arrow-right" %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="px-2 text-sm text-ink-600"><%= empty %></p>
          <% end %>
        </section>
      <% end %>
    </aside>
  <% end %>
</div>
