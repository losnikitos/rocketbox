<% content_for(:title, "#{@collection&.humanize || "Folders"} — Rocketbox") %>

<nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-1 text-sm font-medium">
  <%= link_to "All files", library_folders_path, class: @collection ? "text-ink-500 hover:text-ink-900" : "text-ink-900", aria: { current: ("page" unless @collection) } %>
  <% if @collection %>
    <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %>
    <span class="text-ink-900" aria-current="page"><%= @collection.humanize %></span>
  <% end %>
</nav>

<% if @collection.nil? %>
  <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8">
    <% LibraryMedia.collections.each_key do |collection| %>
      <li>
        <%= link_to library_folders_path(collection), class: "flex flex-col items-center rounded-xl p-4 text-center hover:bg-ink-900/5 focus-visible:outline-2 focus-visible:outline-rocket" do %>
          <%= heroicon "folder", variant: :solid, options: { class: "size-20 text-sky-400", "aria-hidden": true } %>
          <span class="mt-1 text-sm font-medium text-ink-900"><%= collection.humanize %></span>
          <span class="text-xs text-ink-500"><%= pluralize(@counts[collection].to_i, "item") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif @library_media.any? %>
  <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-8">
    <% @library_media.each do |media| %>
      <% name = media.file.attached? ? media.file.filename.to_s : media.kind %>
      <li class="min-w-0 rounded-xl p-2 hover:bg-ink-900/5">
        <% if media.story_image? %>
          <button type="button" popovertarget="folder-media-<%= media.id %>" aria-label="View <%= name %>" class="block w-full cursor-zoom-in">
            <%= render "accounts/library/file", media:, css: "aspect-square w-full rounded-lg object-cover" %>
          </button>
          <div id="folder-media-<%= media.id %>" popover class="size-full bg-black/90 p-4">
            <button type="button" popovertarget="folder-media-<%= media.id %>" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
              <%= image_tag url_for(media.file), alt: name, class: "max-h-full max-w-full" %>
            </button>
          </div>
        <% else %>
          <%= render "accounts/library/file", media:, css: "aspect-square w-full rounded-lg object-cover", controls: true %>
        <% end %>
        <p class="mt-2 truncate text-sm font-medium text-ink-900" title="<%= name %>"><%= name %></p>
        <p class="text-xs text-ink-500"><%= l(media.created_at, format: :short) %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-ink-600">This folder is empty.</p>
<% end %>
