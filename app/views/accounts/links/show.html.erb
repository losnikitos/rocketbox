<% content_for(:title, "#{@link.title} — Links — Rocketbox") %>
<% account = Current.account %>

<div class="space-y-6">
  <div class="min-w-0 space-y-1">
    <%= link_to links_path, class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
      <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Links
    <% end %>
    <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-900">
      <span class="truncate"><%= @link.title %></span>
      <%= render "accounts/crawls/status", crawl: @crawl if @crawl %>
    </h2>
    <p class="truncate text-xs text-ink-500">
      <%= Link::SOURCES[@link.source] %> · <%= time_ago_in_words(@link.created_at) %> ago ·
      <%= link_to @link.url, @link.url, target: "_blank", rel: "noopener", class: "hover:text-ink-900 hover:underline" %>
    </p>
  </div>

  <% unless @crawl&.pending? %>
    <section aria-labelledby="crawl-heading" class="max-w-3xl">
      <h3 id="crawl-heading" class="text-sm font-medium text-ink-900">Crawl</h3>
      <p class="mt-1 text-sm text-ink-500">Pull the business details, photos, and videos from this page. Takes up to a couple of minutes.</p>

      <%= form_with model: @new_crawl, url: link_crawls_path(@link), class: "mt-4 space-y-4" do |f| %>
        <fieldset>
          <legend class="<%= tw_label_classes %>">Crawler</legend>
          <div class="<%= tw_segments_classes %> max-w-md">
            <% Crawl::PROVIDERS.each do |key, label| %>
              <label class="<%= tw_segment_classes %> px-3 py-1.5 text-center text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :provider, key, class: "sr-only" %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <details class="group">
          <summary class="inline-flex cursor-pointer items-center gap-1 text-sm text-ink-600 hover:text-ink-900">
            <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
            Data instruction
          </summary>
          <%= f.text_area :data_instruction, rows: 12, required: true, "aria-label": "Data instruction", class: "#{tw_input_classes} mt-2 font-mono text-xs" %>
          <p class="mt-1 text-xs text-ink-500">Applies to this crawl only.</p>
        </details>

        <%= f.button type: :submit, class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon (@crawl ? "arrow-path" : "globe-alt"), variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          <%= @crawl ? "Crawl again" : "Crawl" %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% case @crawl&.status %>
  <% when "pending" %>
    <% content_for :head do %>
      <meta http-equiv="refresh" content="5">
    <% end %>
    <p class="flex items-center gap-2 text-sm text-ink-600" role="status">
      <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4 animate-spin", "aria-hidden": true } %>
      Crawling the page. This can take a couple of minutes…
    </p>

  <% when "failed" %>
    <p class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">Crawl failed: <%= @crawl.error %></p>

  <% when "done" %>
    <% business, media = @suggestions.partition { |suggestion| !suggestion.media? } %>
    <% pending_media = media.count(&:pending?) %>
    <% up_to_date = @suggestions.none?(&:pending?) %>

    <div class="flex flex-col gap-6 lg:flex-row">
      <section class="min-w-0 flex-1 rounded-lg border border-ink-900/10 bg-white p-4" aria-labelledby="business-heading">
        <div class="flex items-center justify-between gap-2">
          <h3 id="business-heading" class="text-sm font-medium text-ink-900">Business</h3>
          <%= button_to apply_link_crawl_path(@link, @crawl), method: :patch, disabled: up_to_date,
                class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" do %>
            <%= heroicon "check", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
            <%= up_to_date ? "Everything applied" : "Apply everything" %>
          <% end %>
        </div>

        <% if business.empty? %>
          <p class="mt-3 text-sm text-ink-500">No new business details on this page.</p>
        <% else %>
          <dl class="mt-3 divide-y divide-ink-900/5 font-mono text-xs">
            <% business.each do |suggestion| %>
              <div class="py-2">
                <dt class="mb-1 flex items-center justify-between gap-2 font-sans text-ink-500">
                  <%= suggestion.key.humanize %>
                  <span class="flex items-center gap-3">
                    <% if suggestion.pending? %>
                      <%= button_to "Cancel", reject_link_suggestion_path(@link, suggestion), method: :patch,
                            class: "text-xs text-ink-500 hover:text-ink-900 hover:underline" %>
                    <% end %>
                    <% unless suggestion.applied? %>
                      <%= button_to "Apply", apply_link_suggestion_path(@link, suggestion), method: :patch,
                            class: "text-xs font-medium text-rocket hover:underline" %>
                    <% end %>
                  </span>
                </dt>
                <% if suggestion.key != "logo" %>
                  <%= render "shared/field_diff", current: account[Crawl::FIELDS[suggestion.key]], value: suggestion.value, source: "From page", status: suggestion.status %>
                <% elsif suggestion.pending? %>
                  <dd class="flex items-center gap-3">
                    <% if account.logo.attached? %>
                      <%= image_tag url_for(account.logo), alt: "Current logo", class: "size-16 rounded-lg object-contain opacity-60 ring-2 ring-red-200" %>
                    <% else %>
                      <span class="flex size-16 items-center justify-center rounded-lg bg-red-50 font-sans text-xs italic text-red-800/60 ring-2 ring-red-200">Not set</span>
                    <% end %>
                    <%= heroicon "arrow-right", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %>
                    <img src="<%= suggestion.value %>" alt="Logo from page" referrerpolicy="no-referrer" class="size-16 rounded-lg bg-white object-contain ring-2 ring-green-300">
                  </dd>
                <% else %>
                  <dd class="flex items-start gap-1.5 text-ink-500">
                    <%= heroicon (suggestion.applied? ? "check" : "x-mark"), variant: :micro, options: { class: "mt-px size-3.5 shrink-0", "aria-hidden": true } %>
                    <img src="<%= suggestion.value %>" alt="Logo from page (<%= suggestion.status %>)" referrerpolicy="no-referrer"
                         class="size-16 rounded-lg bg-white object-contain ring-1 ring-ink-900/10 <%= "opacity-50" if suggestion.rejected? %>">
                  </dd>
                <% end %>
              </div>
            <% end %>
          </dl>
        <% end %>
      </section>

      <% if @crawl.screenshot_url %>
        <aside class="w-full shrink-0 lg:w-80">
          <h3 class="text-sm font-medium text-ink-900">Screenshot</h3>
          <%= link_to @crawl.screenshot_url, target: "_blank", rel: "noopener", class: "mt-3 block" do %>
            <img src="<%= @crawl.screenshot_url %>" alt="Screenshot of the crawled page" loading="lazy" class="w-full rounded-lg ring-1 ring-ink-900/10">
          <% end %>
        </aside>
      <% end %>
    </div>

    <section aria-labelledby="media-heading">
      <div class="flex items-center justify-between gap-2">
        <h3 id="media-heading" class="text-sm font-medium text-ink-900">
          Photos &amp; videos
          <span class="font-normal text-ink-500"><%= media.size %></span>
        </h3>
        <% if pending_media.positive? %>
          <%= button_to apply_link_crawl_path(@link, @crawl), method: :patch, params: { media: 1 },
                class: "rb-btn-ghost-on-light gap-1 px-2.5 py-1 text-xs" do %>
            <%= heroicon "plus", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
            Add all to library (<%= pending_media %>)
          <% end %>
        <% end %>
      </div>
      <% if media.empty? %>
        <p class="mt-1 text-sm text-ink-500">No new photos or videos on this page.</p>
      <% else %>
        <ul class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          <% media.each do |suggestion| %>
            <li id="suggestion-<%= suggestion.id %>" class="flex flex-col gap-2">
              <div class="aspect-square overflow-hidden rounded-lg bg-ink-900/5 <%= "opacity-50" if suggestion.rejected? %>">
                <% if suggestion.key == "video" %>
                  <video src="<%= suggestion.value %>" muted controls preload="metadata" class="size-full object-cover"></video>
                <% else %>
                  <img src="<%= suggestion.value %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="size-full object-cover">
                <% end %>
              </div>
              <% if suggestion.applied? %>
                <% if (media_id = @imported[suggestion.value]) %>
                  <%= link_to library_item_path(media_id), class: "inline-flex items-center gap-1 self-start text-xs text-ink-500 hover:text-ink-900" do %>
                    <%= heroicon "check", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                    In library
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center gap-1 self-start text-xs text-ink-500">
                    <%= heroicon "check", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                    Added
                  </span>
                <% end %>
              <% else %>
                <div class="flex items-center gap-3">
                  <%= button_to apply_link_suggestion_path(@link, suggestion), method: :patch,
                        class: "rb-btn-ghost-on-light gap-1 px-2.5 py-1 text-xs" do %>
                    <%= heroicon "plus", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                    Add to library
                  <% end %>
                  <% if suggestion.pending? %>
                    <%= button_to "Skip", reject_link_suggestion_path(@link, suggestion), method: :patch,
                          class: "text-xs text-ink-500 hover:text-ink-900 hover:underline" %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>
