<% content_for(:title, "Library — Rocketbox") %>

<section class="w-full">
  <h1 class="font-manrope text-xl font-bold text-ink-900">Library</h1>
  <p class="mt-2 text-sm text-ink-600">Media you’ve sent to the Telegram bot.</p>

  <% if @library_media.present? %>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      <% @library_media.each do |media| %>
        <li class="relative min-w-0">
          <% if media.file.attached? %>
            <% content_type = media.file.content_type.to_s %>
            <% if content_type.start_with?("image/") || media.kind == "photo" || media.kind == "sticker" %>
              <%= image_tag url_for(media.file), alt: media.kind, class: "aspect-square w-full object-cover" %>
            <% elsif content_type.start_with?("video/") || %w[video video_note animation].include?(media.kind) %>
              <%= video_tag url_for(media.file), controls: true, class: "aspect-square w-full object-cover bg-ink-900/5" %>
            <% else %>
              <div class="flex aspect-square flex-col items-center justify-center gap-2 bg-ink-900/5 px-3 text-center">
                <%= link_to media.file.filename, url_for(media.file), class: "text-sm font-medium text-ink-900 underline underline-offset-2 break-all" %>
              </div>
            <% end %>
          <% else %>
            <div class="flex aspect-square items-center justify-center bg-ink-900/5 text-sm text-ink-500">Missing file</div>
          <% end %>
          <div class="absolute right-1 top-1">
            <%= render "shared/admin_links/library_media", library_media: media %>
          </div>
          <p class="mt-2 text-xs text-ink-500">
            <%= media.kind %> · <%= l(media.created_at, format: :short) %>
          </p>
          <% if media.story_image? %>
            <%= button_to "Improve with AI",
                  library_improve_path(media),
                  method: :post,
                  class: "rb-btn-ghost-on-light mt-2 w-full px-2 py-1.5 text-xs" %>
          <% end %>
          <% if media.story_publishable? %>
            <%= button_to "Publish as Instagram story",
                  library_instagram_story_path(media),
                  method: :post,
                  class: "rb-btn-ghost-on-light mt-2 w-full px-2 py-1.5 text-xs" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif Current.user.telegram_user_id.blank? %>
    <p class="mt-6 text-sm text-ink-600">
      Set your <%= link_to "Telegram user id", profile_integrations_path, class: "font-medium text-ink-900 underline underline-offset-2" %>
      under Integrations so inbound media can be attached here.
    </p>
  <% else %>
    <p class="mt-6 text-sm text-ink-600">No media yet. Send a photo or video to the bot and it will show up here.</p>
  <% end %>
</section>
