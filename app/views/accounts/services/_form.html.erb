<%# locals: (service:) %>
<%= form_with model: service, class: "mx-auto max-w-md space-y-4" do |f| %>
  <% if service.errors.any? %>
    <p class="<%= tw_alert_error_classes %>" role="alert"><%= service.errors.full_messages.to_sentence %></p>
  <% end %>

  <div>
    <%= f.label :name, class: tw_label_classes %>
    <%= f.text_field :name, required: true, autofocus: service.new_record?, placeholder: "Skin fade", class: tw_input_classes %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :price, class: tw_label_classes %>
      <%= f.text_field :price, placeholder: "£25", class: tw_input_classes %>
    </div>
    <div>
      <%= f.label :duration, class: tw_label_classes %>
      <%= f.text_field :duration, placeholder: "45 min", class: tw_input_classes %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: tw_label_classes %>
    <%= f.text_area :description, rows: 4, class: tw_input_classes %>
  </div>

  <div class="flex items-center justify-end gap-2">
    <%= link_to "Cancel", services_path, class: "rounded-lg px-3.5 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
    <%= f.button "Save", type: :submit, class: "rb-btn-primary px-3.5 py-2 text-sm" %>
  </div>
<% end %>
