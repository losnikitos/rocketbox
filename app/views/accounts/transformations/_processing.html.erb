<%# locals: (tf:, transformation:, scope:, refresh_url:) %>
<% type = transformation.type %>
<% field_label = "mb-1 block text-xs text-ink-500" %>
<% layer, original = type&.layer, type.try(:original) %>
<% if layer || original || type.try(:source_url) %>
<div class="space-y-3">
  <% if layer || original %>
    <div class="grid grid-cols-2 gap-3">
      <% if layer %>
        <div>
          <p class="<%= field_label %>">Layer</p>
          <div class="relative overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900 transition hover:border-ink-900/30"
               style="aspect-ratio: <%= layer.size.join(" / ") %>">
            <iframe src="<%= canvas_layer_path(layer) %>" title="<%= layer.name %>" loading="lazy" tabindex="-1" class="pointer-events-none absolute inset-0 size-full"></iframe>
            <%= link_to layer_path(layer), class: "absolute inset-0" do %><span class="sr-only"><%= layer.name %> layer</span><% end %>
          </div>
        </div>
      <% end %>
      <% if original %>
        <div>
          <p class="<%= field_label %>">Original</p>
          <%= tag.video controls: true, preload: "metadata", src: original_transformations_path(type.slug), "aria-label": "Original reel",
                class: "aspect-9/16 w-full rounded-lg bg-ink-900" %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if type.try(:source_url) %>
    <%= link_to type.source_url, target: "_blank", rel: "noopener", class: "inline-flex items-center gap-1.5 text-sm text-ink-600 underline hover:text-ink-900" do %>
      <%= image_tag "brands/instagram.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
      Instagram
    <% end %>
  <% end %>
</div>
<% end %>
<% if type&.reel? || transformation.kind.in?(%w[approval publish]) %>
  <div>
    <%= tf.label :body, transformation.kind == "approval" ? "Message" : "When it starts", class: field_label %>
    <%= tf.text_area :body, rows: 2, class: tw_input_classes, placeholder: "Optional WhatsApp message" %>
  </div>
  <% if transformation.kind == "publish" %>
    <div>
      <%= label_tag "transformation_options_done", "When it finishes", class: field_label %>
      <%= text_field_tag "transformation[options][done]", transformation.options["done"],
            id: "transformation_options_done", class: tw_input_classes %>
    </div>
  <% end %>
  <% if transformation.kind.in?(%w[approval publish]) %>
    <div>
      <%= label_tag "transformation_options_button", transformation.kind == "approval" ? "Button" : "Link button", class: field_label %>
      <%= text_field_tag "transformation[options][button]", transformation.options["button"],
            id: "transformation_options_button", class: tw_input_classes,
            placeholder: transformation.kind == "approval" ? "Approve" : "View on Instagram" %>
    </div>
  <% end %>
<% end %>
<% if transformation.ai? %>
  <div>
    <% writes = transformation.makes == :prompt %>
    <%= tf.label :body, writes ? "Instruction" : "Prompt", class: field_label %>
    <%= tf.text_area :body, rows: 6, class: tw_input_classes,
          placeholder: writes ? "Write one new shot that mixes the moods of these prompts…" : "Compose a collage from the interior, the barber and the client…" %>
  </div>
<% end %>
<% if (fields = type.try(:account_fields)).present? %>
  <div>
    <p class="<%= field_label %>">Writes to the account</p>
    <ul class="flex flex-col gap-1.5">
      <% fields.each_value do |column| %>
        <li class="rounded-lg border border-stone-100 bg-stone-50 px-2.5 py-1.5 text-sm text-ink-700">
          <%= column.to_s.humanize %>
        </li>
      <% end %>
    </ul>
    <p class="mt-1.5 text-xs text-ink-500">Blank values are skipped; existing account fields stay.</p>
  </div>
<% end %>
<% if transformation.ai? || type&.options %>
  <%= render "shared/generation_options", record: transformation, scope:, refresh_url: %>
<% end %>
