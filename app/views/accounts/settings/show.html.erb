<% content_for(:title, "Settings — Rocketbox") %>

<%= form_with model: Current.account, url: profile_settings_path, method: :patch,
      class: "max-w-sm",
      data: { controller: "autosave", action: "input->autosave#queue change->autosave#queue submit->autosave#submit" } do |form| %>
  <%= form.label :name, class: tw_label_classes %>
  <%= autosave_field do %>
    <%= form.text_field :name, class: tw_input_autosave_classes, autocomplete: "name" %>
  <% end %>
<% end %>

<%= form_with model: Current.account, url: profile_settings_path, method: :patch,
      class: "mt-6 max-w-sm",
      data: { controller: "autosave", action: "change->autosave#queue submit->autosave#submit" } do |form| %>
  <%= form.label :email, class: tw_label_classes %>
  <%= autosave_field do %>
    <%= form.email_field :email, class: tw_input_autosave_classes, autocomplete: "email", required: true %>
  <% end %>
  <p class="mt-1 text-xs text-ink-500">We’ll send a verification link to the new address.</p>
<% end %>

<%= form_with model: Current.account, url: profile_settings_path, method: :patch, class: "mt-6 max-w-sm" do |form| %>
  <%= form.label :password, Current.account.password_digest_in_database.present? ? "Change password" : "Set a password", class: tw_label_classes %>
  <%= form.password_field :password, class: tw_input_classes, autocomplete: "new-password", minlength: 8, maxlength: 72, required: true %>
  <% if (error = Current.account.errors.full_messages_for(:password).first) %>
    <p class="mt-1 text-xs text-signal-red"><%= error %></p>
  <% else %>
    <p class="mt-1 text-xs text-ink-500">Sign in with this instead of an email code.</p>
  <% end %>
  <%= form.submit "Save password", class: "#{tw_btn_secondary_classes} mt-3" %>
<% end %>

<section class="mt-10 max-w-lg rounded-2xl border border-signal-red/30 bg-white p-6">
  <h2 class="font-manrope text-base font-bold text-ink-900">Danger zone</h2>

  <div class="mt-4 flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-ink-900">Reset account</p>
      <p class="mt-0.5 text-xs text-ink-500">Disconnects Instagram and WhatsApp and removes this account's media, runs and messages. Business details and logo stay.</p>
    </div>
    <%= button_to "Reset account", reset_profile_settings_path, method: :post,
          form: { data: { turbo_confirm: "Reset #{Current.account.account_label}? Instagram, WhatsApp, media, runs and messages will be removed." } },
          class: "shrink-0 cursor-pointer rounded-lg border border-signal-red/40 px-2.5 py-1 text-xs font-semibold text-signal-red hover:bg-signal-red/5" %>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-ink-900">Delete account</p>
      <p class="mt-0.5 text-xs text-ink-500">Removes <%= Current.account.account_label %> and all of its data. This can't be undone.</p>
    </div>
    <%= button_to "Delete account", profile_settings_path, method: :delete,
          form: { data: { turbo_confirm: "Delete #{Current.account.account_label}? This can't be undone." } },
          class: "shrink-0 cursor-pointer rounded-lg border border-signal-red/40 px-2.5 py-1 text-xs font-semibold text-signal-red hover:bg-signal-red/5" %>
  </div>
</section>
