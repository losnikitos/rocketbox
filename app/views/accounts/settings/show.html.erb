<% content_for(:title, "Settings — Rocketbox") %>

<section class="w-full">
  <div class="flex flex-col gap-8 sm:flex-row sm:gap-10 lg:gap-12">
    <%= render "accounts/nav", current: :settings %>

    <div class="min-w-0 flex-1">
      <h1 class="font-manrope text-xl font-bold text-ink-900">Settings</h1>

      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-ink-500">Email</dt>
          <dd class="font-medium text-ink-900"><%= Current.user.email %></dd>
        </div>
      </dl>

      <div class="mt-8">
        <%= button_to "Log out", session_path(Current.session), method: :delete, form: { class: "inline-flex" }, class: "rb-btn-ghost-on-light" %>
      </div>
    </div>
  </div>
</section>
