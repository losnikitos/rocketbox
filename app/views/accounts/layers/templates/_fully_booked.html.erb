<%# locals: (values:) %>
<%# Sized in vw so the layout scales with the viewport: 1080px wide in Chrome, any width in the preview iframe. %>
<div class="relative h-screen w-screen font-manrope text-white drop-shadow-[0_0.3vw_1.5vw_rgb(0_0_0/0.5)]">
  <p class="absolute top-[6vw] left-[6vw] text-[5vw] font-semibold">
    <%= values[:date].strftime("%a, %b %-d") %>
  </p>
  <p class="absolute inset-0 flex items-center justify-center px-[6vw] text-center text-[15vw] leading-none font-extrabold tracking-tight uppercase">
    <%= values[:headline] %>
  </p>
</div>
