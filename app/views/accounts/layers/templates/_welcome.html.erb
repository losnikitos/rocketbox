<%# locals: (values:) %>
<%# Sized in vw so the layout scales with the viewport: 1080px wide in Chrome, any width in the preview iframe. %>
<%# Hidden lines keep their space, so shown lines stay put as more appear. %>
<% shown = values[:lines].to_i.clamp(1, 4) %>
<div class="relative h-screen w-screen font-manrope text-white drop-shadow-[0_0.3vw_1.5vw_rgb(0_0_0/0.5)]">
  <p class="absolute inset-0 flex flex-col items-center justify-center px-[6vw] text-center text-[13vw] leading-none font-extrabold tracking-tight uppercase">
    <% values.values_at(:line1, :line2, :line3, :line4).each_with_index do |line, i| %>
      <%= tag.span line, class: [ "block", ("invisible" if i >= shown) ] %>
    <% end %>
  </p>
</div>
