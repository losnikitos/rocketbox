<%# locals: (values:) %>
<%# Sized in vw so the layout scales with the viewport: 1080px wide in Chrome, any width in the preview iframe. %>
<div class="h-screen w-screen pt-[52vw] text-center text-white drop-shadow-[0_0.3vw_1.5vw_rgb(0_0_0/0.5)]">
  <p class="font-serif text-[11vw] leading-none italic"><%= values[:line1] %></p>
  <p class="font-manrope text-[13vw] leading-none font-extrabold tracking-tight"><%= values[:line2] %></p>
</div>
