<% content_for(:title, "#{@layer.name} — Layers — Rocketbox") %>

<div class="@container space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Layers", layers_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= @layer.name %></span>
  </nav>

  <div class="group grid items-start gap-8 @3xl:grid-cols-[minmax(0,24rem)_1fr]">
    <div class="w-full max-w-sm overflow-hidden rounded-xl border border-ink-900/10 bg-ink-900 transition-colors group-has-[[value=light]:checked]:bg-white"
         style="aspect-ratio: <%= @layer.size.join(" / ") %>">
      <iframe name="layer_preview" src="<%= canvas_layer_path(@layer, @values) %>" title="<%= @layer.name %> preview" class="size-full"></iframe>
    </div>

    <%= form_with url: canvas_layer_path(@layer), method: :get, data: { turbo: false },
          html: { target: "layer_preview", oninput: "this.requestSubmit()" },
          class: "max-w-md space-y-4 rounded-2xl border border-ink-900/10 bg-white p-6" do %>
      <%= hidden_field_tag :account, Current.account.id, id: nil %>
      <fieldset oninput="event.stopPropagation()">
        <legend class="<%= tw_label_classes %>">Preview background</legend>
        <div class="flex gap-2">
          <% { "Dark" => "bg-ink-900", "Light" => "bg-white" }.each do |name, swatch| %>
            <label title="<%= name %>" class="size-8 cursor-pointer rounded-full border border-ink-900/15 <%= swatch %> ring-rocket ring-offset-2 has-checked:ring-2 has-focus-visible:ring-2">
              <%= radio_button_tag :preview_background, name.downcase, name == "Dark", class: "sr-only", "aria-label": name %>
            </label>
          <% end %>
        </div>
      </fieldset>
      <% @layer.fields.each do |field| %>
        <div>
          <%= label_tag field.name, field.label, class: tw_label_classes %>
          <% if field.type == :date %>
            <%= date_field_tag field.name, @values[field.name], class: tw_input_classes %>
          <% elsif field.type == :color %>
            <%= color_field_tag field.name, @values[field.name], class: "block h-10 w-16 cursor-pointer rounded-lg border border-ink-900/15 bg-white p-1" %>
          <% else %>
            <%= text_field_tag field.name, @values[field.name], class: tw_input_classes %>
          <% end %>
        </div>
      <% end %>
      <p class="text-xs text-ink-500"><%= @layer.size.join(" × ") %> px, transparent background.</p>
      <%= button_tag type: "submit", formaction: layer_path(@layer, format: :png), formtarget: "_self",
            class: "rb-btn-primary gap-1.5 px-3.5 py-2 text-sm" do %>
        <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Download PNG
      <% end %>
    <% end %>
  </div>
</div>
