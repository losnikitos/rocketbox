<% media = @generation.source_media %>
<% recipe = @generation.recipe %>
<% content_for(:title, "#{recipe.name} — Generate — Rocketbox") %>

<div class="flex flex-col gap-6 md:flex-row">
  <% unless turbo_frame_request? %>
    <div class="flex min-w-0 flex-1 flex-col gap-4">
      <%= link_to library_item_path(media), class: "inline-flex items-center gap-1 self-start text-sm text-ink-600 hover:text-ink-900" do %>
        <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Source media
      <% end %>
      <div class="flex flex-1 items-center justify-center rounded-lg bg-white p-4">
        <%= render "accounts/library/file", media:, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
      </div>
    </div>
  <% end %>

  <turbo-frame id="side_panel" target="_top" class="contents">
  <aside class="w-full shrink-0 space-y-6 rounded-2xl border border-ink-900/10 bg-stone-50 p-6 md:w-96 lg:w-108">
    <section class="flex gap-4 rounded-2xl border border-ink-900/10 bg-white p-4" aria-labelledby="recipe-heading">
      <% if (example = recipe.examples.first) %>
        <%= render "accounts/recipes/example", example:, css: "aspect-2/3 w-20 shrink-0 rounded-md object-cover" %>
      <% end %>
      <div class="min-w-0 space-y-1">
        <div class="flex items-center gap-2">
          <h2 id="recipe-heading" class="text-sm font-semibold text-ink-900"><%= recipe.name %></h2>
          <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= recipe.kind %></span>
        </div>
        <p class="line-clamp-4 text-sm text-ink-600"><%= recipe.prompt %></p>
        <%= link_to "Edit recipe", edit_recipe_path(recipe), class: "text-sm text-ink-600 underline hover:text-ink-900" %>
      </div>
    </section>

    <%= form_with model: @generation, url: library_media_generations_path(media), class: "space-y-4" do |f| %>
      <%= hidden_field_tag :recipe_id, recipe.id %>
      <h2 class="text-sm font-medium text-ink-900">Generation options</h2>
      <% if @generation.errors.any? %>
        <p class="<%= tw_alert_error_classes %>" role="alert"><%= @generation.errors.full_messages.to_sentence %></p>
      <% end %>
      <div>
        <%= f.label :prompt, "Extra prompt", class: tw_label_classes %>
        <%= f.text_area :prompt, rows: 3, placeholder: "Added to the recipe's prompt for this generation only", class: tw_input_classes %>
      </div>
      <% @generation.option_choices.each do |key, choices| %>
        <% if key == "model" %>
          <div>
            <div class="flex items-baseline justify-between gap-2">
              <span id="generation_options_model" class="<%= tw_label_classes %>">Model</span>
              <% if Current.user&.admin? %>
                <%= link_to "Manage models", admin_models_path(account: nil), target: "_top", class: "text-xs text-ink-600 underline hover:text-ink-900" %>
              <% end %>
            </div>
            <div role="radiogroup" aria-labelledby="generation_options_model" class="divide-y divide-ink-900/10 overflow-hidden rounded-lg border border-ink-900/15 bg-white">
              <% @generation.models.each do |model| %>
                <label class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2 text-sm font-medium text-ink-900 transition hover:bg-stone-50">
                  <%= model.model_id %>
                  <%= radio_button_tag "generation[options][model]", model.model_id, @generation.options["model"] == model.model_id, class: "size-4 shrink-0 accent-rocket",
                        onchange: "this.form.requestSubmit(this.form.elements.refresh)" %>
                </label>
              <% end %>
            </div>
          </div>
          <% next %>
        <% end %>
        <% if key == "size" %>
          <fieldset>
            <legend class="<%= tw_label_classes %>">Size</legend>
            <div class="grid grid-cols-4 gap-2">
              <% shapes = { "1008x1792" => [ "Story", "9:16", "h-6 aspect-9/16" ], "1088x1360" => [ "Portrait", "4:5", "h-6 aspect-4/5" ],
                            "1088x1088" => [ "Square", "1:1", "h-5 aspect-square" ], "1792x1008" => [ "Landscape", "16:9", "w-7 aspect-video" ] } %>
              <% choices.each do |value| %>
                <% name, ratio, shape = shapes.fetch(value) %>
                <label class="flex cursor-pointer flex-col items-center gap-1 rounded-lg border border-ink-900/15 bg-white p-2 transition hover:border-ink-900/30 has-checked:border-rocket has-checked:ring-2 has-checked:ring-rocket/30 has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                  <%= radio_button_tag "generation[options][size]", value, @generation.options["size"] == value, class: "sr-only" %>
                  <span class="flex h-6 items-center"><span class="<%= shape %> rounded-sm border-2 border-current text-ink-700" aria-hidden="true"></span></span>
                  <span class="text-sm font-medium text-ink-900"><%= name %></span>
                  <span class="text-xs text-ink-500"><%= ratio %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
          <% next %>
        <% end %>
        <% if key == "quality" %>
          <fieldset>
            <legend class="<%= tw_label_classes %>">Quality</legend>
            <div class="flex gap-1 rounded-full bg-ink-900/5 p-1">
              <% [ "", *choices ].each do |value| %>
                <label class="flex-1 cursor-pointer rounded-full px-3 py-1 text-center text-sm font-medium text-ink-600 transition hover:text-ink-900 has-checked:bg-white has-checked:text-ink-900 has-checked:shadow-sm has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                  <%= radio_button_tag "generation[options][quality]", value, @generation.options["quality"].to_s == value, class: "sr-only" %>
                  <%= value.presence&.capitalize || "Auto" %>
                </label>
              <% end %>
            </div>
          </fieldset>
          <% next %>
        <% end %>
        <div>
          <%= label_tag "generation_options_#{key}", key.humanize, class: tw_label_classes %>
          <%= select_tag "generation[options][#{key}]",
                options_for_select(choices.map { [ key == "duration" ? "#{it} s" : it, it ] }, @generation.options[key]),
                id: "generation_options_#{key}", include_blank: "Auto", class: tw_input_classes %>
        </div>
      <% end %>
      <div class="flex gap-2">
        <%= link_to "Cancel", library_item_path(media), data: { turbo_frame: ("side_panel" if turbo_frame_request?) }, class: "rb-btn-ghost-on-light" %>
        <%= f.button class: "rb-btn-primary flex-1 gap-1.5" do %>
          <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Generate
        <% end %>
      </div>
      <%= tag.button name: "refresh", formaction: new_library_media_generation_path(media), formmethod: "get", hidden: true,
            data: { turbo_frame: ("side_panel" if turbo_frame_request?) } %>
    <% end %>
  </aside>
  </turbo-frame>
</div>
