<% content_for(:title, "Reviews — Rocketbox") %>

<div class="mx-auto max-w-3xl">
  <% if @reviews.any? %>
    <ul class="divide-y divide-ink-900/5 rounded-2xl border border-ink-900/10 bg-white">
      <% @reviews.each do |review| %>
        <li id="<%= dom_id(review) %>" class="flex gap-4 p-4">
          <% if review.avatar.attached? %>
            <%= image_tag url_for(review.avatar), alt: "", class: "size-10 shrink-0 rounded-full object-cover" %>
          <% else %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink-900/5 text-sm font-medium text-ink-600" aria-hidden="true">
              <%= review.customer_name.split.first(2).map { |w| w[0] }.join.upcase %>
            </span>
          <% end %>

          <div class="min-w-0 flex-1 space-y-2">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-ink-900"><%= review.customer_name %></p>
                <div class="mt-0.5 flex items-center gap-2">
                  <span class="flex" role="img" aria-label="<%= review.rating %> out of 5 stars">
                    <% 5.times do |i| %>
                      <%= heroicon "star", variant: :mini, options: { class: "size-4 #{i < review.rating ? "text-signal-yellow" : "text-ink-900/15"}", "aria-hidden": true } %>
                    <% end %>
                  </span>
                  <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium text-ink-700"><%= review.source.humanize %></span>
                  <span class="text-xs text-ink-500"><%= time_ago_in_words(review.created_at) %> ago</span>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-1">
                <%= button_to review.archived? ? "Restore" : "Archive", review_path(review), method: :patch,
                      class: "rounded-lg px-2.5 py-1.5 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
                <%= render "shared/admin_links/review", review: review %>
              </div>
            </div>

            <% if review.body.present? %>
              <p class="text-sm whitespace-pre-line text-ink-700"><%= review.body %></p>
            <% end %>

            <% if review.media.attached? %>
              <div class="flex flex-wrap gap-2">
                <% review.media.each do |file| %>
                  <%= link_to url_for(file), target: "_blank", rel: "noopener", class: "block" do %>
                    <% if file.video? %>
                      <%= video_tag url_for(file), muted: true, playsinline: true, preload: "metadata", class: "size-20 rounded-lg bg-ink-900/5 object-cover" %>
                    <% else %>
                      <%= image_tag url_for(file), alt: "Photo from #{review.customer_name}", class: "size-20 rounded-lg object-cover" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
      <%= params[:archived] ? "No archived reviews." : "Reviews we find about your business will show up here." %>
    </div>
  <% end %>
</div>
