<% content_for(:title, "WhatsApp — Rocketbox") %>

<section class="max-w-sm rounded-2xl border border-ink-900/10 bg-white p-6">
  <% if (phone = Current.account.whatsapp_phone) %>
    <p class="inline-flex items-center gap-2 font-semibold text-ink-900">
      <%= heroicon "check-circle", variant: :mini, options: { class: "size-5 text-signal-green", "aria-hidden": true } %>
      Connected: +<%= phone %>
    </p>
    <p class="mt-1 text-sm text-ink-600">Send photos and videos to Rocketbox from this number.</p>
    <%= button_to "Disconnect", whatsapp_path, method: :delete,
          form: { class: "mt-4", data: { turbo_confirm: "Disconnect +#{phone}?" } },
          class: "cursor-pointer rounded-lg border border-signal-red/40 bg-white px-4 py-2 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" %>
  <% else %>
    <h2 class="font-semibold text-ink-900">Connect WhatsApp</h2>
    <p class="mt-1 text-sm text-ink-600">Send the prefilled message from the phone you’ll use to send photos and videos. The link works once.</p>
    <div class="mt-6">
      <%= render "shared/whatsapp_qr", url: @whatsapp_url %>
    </div>
  <% end %>
</section>
