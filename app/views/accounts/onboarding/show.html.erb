<% content_for(:title, "Onboarding — Rocketbox") %>

<%
  user = Current.account
  steps = [
    { channel: :whatsapp, label: "WhatsApp linked", path: sign_up_path,
      done: user.whatsapp_phone.present?, value: user.whatsapp_phone&.then { "+#{_1}" }, reset: "whatsapp" },
    { channel: :whatsapp, label: "Name", ask: "name",
      done: user.name.present?, value: user.name, reset: "name" },
    { channel: :whatsapp, label: "Business name", ask: "business_name",
      done: user.business_name.present?, value: user.business_name, reset: "business_name" },
    { channel: :whatsapp, label: "Website", ask: "homepage_url",
      done: user.homepage_url.present?, value: user.homepage_url, reset: "homepage_url" },
    { channel: :instagram, label: "Instagram authorized", path: integrations_path, ask: "instagram",
      done: user.instagram_authorized?, value: user.instagram_user_id, reset: "instagram" },
    { channel: :web, label: "Signed in", path: sign_in_path,
      done: user.sessions.any?, value: pluralize(user.sessions.count, "session"), reset: "sessions",
      confirm: "Sign out all sessions except yours?" },
    { channel: :telegram, label: "Telegram linked", path: integrations_path,
      done: user.telegram_user_id.present?, value: user.telegram_user_id, reset: "telegram" },
    { channel: :web, label: "Subscription active", path: subscription_path,
      done: user.subscription&.active?, value: user.subscription&.status }
  ]
%>

<p class="text-xs text-ink-500">
  #<%= user.id %> · <%= user.account_label %> · joined <%= time_ago_in_words(user.created_at) %> ago ·
  <%= link_to "Active Admin", admin_user_path(user), target: "_blank", rel: "noopener", class: "underline underline-offset-2 hover:text-ink-900" %>
</p>

<section class="mt-6 max-w-2xl rounded-2xl border border-ink-900/10 bg-white p-6">
  <div class="flex items-center justify-between gap-3">
    <h2 class="font-manrope text-base font-bold text-ink-900">Steps</h2>
    <% if user.whatsapp_phone.present? %>
      <%= button_to onboarding_dashboard_link_path,
            class: "inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-lg border border-ink-900/15 px-2.5 py-1 text-xs font-medium text-ink-700 transition hover:bg-ink-900/5" do %>
        <%= image_tag "brands/whatsapp.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
        Send dashboard link
      <% end %>
    <% end %>
  </div>

  <ol class="mt-4 flex flex-col gap-2">
    <% steps.each do |step| %>
      <li class="flex items-center gap-3 rounded-lg border border-ink-900/10 px-3 py-2">
        <%= heroicon "check-circle", variant: (step[:done] ? :solid : :outline),
              options: { class: "size-5 shrink-0 #{step[:done] ? "text-signal-green" : "text-ink-900/15"}", role: "img", "aria-label": step[:done] ? "Done" : "Not done" } %>
        <span class="inline-flex w-24 shrink-0 items-center gap-1.5 text-xs font-medium text-ink-500">
          <% case step[:channel] %>
          <% when :whatsapp, :instagram, :telegram %>
            <%= image_tag "brands/#{step[:channel]}.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
            <%= step[:channel].to_s.capitalize %>
          <% else %>
            <%= heroicon "globe-alt", variant: :mini, options: { class: "size-4 shrink-0", "aria-hidden": true } %>
            Web
          <% end %>
        </span>
        <div class="min-w-0 flex-1">
          <% if step[:path] %>
            <%= link_to step[:label], step[:path], class: "text-sm font-medium text-ink-900 underline underline-offset-2 hover:text-rocket" %>
          <% else %>
            <p class="text-sm text-ink-900"><%= step[:label] %></p>
          <% end %>
          <% if step[:value].present? %>
            <p class="mt-0.5 truncate font-mono text-xs text-ink-500"><%= step[:value] %></p>
          <% end %>
        </div>
        <% if step[:done] && step[:reset] %>
          <%= button_to "Reset", onboarding_reset_path(step: step[:reset]),
                form: { data: { turbo_confirm: step[:confirm] || "Reset “#{step[:label]}” for #{user.account_label}?" } },
                class: "shrink-0 cursor-pointer rounded-lg border border-ink-900/15 px-2.5 py-1 text-xs font-medium text-ink-700 transition hover:bg-ink-900/5" %>
        <% elsif !step[:done] && step[:ask] && user.whatsapp_phone.present? %>
          <% if user.whatsapp_pending_question == step[:ask] %>
            <span class="shrink-0 text-xs text-ink-500">Waiting for reply</span>
          <% else %>
            <%= button_to "Ask in chat", onboarding_ask_path(field: step[:ask]),
                  class: "shrink-0 cursor-pointer rounded-lg bg-ink-900 px-2.5 py-1 text-xs font-medium text-white transition hover:bg-ink-800" %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

<section class="mt-6 max-w-2xl rounded-2xl border border-signal-red/30 bg-white p-6">
  <h2 class="font-manrope text-base font-bold text-ink-900">Danger zone</h2>

  <div class="mt-4 flex flex-col gap-4">
    <% unless user == Current.user %>
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-ink-900">Delete user</p>
          <p class="mt-0.5 text-xs text-ink-500">Removes <%= user.account_label %> so they can sign up again from scratch.</p>
        </div>
        <%= button_to "Delete user", onboarding_reset_path(step: "user"),
              form: { data: { turbo_confirm: "Delete #{user.account_label}? This can't be undone." } },
              class: "shrink-0 cursor-pointer rounded-lg border border-signal-red/40 px-2.5 py-1 text-xs font-semibold text-signal-red transition hover:bg-signal-red/5" %>
      </div>
    <% end %>
  </div>
</section>

<% content_for :aside do %>
  <section class="flex flex-col gap-3 px-2 py-2">
    <h2 class="font-manrope text-base font-bold text-ink-900">Meta</h2>
    <%= link_to "https://developers.facebook.com/apps/1836367217546891/dashboard/?business_id=925995145350263",
          target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-2 text-sm font-semibold text-ink-900 underline underline-offset-2 hover:text-rocket" do %>
      <%= image_tag "brands/facebook.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
      Facebook app
    <% end %>
    <% {
      "WhatsApp use case" => ["brands/whatsapp.svg", "https://developers.facebook.com/apps/1836367217546891/use_cases/customize/wa-configurations-v2/?use_case_enum=WHATSAPP_BUSINESS_MESSAGING&selected_tab=wa-configurations-v2&product_route=whatsapp-business&business_id=925995145350263"],
      "Instagram use case" => ["brands/instagram.svg", "https://developers.facebook.com/apps/1836367217546891/use_cases/customize/API-Setup/?product_route=instagram-business&business_id=925995145350263&use_case_enum=INSTAGRAM_BUSINESS&selected_tab=API-Setup"]
    }.each do |label, (icon, url)| %>
      <%= link_to url, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-2 text-sm text-ink-600 underline underline-offset-2 hover:text-ink-900" do %>
        <%= image_tag icon, class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
        <%= label %>
      <% end %>
      <% if label == "WhatsApp use case" %>
        <p class="-mt-1 pl-6 text-xs text-ink-500">
          Verify token
          <code class="block truncate font-mono text-ink-900 select-all"><%= WhatsappCloud.webhook_verify_token || "Not set" %></code>
        </p>
        <% WhatsappCloud::PHONES.each do |env, phone| %>
          <p class="-mt-1 pl-6 text-xs text-ink-500">
            <%= env %> number<%= " (this env)" if phone == WhatsappCloud.display_phone %>
            <%= link_to "+#{phone}", "https://wa.me/#{phone}", target: "_blank", rel: "noopener",
                  class: "block truncate font-mono text-ink-900 underline underline-offset-2 hover:text-rocket" %>
          </p>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% end %>
