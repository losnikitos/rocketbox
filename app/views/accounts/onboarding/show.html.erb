<% content_for(:title, "Onboarding — Rocketbox") %>

<%
  user = Current.account
  media_tab = params[:tab] == "media"
  media_counts = user.library_media.group(:media_type).count
  steps = if media_tab
    WhatsappOnboarding::MEDIA_REQUESTS.values.uniq.map do |type|
      count = media_counts[type].to_i
      { channel: :whatsapp, label: type.humanize, path: library_uploads_path(type:), ask: WhatsappOnboarding::MEDIA_REQUESTS.key(type), ask_again: true,
        done: count.positive?, value: pluralize(count, "file"),
        previews: user.library_media.where(media_type: type).with_attached_file.order(created_at: :desc).limit(6) }
    end
  else [
    { channel: :whatsapp, label: "WhatsApp linked", path: sign_up_path,
      done: user.whatsapp_phone.present?, value: user.whatsapp_phone&.then { "+#{_1}" }, reset: "whatsapp" },
    { channel: :whatsapp, label: "Business card", path: library_uploads_path(type: "business_card"), ask: "business_card",
      done: media_counts["business_card"].to_i.positive?, value: user.business_name },
    { channel: :whatsapp, label: "Logo", path: business_path, ask: "logo",
      done: user.logo.attached? },
    { channel: :instagram, label: "Instagram authorized", path: instagram_profile_path, ask: "instagram",
      done: user.instagram_authorized?, value: user.instagram_user_id, reset: "instagram" },
    { channel: :whatsapp, label: "Interior photos", path: library_uploads_path(type: "interior"), ask: "interior_back",
      done: media_counts["interior"].to_i >= 2, value: pluralize(media_counts["interior"].to_i, "photo") },
    { channel: :whatsapp, label: "Brand voice", path: business_path, ask: "brand_voice",
      done: user.brand_voice.present?, value: user.brand_voice&.capitalize, reset: "brand_voice" },
    { channel: :whatsapp, label: "Email", path: profile_settings_path, ask: "email",
      done: user.email.present?, value: user.email },
    { channel: :web, label: "Signed in", path: sign_in_path,
      done: user.sessions.any?, value: pluralize(user.sessions.count, "session"), reset: "sessions",
      confirm: "Sign out all sessions except yours?" },
    { channel: :telegram, label: "Telegram linked",
      done: user.telegram_user_id.present?, value: user.telegram_user_id, reset: "telegram" },
    { channel: :web, label: "Subscription active", path: subscription_path,
      done: user.subscription&.active?, value: user.subscription&.status }
  ] end
%>
<% content_for(:bare, "true") %>

<section class="rounded-2xl border border-ink-900/10 bg-white p-6">
  <div class="flex items-center justify-between gap-3">
    <h2 class="font-manrope text-base font-bold text-ink-900"><%= media_tab ? "Media" : "Steps" %></h2>
    <% if user.whatsapp_phone.present? %>
      <%= button_to onboarding_dashboard_link_path,
            class: "inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-lg border border-ink-900/15 px-2.5 py-1 text-xs font-medium text-ink-700 transition hover:bg-ink-900/5" do %>
        <%= image_tag "brands/whatsapp.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
        Send dashboard link
      <% end %>
    <% end %>
  </div>

  <ol class="mt-4 flex flex-col gap-2">
    <% steps.each do |step| %>
      <li class="flex items-center gap-3 rounded-lg border border-ink-900/10 px-3 py-2">
        <%= heroicon "check-circle", variant: (step[:done] ? :solid : :outline),
              options: { class: "size-5 shrink-0 #{step[:done] ? "text-signal-green" : "text-ink-900/15"}", role: "img", "aria-label": step[:done] ? "Done" : "Not done" } %>
        <span class="inline-flex w-24 shrink-0 items-center gap-1.5 text-xs font-medium text-ink-500">
          <% case step[:channel] %>
          <% when :whatsapp, :instagram, :telegram %>
            <%= image_tag "brands/#{step[:channel]}.svg", class: "size-4 shrink-0", alt: "", aria: { hidden: true } %>
            <%= step[:channel].to_s.capitalize %>
          <% else %>
            <%= heroicon "globe-alt", variant: :mini, options: { class: "size-4 shrink-0", "aria-hidden": true } %>
            Web
          <% end %>
        </span>
        <div class="min-w-0 flex-1">
          <% if step[:path] %>
            <%= link_to step[:label], step[:path], class: "text-sm font-medium text-ink-900 underline underline-offset-2 hover:text-rocket" %>
          <% else %>
            <p class="text-sm text-ink-900"><%= step[:label] %></p>
          <% end %>
          <% if step[:value].present? %>
            <p class="mt-0.5 truncate font-mono text-xs text-ink-500"><%= step[:value] %></p>
          <% end %>
          <% if step[:previews].present? %>
            <ul class="mt-2 flex gap-1.5">
              <% step[:previews].each do |media| %>
                <li>
                  <%= link_to library_upload_path(media), aria: { label: "Open #{media.kind}" } do %>
                    <%= render "accounts/library/file", media:, css: "size-10 rounded-md object-cover" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
        <% if step[:done] && step[:reset] %>
          <%= button_to "Reset", onboarding_reset_path(step: step[:reset]),
                form: { data: { turbo_confirm: step[:confirm] || "Reset “#{step[:label]}” for #{user.account_label}?" } },
                class: "shrink-0 cursor-pointer rounded-lg border border-ink-900/15 px-2.5 py-1 text-xs font-medium text-ink-700 transition hover:bg-ink-900/5" %>
        <% elsif (!step[:done] || step[:ask_again]) && step[:ask] && user.whatsapp_phone.present? %>
          <% if user.whatsapp_pending_question == step[:ask] %>
            <span class="shrink-0 text-xs text-ink-500">Waiting for reply</span>
          <% else %>
            <%= button_to "Ask in chat", onboarding_ask_path(field: step[:ask]),
                  class: "shrink-0 cursor-pointer rounded-lg bg-ink-900 px-2.5 py-1 text-xs font-medium text-white transition hover:bg-ink-800" %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

<% unless media_tab || user == Current.user %>
<section class="mt-6 rounded-2xl border border-signal-red/30 bg-white p-6">
  <h2 class="font-manrope text-base font-bold text-ink-900">Danger zone</h2>

  <div class="mt-4 flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-ink-900">Delete user</p>
      <p class="mt-0.5 text-xs text-ink-500">Removes <%= user.account_label %> so they can sign up again from scratch.</p>
    </div>
    <%= button_to "Delete user", onboarding_reset_path(step: "user"),
          form: { data: { turbo_confirm: "Delete #{user.account_label}? This can't be undone." } },
          class: "shrink-0 cursor-pointer rounded-lg border border-signal-red/40 px-2.5 py-1 text-xs font-semibold text-signal-red transition hover:bg-signal-red/5" %>
  </div>
</section>
<% end %>
