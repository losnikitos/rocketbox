<% content_for(:title, "Styles — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_style_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add style
  <% end %>
<% end %>

<% if @styles.any? %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @styles.each do |style| %>
      <li id="<%= dom_id(style) %>">
        <%= link_to edit_style_path(style), class: "flex h-full gap-4 rounded-2xl border border-ink-900/10 bg-white p-4 transition hover:border-ink-900/20" do %>
          <% if (example = style.examples.first) %>
            <%= render "accounts/prompts/example", example:, css: "aspect-2/3 w-20 shrink-0 rounded-md object-cover" %>
          <% else %>
            <span class="aspect-2/3 w-20 shrink-0 rounded-md bg-ink-900/5"></span>
          <% end %>
          <span class="min-w-0 space-y-1">
            <span class="block text-sm font-semibold text-ink-900"><%= style.name %></span>
            <span class="line-clamp-5 text-sm text-ink-600"><%= style.body %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a style — lighting, camera and colour cues added to a prompt or recipe.
  </div>
<% end %>
