<% content_for(:title, "Styles — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_style_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add style
  <% end %>
<% end %>

<% if @styles.any? %>
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
    <% @styles.each do |style| %>
      <% covered = style.examples.any? %>
      <li id="<%= dom_id(style) %>" class="relative aspect-2/3 overflow-hidden rounded-xl border border-ink-900/10 bg-ink-900/5 transition hover:border-ink-900/30"
          data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
        <% style.examples.each_with_index do |example, index| %>
          <div class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
            <%= render "accounts/recipes/example", example:, css: "size-full object-cover" %>
          </div>
        <% end %>
        <%= link_to edit_style_path(style), class: "absolute inset-0 flex items-start" do %>
          <span class="w-full p-4 text-sm font-semibold <%= covered ? "bg-linear-to-b from-black/60 to-transparent pb-10 text-white" : "text-ink-900" %>">
            <%= style.name %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a style — lighting, camera and colour cues added to a recipe.
  </div>
<% end %>
