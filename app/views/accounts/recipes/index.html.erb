<% content_for(:title, "Recipes — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_recipe_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add recipe
  <% end %>
<% end %>

<% if @recipes.any? || @recipe_folder %>
  <%= form_with url: "", method: :patch, class: "hidden", data: { drag_move_target: "form" } do %>
    <%= hidden_field_tag "recipe[folder_name]", nil, id: nil, data: { drag_move_target: "value" } %>
  <% end %>
  <% if @recipe_folder %>
    <%= form_with url: folder_recipes_path(@recipe_folder), method: :patch, class: "mb-6" do %>
      <h2><%= text_field_tag :name, @recipe_folder.name, id: nil, required: true, "aria-label": "Folder name",
            class: "-mx-2 field-sizing-content rounded-lg border-0 bg-transparent px-2 py-0.5 text-lg font-semibold text-ink-900 hover:bg-ink-900/5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rocket/30" %></h2>
    <% end %>
  <% end %>
  <div class="space-y-8">
    <% @recipes.group_by { it.updated_at.to_date }.each do |day, recipes| %>
      <section>
        <h2 class="mb-3 text-sm font-semibold text-ink-900"><%= upload_day_label(day) %></h2>
        <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-7 2xl:grid-cols-8 min-[1800px]:grid-cols-10">
          <% recipes.each do |recipe| %>
            <%= render "tile", recipe:, made: @made.fetch(recipe.id, []) %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
  <% if @recipes.none? %>
    <p class="rounded-xl border border-dashed border-ink-900/15 p-6 text-center text-sm text-ink-500">No recipes in this folder yet. Drag one onto it in the sidebar.</p>
  <% end %>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a recipe — a prompt that turns library media into new photos or videos.
  </div>
<% end %>
