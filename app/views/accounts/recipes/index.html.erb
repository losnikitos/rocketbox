<% content_for(:title, "Recipes — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_recipe_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add recipe
  <% end %>
<% end %>

<% if @recipes.any? %>
  <% chip = "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs" %>
  <% slot_link = "inline-flex rounded-full hover:*:border-ink-900/30" %>
  <% arrow = capture { heroicon "arrow-right", variant: :mini, options: { class: "hidden size-5 shrink-0 text-ink-300 lg:block", "aria-hidden": true } } %>
  <div class="space-y-8">
    <% Recipe.by_source(@recipes).each do |group| %>
      <section class="space-y-3">
        <% if params[:source].blank? %>
          <h2 class="text-sm font-bold text-ink-900"><%= group.first.source_label %></h2>
        <% end %>
        <ul class="space-y-3">
          <% group.each do |recipe| %>
            <% slots = recipe.slots %>
            <% kind_label, kind_icon = Recipe::KINDS[recipe.kind] %>
            <% settings = recipe.stitch? ? [ recipe.effect == "doppler" ? "Doppler" : "1 s each" ] :
                 [ *recipe.options.values_at("model", "aspect_ratio", "resolution"), recipe.options["duration"]&.then { "#{it} s" } ].compact_blank %>
            <li id="<%= dom_id(recipe) %>" class="group relative rounded-2xl border border-ink-900/10 bg-stone-50">
              <div class="py-3 pr-12 pl-4">
                <%= link_to recipe.name, new_recipe_run_path(recipe), class: "text-sm font-semibold text-ink-900 hover:underline" %>
              </div>
              <div class="flex flex-col gap-4 p-4 lg:flex-row lg:items-center">
                <ul class="flex flex-col items-start gap-1.5 lg:flex-1" aria-label="Inputs">
                  <% slots.each do |folder| %>
                    <li><%= folder ? link_to(render("slot", folder:), folder_path(folder), class: slot_link) : render("slot", folder:) %></li>
                  <% end %>
                  <% if (media = @source_media[recipe.source]&.presence) %>
                    <li><%= render "thumbs", media: %></li>
                  <% end %>
                  <% if recipe.takes_style? %>
                    <li class="<%= chip %> border-violet-200 bg-violet-50 text-violet-700">
                      <%= heroicon "swatch", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                      Style
                    </li>
                  <% end %>
                  <% if recipe.shot_group %>
                    <li class="<%= chip %> border-amber-200 bg-amber-50 text-amber-700">
                      <%= heroicon "camera", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                      <%= recipe.shot_group %> shot
                    </li>
                  <% end %>
                </ul>

                <%= arrow %>

                <div class="min-w-0 flex-1 space-y-2">
                  <p class="line-clamp-2 text-xs text-ink-500"><%= recipe.body %></p>
                  <ul class="flex flex-wrap gap-1.5" aria-label="Settings">
                    <li class="<%= chip %> border-transparent bg-ink-900/5 font-medium text-ink-900">
                      <%= heroicon kind_icon, variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
                      <%= kind_label %>
                    </li>
                    <% settings.each do |setting| %>
                      <li class="<%= chip %> border-ink-900/10 text-ink-600"><%= setting %></li>
                    <% end %>
                  </ul>
                </div>

                <%= arrow %>

                <div class="space-y-2 lg:flex-1" role="group" aria-label="Output">
                  <%= link_to render("slot", folder: recipe.output_folder), folder_path(recipe.output_folder), class: slot_link %>
                  <% examples = recipe.examples.first(5) %>
                  <%= render "thumbs", examples:, media: @made.fetch(recipe.id, []).first(5 - examples.size) %>
                </div>
              </div>

              <div class="absolute top-3 right-3 opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100 has-[:popover-open]:opacity-100">
                <%= render "shared/admin_links/recipe", recipe: %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a recipe — a prompt that turns library media into new photos or videos.
  </div>
<% end %>
