<% content_for(:title, "Recipes — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_recipe_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add recipe
  <% end %>
<% end %>

<% if @recipes.any? %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @recipes.each do |recipe| %>
      <li id="<%= dom_id(recipe) %>" class="flex flex-col gap-3 rounded-2xl border border-ink-900/10 bg-white p-6">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-semibold text-ink-900"><%= recipe.name %></h2>
          <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= recipe.format %></span>
        </div>
        <ul class="flex flex-wrap gap-1.5" aria-label="Photos">
          <% recipe.media_types.each do |type| %>
            <li class="rounded-full border border-ink-900/10 px-2 py-0.5 text-xs text-ink-600"><%= type&.name || "Unknown" %></li>
          <% end %>
        </ul>
        <p class="line-clamp-3 flex-1 text-sm text-ink-600"><%= recipe.body %></p>
        <div class="flex items-center justify-between gap-2">
          <%= link_to "Edit", edit_recipe_path(recipe), class: "text-sm text-ink-600 underline hover:text-ink-900" %>
          <%= link_to new_recipe_post_path(recipe), class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm" do %>
            <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
            Use recipe
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a recipe — a prompt that composes photobank photos into a post.
  </div>
<% end %>
