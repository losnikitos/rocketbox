<% content_for(:title, "Recipes — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_recipe_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add recipe
  <% end %>
<% end %>

<% if @recipes.any? %>
  <% by_group = @recipes.group_by(&:group) %>
  <% names = by_group.keys.compact.sort %>
  <% drop_css = "rounded-xl data-drop-over:outline-2 data-drop-over:outline-offset-4 data-drop-over:outline-rocket" %>
  <%= form_with url: "", method: :patch, class: "hidden", data: { drag_move_target: "form" } do %>
    <%= hidden_field_tag "recipe[group]", nil, id: nil, data: { drag_move_target: "value" } %>
  <% end %>
  <div class="space-y-8">
    <% (names + [ nil ]).each do |name| %>
      <% recipes = by_group.fetch(name, []) %>
      <%= tag.section class: drop_css, data: { move_to: name.to_s }, "aria-label": name || "Ungrouped" do %>
        <% if names.any? %>
          <h2 class="mb-3 text-sm font-semibold text-ink-900"><%= name || "Ungrouped" %></h2>
        <% end %>
        <% if recipes.any? %>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 min-[1800px]:grid-cols-8">
            <% recipes.each do |recipe| %>
              <%= render "tile", recipe:, made: @made.fetch(recipe.id, []) %>
            <% end %>
          </ul>
        <% else %>
          <p class="rounded-xl border border-dashed border-ink-900/15 p-6 text-center text-sm text-ink-500">Drop a recipe here to ungroup it.</p>
        <% end %>
      <% end %>
    <% end %>
    <div class="<%= drop_css %> flex items-center justify-center gap-1.5 border border-dashed border-ink-900/20 p-6 text-sm text-ink-500"
         data-move-to="" data-move-prompt="Group name">
      <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Drop a recipe here to start a new group
    </div>
  </div>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a recipe — a prompt that turns library media into new photos or videos.
  </div>
<% end %>
