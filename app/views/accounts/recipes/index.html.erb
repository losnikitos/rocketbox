<% content_for(:title, "Recipes — Rocketbox") %>
<% content_for :header_actions do %>
  <%= link_to new_recipe_path, class: "rb-btn-ghost-on-light gap-1.5 bg-white px-3.5 py-1.5 hover:bg-ink-900/5" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Add recipe
  <% end %>
<% end %>

<% if @recipes.any? %>
  <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
    <% @recipes.each do |recipe| %>
      <% covered = recipe.examples.any? %>
      <li id="<%= dom_id(recipe) %>" class="flex flex-col gap-3">
        <div class="relative aspect-2/3 overflow-hidden rounded-xl border border-ink-900/10 bg-ink-900/5 transition hover:border-ink-900/30"
             data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
          <% recipe.examples.each_with_index do |example, index| %>
            <div class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
              <%= render "accounts/prompts/example", example:, css: "size-full object-cover" %>
            </div>
          <% end %>
          <%= link_to edit_recipe_path(recipe), class: "absolute inset-0 flex items-start" do %>
            <span class="w-full p-4 text-sm font-semibold <%= covered ? "bg-linear-to-b from-black/60 to-transparent pb-10 text-white" : "text-ink-900" %>">
              <%= recipe.name %>
            </span>
          <% end %>
        </div>
        <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
          <li class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= recipe.format %></li>
          <% recipe.media_types.each do |type| %>
            <li class="rounded-full border border-ink-900/10 px-2 py-0.5 text-xs text-ink-600"><%= type&.name || "Unknown" %></li>
          <% end %>
          <% if recipe.shot_group %>
            <li class="rounded-full border border-dashed border-ink-900/20 px-2 py-0.5 text-xs text-ink-600"><%= recipe.shot_group %> shot</li>
          <% end %>
        </ul>
        <%= link_to new_recipe_post_path(recipe), class: "rb-btn-primary mt-auto gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Use recipe
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/10 bg-white p-6 text-center text-sm text-ink-500">
    Add a recipe — a prompt that composes photobank photos into a post.
  </div>
<% end %>
