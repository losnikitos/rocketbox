<%# locals: (recipe:) %>
<% island = "space-y-4 rounded-2xl border border-ink-900/10 bg-stone-50 p-6" %>
<% island_title = "scroll-m-24 text-base font-semibold text-ink-900" %>
<% refresh_url = recipe.persisted? ? recipe_path(recipe) : new_recipe_path %>
<%= form_with model: recipe, id: "recipe_form", multipart: true, class: "group/recipe @container space-y-6" do |f| %>
  <% ai_only = "group-has-[[value=stitch]:checked]/recipe:hidden group-has-[[value=feature]:checked]/recipe:hidden" %>
  <% feature_only = "hidden group-has-[[value=feature]:checked]/recipe:block" %>
  <% if recipe.errors.any? %>
    <div class="<%= tw_alert_error_classes %>" role="alert">
      <ul class="list-inside list-disc">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% example = capture do %>
    <label class="shrink-0">
      <span class="sr-only">Example</span>
      <span class="relative flex aspect-2/3 w-28 cursor-pointer items-center justify-center overflow-hidden rounded-lg border-2 border-dashed border-ink-900/15 text-ink-400 transition hover:border-rocket/50 hover:text-rocket has-focus-visible:border-rocket has-focus-visible:text-rocket">
        <%= heroicon "photo", options: { class: "size-6", "aria-hidden": true } %>
        <% saved = recipe.example.persisted? %>
        <%= tag.img src: (url_for(recipe.example) if saved), hidden: !saved, alt: "", class: "absolute inset-0 size-full object-cover" %>
        <%= f.file_field :example, accept: "image/*", class: "sr-only",
              onchange: "const img = this.previousElementSibling; if (this.files[0]) { img.src = URL.createObjectURL(this.files[0]); img.hidden = false }" %>
      </span>
    </label>
  <% end %>
  <%= render "accounts/recipes/header", recipe:, f:, example: %>

  <div class="grid items-start gap-6 @4xl:grid-cols-3">
    <section class="space-y-2">
      <h2 id="input" class="<%= island_title %>"><a href="#input" class="hover:underline">Input</a></h2>
      <%# A folder, toggle or group change reloads just this frame through the hidden refresh button. %>
      <turbo-frame id="recipe_inputs" target="_top" class="block space-y-4">
        <% refresh = "this.form.requestSubmit(this.form.elements.refresh_inputs)" %>
        <% on = ->(key, value) { value.present? || params.dig(:on, key).present? } %>
        <%= render "accounts/recipes/input_section", title: "Media", icon: "photo", chip: "border-sky-300 bg-sky-50 text-sky-600", key: :media,
              enabled: on.(:media, recipe.inputs) || (recipe.new_record? && params[:recipe].nil?), blank: "recipe[inputs][][folder_id]" do %>
          <% picked = @slots.each_with_index.map { |(_, photos), index| photos.find { it.id.to_s == params.dig(:media_ids, index.to_s) } } %>
          <div id="recipe_input_list" class="space-y-4">
            <% (@slots.presence || [ [ nil, [] ] ]).each_with_index do |(folder, photos), index| %>
              <%= render "accounts/recipes/input", folder:, photos:, index:, picked: %>
            <% end %>
          </div>
          <template id="recipe_input_template"><%= render "accounts/recipes/input", folder: nil, photos: [], index: nil, picked: [] %></template>
          <button type="button" class="inline-flex cursor-pointer items-center gap-1 text-xs text-ink-600 underline underline-offset-2 hover:text-ink-900"
                  onclick="const rows = document.getElementById('recipe_input_list');
                           rows.append(document.getElementById('recipe_input_template').content.cloneNode(true)); rows.lastElementChild.querySelector('button').focus()">
            <%= heroicon "plus", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
            Add input
          </button>
        <% end %>

        <%= render "accounts/recipes/input_section", title: "Style", icon: "swatch", chip: "border-violet-300 bg-violet-50 text-violet-600", key: :style,
              enabled: on.(:style, recipe.style_id), blank: "recipe[style_id]", css: ai_only do %>
          <% if (styles = Style.ordered.pluck(:name, :id)).any? %>
            <%= f.select :style_id, styles, {}, "aria-label": "Style", class: tw_input_classes %>
          <% else %>
            <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
              No styles yet. <%= link_to "Add some", styles_path, class: "underline hover:text-ink-900" %>
            </p>
          <% end %>
        <% end %>

        <%= render "accounts/recipes/input_section", title: "Shot", icon: "camera", chip: "border-amber-300 bg-amber-50 text-amber-600", key: :shot,
              enabled: on.(:shot, recipe.shot_group), blank: "recipe[shot_group]", css: ai_only do %>
          <%= f.select :shot_group, Shot.groups, {}, "aria-label": "Shot group", onchange: refresh, class: tw_input_classes %>
          <% if @shots %>
            <%= render "accounts/recipe_runs/pick", name: :shot_id, label: "Shot", items: @shots,
                  selected: @shots.find { it.id.to_s == params[:shot_id] } || @shots.sample,
                  empty: safe_join([ "No #{recipe.shot_group} shots yet. ", link_to("Add some", shots_path(group: recipe.shot_group), class: "underline hover:text-ink-900") ]) %>
          <% end %>
        <% end %>

        <%= render "accounts/recipes/input_section", title: "Review", icon: "star", chip: "border-yellow-300 bg-yellow-50 text-yellow-600", key: :review,
              enabled: on.(:review, recipe.takes_review?), blank: "recipe[takes_review]", off: "0", css: feature_only do %>
          <%= f.hidden_field :takes_review, value: "1", id: nil %>
          <% if @reviews %>
            <%= render "accounts/recipe_runs/pick", name: :review_id, label: "Review", items: @reviews, option: "accounts/recipe_runs/review_option",
                  selected: @reviews.find { it.id.to_s == params[:review_id] } || @reviews.sample,
                  empty: safe_join([ "No 5-star reviews with text yet. ", link_to("See reviews", reviews_path, class: "underline hover:text-ink-900") ]) %>
          <% end %>
        <% end %>

        <%= render "accounts/recipes/input_section", title: "Layer", icon: "square-3-stack-3d", chip: "border-rose-300 bg-rose-50 text-rose-600", key: :layer,
              enabled: on.(:layer, recipe.layer_slug), blank: "recipe[layer_slug]", css: feature_only do %>
          <div class="flex items-center gap-3">
            <%= f.select :layer_slug, Layer::ALL.map { [ it.name, it.slug ] }, {}, "aria-label": "Layer", onchange: refresh, class: tw_input_classes %>
            <% if recipe.layer %>
              <%= link_to "Preview", layer_path(recipe.layer), class: "shrink-0 text-sm text-ink-600 underline hover:text-ink-900" %>
            <% end %>
          </div>
        <% end %>
        <%= tag.button name: "refresh_inputs", formaction: refresh_url, formmethod: "get", formnovalidate: true, hidden: true, data: { turbo_frame: "recipe_inputs" } %>
      </turbo-frame>
    </section>

    <section class="space-y-2">
      <h2 id="processing" class="<%= island_title %>"><a href="#processing" class="hover:underline">Processing</a></h2>
      <div class="<%= island %>">
        <fieldset>
          <legend class="<%= tw_label_classes %>">Type</legend>
          <div class="<%= tw_segments_classes %>">
            <% Recipe::KINDS.each do |kind, (label, icon)| %>
              <label class="<%= tw_segment_classes %> flex items-center justify-center gap-1.5 px-3 py-1.5 text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :kind, kind, class: "sr-only", onchange: "this.form.requestSubmit(this.form.elements.refresh)" %>
                <%= heroicon icon, variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <fieldset class="group/effect hidden group-has-[[value=stitch]:checked]/recipe:block">
          <legend class="<%= tw_label_classes %>">Effect</legend>
          <div class="<%= tw_segments_classes %>">
            <% Recipe::EFFECTS.each do |effect, (label, _)| %>
              <label class="<%= tw_segment_classes %> flex items-center justify-center px-3 py-1.5 text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :effect, effect, class: "sr-only" %>
                <%= label %>
              </label>
            <% end %>
          </div>
          <% shown_when = { "default" => "group-has-[[value=default]:checked]/effect:block", "doppler" => "group-has-[[value=doppler]:checked]/effect:block",
                           "welcome" => "group-has-[[value=welcome]:checked]/effect:block" } %>
          <% Recipe::EFFECTS.each do |effect, (_, description)| %>
            <p class="mt-2 hidden text-sm text-ink-600 <%= shown_when[effect] %>"><%= description %></p>
          <% end %>
        </fieldset>
        <div class="<%= ai_only %>">
          <%= f.label :body, "Prompt", class: tw_label_classes %>
          <%= f.text_area :body, rows: 6, placeholder: "Compose a collage from the interior, the barber and the client…", class: tw_input_classes %>
        </div>
        <div class="<%= ai_only %>">
          <%= render "shared/generation_options", record: recipe, scope: "recipe", refresh_url: %>
        </div>
      </div>
    </section>

    <section class="space-y-2">
      <h2 id="output" class="<%= island_title %>"><a href="#output" class="hover:underline">Output</a></h2>
      <div class="<%= island %>">
        <div>
          <p class="<%= tw_label_classes %>">Folder</p>
          <div class="flex rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
            <%= render "shared/folder_pick", name: "recipe[output_folder_id]", selected: recipe.output_folder_id || Folder.ready.id,
                  label: "Output folder", roots: Folder.roots.where(slug: "photobank") %>
          </div>
        </div>

        <% if recipe.persisted? %>
          <div class="grid grid-cols-2 gap-2">
            <%= f.button name: "commit", value: "save_run", class: "rb-btn-primary col-span-2 gap-1.5 px-3.5 py-2" do %>
              <%= heroicon "play", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              Save and Run
            <% end %>
            <%= f.button "Run", name: "commit", value: "run", class: "rb-btn-ghost-on-light px-3.5 py-2" %>
            <%= f.button "Save", name: "commit", value: "save", class: "rb-btn-ghost-on-light px-3.5 py-2" %>
          </div>

          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-sm font-semibold text-ink-900">Made with <%= recipe.name_was %></h2>
            <% if @made.any? %>
              <%= link_to "View all", folder_path(recipe.output_folder, recipe: recipe.id), class: "text-sm text-ink-600 underline hover:text-ink-900" %>
            <% end %>
          </div>
          <% tile = "block overflow-hidden rounded-lg border border-ink-900/10 transition hover:border-ink-900/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" %>
          <% if @made.any? %>
            <ul class="grid grid-cols-3 gap-3">
              <% @made.limit(24).each do |media| %>
                <li class="min-w-0">
                  <%= link_to library_item_path(media), aria: { label: "Open #{media.kind}" }, class: tile do %>
                    <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-ink-500">Nothing made yet.</p>
          <% end %>
        <% else %>
          <%= f.button "Save", class: "rb-btn-primary w-full px-3.5 py-2" %>
        <% end %>
      </div>
    </section>
  </div>

  <% if recipe.persisted? %>
    <div class="flex justify-end">
      <%= link_to "Remove", recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: "Remove this recipe?" },
            class: "rounded-lg px-3.5 py-2 text-sm font-medium text-signal-red transition hover:bg-signal-red/10" %>
    </div>
  <% end %>
<% end %>
