<%# locals: (recipe:) %>
<% island = "space-y-4 rounded-2xl border border-ink-900/10 bg-stone-50 p-6" %>
<% island_title = "scroll-m-24 text-base font-semibold text-ink-900" %>
<%= form_with model: recipe, id: "recipe_form", multipart: true, class: "group/recipe @container space-y-6" do |f| %>
  <% ai_only = "group-has-[[value=stitch]:checked]/recipe:hidden" %>
  <% if recipe.errors.any? %>
    <div class="<%= tw_alert_error_classes %>" role="alert">
      <ul class="list-inside list-disc">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render layout: "accounts/recipes/header", locals: { recipe: } do %>
    <div class="w-full max-w-xs">
      <%= f.label :name, class: tw_label_classes %>
      <%= f.text_field :name, required: true, autofocus: recipe.new_record?, placeholder: "Team collage", class: tw_input_classes %>
    </div>
    <div class="w-full max-w-48">
      <%= f.label :group, class: tw_label_classes %>
      <%= f.text_field :group, list: "recipe_groups", placeholder: "Ungrouped", class: tw_input_classes %>
      <datalist id="recipe_groups">
        <% Recipe.groups.each do |group| %>
          <option value="<%= group %>"></option>
        <% end %>
      </datalist>
    </div>
    <label>
      <span class="<%= tw_label_classes %>">Example</span>
      <span class="relative flex aspect-2/3 w-20 cursor-pointer items-center justify-center overflow-hidden rounded-lg border-2 border-dashed border-ink-900/15 text-ink-400 transition hover:border-rocket/50 hover:text-rocket has-focus-visible:border-rocket has-focus-visible:text-rocket">
        <%= heroicon "photo", options: { class: "size-6", "aria-hidden": true } %>
        <% saved = recipe.example.persisted? %>
        <%= tag.img src: (url_for(recipe.example) if saved), hidden: !saved, alt: "", class: "absolute inset-0 size-full object-cover" %>
        <%= f.file_field :example, accept: "image/*", class: "sr-only",
              onchange: "const img = this.previousElementSibling; if (this.files[0]) { img.src = URL.createObjectURL(this.files[0]); img.hidden = false }" %>
      </span>
    </label>
  <% end %>

  <div class="grid items-start gap-6 @4xl:grid-cols-3">
    <section class="space-y-2">
      <h2 id="input" class="<%= island_title %>"><a href="#input" class="hover:underline">Input</a></h2>
      <div class="<%= island %>">
        <div>
          <div id="recipe_inputs" class="space-y-2">
            <% (recipe.inputs.presence || [ {} ]).each_with_index do |input, index| %>
              <%= render "accounts/recipes/input", input:, index: %>
            <% end %>
          </div>
          <button type="button" class="mt-2 inline-flex cursor-pointer items-center gap-1 text-xs text-ink-600 underline underline-offset-2 hover:text-ink-900"
                  onclick="const rows = document.getElementById('recipe_inputs'), row = rows.lastElementChild.cloneNode(true), trigger = row.querySelector('button');
                           row.querySelector('input').value = ''; trigger.ariaLabel = trigger.ariaLabel.replace(/\d+/, rows.children.length + 1);
                           rows.append(row); trigger.focus()">
            <%= heroicon "plus", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
            Add input
          </button>
        </div>
        <div class="<%= ai_only %> space-y-2">
          <% row_css = "flex items-center overflow-hidden rounded-lg border border-ink-900/15 bg-white text-sm opacity-60 transition has-[[type=checkbox]:checked]:opacity-100 focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30" %>
          <% toggle_css = "flex shrink-0 cursor-pointer items-center gap-2 self-stretch py-2 pl-3" %>
          <% chip_css = "flex size-5 items-center justify-center rounded border" %>
          <div class="<%= row_css %>">
            <label class="<%= toggle_css %> flex-1 pr-3">
              <%= f.check_box :takes_style, class: "size-4 accent-rocket" %>
              <span class="<%= chip_css %> border-violet-300 bg-violet-50 text-violet-600">
                <%= heroicon "swatch", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
              </span>
              <span class="font-medium text-ink-900">Style</span>
              <span class="ml-auto text-xs text-ink-500">Picked per run</span>
            </label>
          </div>
          <div class="<%= row_css %>">
            <label class="<%= toggle_css %> border-r border-ink-900/10 bg-stone-50 pr-3">
              <input type="checkbox" <%= "checked" if recipe.shot_group %> class="size-4 accent-rocket"
                     onchange="this.closest('div').querySelector('select').disabled = !this.checked">
              <span class="<%= chip_css %> border-amber-300 bg-amber-50 text-amber-600">
                <%= heroicon "camera", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
              </span>
              <span class="font-medium text-ink-900">Shot</span>
            </label>
            <%= hidden_field_tag "recipe[shot_group]", "", id: nil %>
            <%= f.select :shot_group, Shot.groups, {}, disabled: recipe.shot_group.nil?, "aria-label": "Shot group",
                  class: "min-w-0 flex-1 cursor-pointer border-0 bg-transparent py-2 pl-3 text-ink-900 focus:outline-none focus:ring-0 disabled:cursor-default" %>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-2">
      <h2 id="processing" class="<%= island_title %>"><a href="#processing" class="hover:underline">Processing</a></h2>
      <div class="<%= island %>">
        <fieldset>
          <legend class="<%= tw_label_classes %>">Type</legend>
          <div class="<%= tw_segments_classes %>">
            <% Recipe::KINDS.each do |kind, (label, icon)| %>
              <label class="<%= tw_segment_classes %> flex items-center justify-center gap-1.5 px-3 py-1.5 text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :kind, kind, class: "sr-only", onchange: "this.form.requestSubmit(this.form.elements.refresh)" %>
                <%= heroicon icon, variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <fieldset class="group/effect hidden group-has-[[value=stitch]:checked]/recipe:block">
          <legend class="<%= tw_label_classes %>">Effect</legend>
          <div class="<%= tw_segments_classes %>">
            <% Recipe::EFFECTS.each do |effect, (label, _)| %>
              <label class="<%= tw_segment_classes %> flex items-center justify-center px-3 py-1.5 text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :effect, effect, class: "sr-only" %>
                <%= label %>
              </label>
            <% end %>
          </div>
          <% shown_when = { "default" => "group-has-[[value=default]:checked]/effect:block", "doppler" => "group-has-[[value=doppler]:checked]/effect:block" } %>
          <% Recipe::EFFECTS.each do |effect, (_, description)| %>
            <p class="mt-2 hidden text-sm text-ink-600 <%= shown_when[effect] %>"><%= description %></p>
          <% end %>
        </fieldset>
        <div class="<%= ai_only %>">
          <%= f.label :body, "Prompt", class: tw_label_classes %>
          <%= f.text_area :body, rows: 6, placeholder: "Compose a collage from the interior, the barber and the client…", class: tw_input_classes %>
        </div>
        <div class="<%= ai_only %>">
          <%= render "shared/generation_options", record: recipe, scope: "recipe",
                refresh_url: recipe.persisted? ? edit_recipe_path(recipe) : new_recipe_path %>
        </div>
      </div>
    </section>

    <section class="space-y-2">
      <h2 id="output" class="<%= island_title %>"><a href="#output" class="hover:underline">Output</a></h2>
      <div class="<%= island %>">
        <div>
          <p class="<%= tw_label_classes %>">Folder</p>
          <div class="flex rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
            <%= render "shared/folder_pick", name: "recipe[output_folder_id]", selected: recipe.output_folder_id || Folder.ready.id,
                  label: "Output folder", roots: Folder.roots.where(slug: "photobank") %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="flex items-center justify-between gap-2">
    <% if recipe.persisted? %>
      <%= link_to "Remove", recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: "Remove this recipe?" },
            class: "rounded-lg px-3.5 py-2 text-sm font-medium text-signal-red transition hover:bg-signal-red/10" %>
    <% end %>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to "Cancel", recipes_path, class: "rounded-lg px-3.5 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
      <%= f.button "Save", class: "rb-btn-primary px-3.5 py-2 text-sm" %>
    </div>
  </div>
<% end %>
