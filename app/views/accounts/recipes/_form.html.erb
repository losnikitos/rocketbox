<%# locals: (recipe:) %>
<% slot_count = [ recipe.media_type_ids.size, 5 ].max %>
<div class="max-w-2xl space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Recipes", recipes_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= recipe.new_record? ? "New recipe" : recipe.name_was %></span>
  </nav>

  <%= form_with model: recipe, class: "space-y-4" do |f| %>
    <% if recipe.errors.any? %>
      <div class="<%= tw_alert_error_classes %>" role="alert">
        <ul class="list-inside list-disc">
          <% recipe.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="max-w-md">
      <%= f.label :name, class: tw_label_classes %>
      <%= f.text_field :name, required: true, autofocus: recipe.new_record?, placeholder: "Team collage", class: tw_input_classes %>
    </div>

    <fieldset class="max-w-md">
      <legend class="<%= tw_label_classes %>">Makes</legend>
      <div class="flex gap-1 rounded-full bg-ink-900/5 p-1">
        <% Recipe.formats.each_key do |format| %>
          <label class="flex flex-1 cursor-pointer items-center justify-center rounded-full px-3 py-1 text-sm font-medium text-ink-600 transition hover:text-ink-900 has-checked:bg-white has-checked:text-ink-900 has-checked:shadow-sm has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
            <%= f.radio_button :format, format, class: "sr-only" %>
            <%= format.humanize %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="max-w-md">
      <legend class="<%= tw_label_classes %>">Photos</legend>
      <div class="space-y-2">
        <% slot_count.times do |index| %>
          <%= select_tag "recipe[media_type_ids][]",
                options_for_select(MediaType.ordered.pluck(:name, :id), recipe.media_type_ids[index]),
                id: "recipe_media_type_ids_#{index}", include_blank: "—", "aria-label": "Photo #{index + 1}", class: tw_input_classes %>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= f.label :body, "Prompt", class: tw_label_classes %>
      <%= f.text_area :body, required: true, rows: 6, placeholder: "Compose a collage from the interior, the barber and the client…", class: tw_input_classes %>
    </div>

    <div class="flex items-center justify-between gap-2">
      <% if recipe.persisted? %>
        <%= link_to "Remove", recipe_path(recipe), data: { turbo_method: :delete, turbo_confirm: "Remove this recipe?" },
              class: "rounded-lg px-3.5 py-2 text-sm font-medium text-signal-red transition hover:bg-signal-red/10" %>
      <% end %>
      <div class="ml-auto flex items-center gap-2">
        <%= link_to "Cancel", recipes_path, class: "rounded-lg px-3.5 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
        <%= f.button "Save", class: "rb-btn-primary px-3.5 py-2 text-sm" %>
      </div>
    </div>
  <% end %>
</div>
