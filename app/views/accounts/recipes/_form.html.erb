<%# locals: (recipe:) %>
<%# Examples sit outside the form for layout; fields join it via form="recipe_form". %>
<div class="@container space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Recipes", recipes_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= recipe.new_record? ? "New recipe" : recipe.name_was %></span>
  </nav>

  <div class="grid items-start gap-8 @3xl:grid-cols-2">
    <%= form_with model: recipe, id: "recipe_form", multipart: true, class: "min-w-0 space-y-4" do |f| %>
      <% if recipe.errors.any? %>
        <div class="<%= tw_alert_error_classes %>" role="alert">
          <ul class="list-inside list-disc">
            <% recipe.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="max-w-md">
        <%= f.label :name, class: tw_label_classes %>
        <%= f.text_field :name, required: true, autofocus: recipe.new_record?, placeholder: "Bank holiday story", class: tw_input_classes %>
      </div>

      <div class="max-w-md">
        <%= f.label :media_type_id, "Suitable for", class: tw_label_classes %>
        <%= f.select :media_type_id, MediaType.ordered.pluck(:name, :id), {}, required: true, class: tw_input_classes %>
      </div>

      <fieldset class="max-w-md">
        <legend class="<%= tw_label_classes %>">Makes</legend>
        <div class="flex gap-1 rounded-full bg-ink-900/5 p-1">
          <% { "image" => "photo", "video" => "film" }.each do |kind, icon| %>
            <label class="flex flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium text-ink-600 transition hover:text-ink-900 has-checked:bg-white has-checked:text-ink-900 has-checked:shadow-sm has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
              <%= f.radio_button :kind, kind, class: "sr-only" %>
              <%= heroicon icon, variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              <%= kind.humanize %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div>
        <%= f.label :prompt, class: tw_label_classes %>
        <%= f.text_area :prompt, required: true, rows: 6, class: tw_input_classes %>
      </div>
    <% end %>

    <div class="min-w-0">
      <h2 id="examples" class="<%= tw_label_classes %> scroll-m-24"><a href="#examples" class="hover:underline">Examples</a></h2>
      <div class="rounded-2xl border border-ink-900/10 bg-stone-50 p-6 transition data-dragging:ring-2 data-dragging:ring-rocket/40" data-controller="file-preview"
           data-action="dragover->file-preview#over dragleave->file-preview#leave drop->file-preview#drop">
        <% trash = heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        <% remove = { type: "button", data: { action: "file-preview#remove" },
                      class: "absolute bottom-2 right-2 rounded-lg bg-white/90 p-1.5 text-ink-700 opacity-0 shadow-sm transition group-hover:opacity-100 hover:bg-white hover:text-signal-red focus-visible:opacity-100" } %>
        <template data-file-preview-target="remove"><%= tag.button trash, **remove %></template>
        <%# Keeps the key present so removing every example clears them on save. %>
        <%= hidden_field_tag "recipe[examples][]", "", id: nil, form: "recipe_form" %>
        <ul class="grid grid-cols-3 gap-3" data-file-preview-target="list">
          <% recipe.examples.select(&:persisted?).each do |example| %>
            <li class="group relative">
              <% if example.video? %>
                <%= render "example", example:, css: "aspect-2/3 w-full rounded-lg object-cover" %>
              <% else %>
                <button type="button" popovertarget="example-<%= example.id %>" aria-label="View <%= example.filename %>" class="block w-full cursor-zoom-in">
                  <%= render "example", example:, css: "aspect-2/3 w-full rounded-lg object-cover" %>
                </button>
                <div id="example-<%= example.id %>" popover class="size-full bg-black/90 p-4">
                  <button type="button" popovertarget="example-<%= example.id %>" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
                    <%= image_tag url_for(example), alt: example.filename.to_s, class: "max-h-full max-w-full" %>
                  </button>
                </div>
              <% end %>
              <%= hidden_field_tag "recipe[examples][]", example.signed_id, id: nil, form: "recipe_form" %>
              <%= tag.button trash, **remove, "aria-label": "Remove #{example.filename}" %>
            </li>
          <% end %>
          <li data-file-preview-target="add">
            <label class="flex aspect-2/3 cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-ink-900/15 px-2 text-center text-ink-400 transition hover:border-rocket/50 hover:text-rocket has-focus-visible:border-rocket has-focus-visible:text-rocket">
              <%= heroicon "plus", options: { class: "size-6", "aria-hidden": true } %>
              <span class="text-xs">Drop images or videos</span>
              <%= file_field_tag "recipe[examples][]", multiple: true, accept: "image/*,video/*", form: "recipe_form", "aria-label": "Add examples",
                    data: { file_preview_target: "input", action: "change->file-preview#show" }, class: "sr-only" %>
            </label>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2">
    <%= link_to "Cancel", recipes_path, class: "rounded-lg px-3.5 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
    <button type="submit" form="recipe_form" class="rb-btn-primary px-3.5 py-2 text-sm">Save</button>
  </div>
</div>
