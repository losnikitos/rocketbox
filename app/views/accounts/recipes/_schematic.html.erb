<%# locals: (workflow:, recipe:, run: nil) %>
<% icons = { "pending" => [ "ellipsis-horizontal-circle", "text-ink-300" ], "running" => [ "arrow-path", "animate-spin text-signal-yellow" ],
             "complete" => [ "check-circle", "text-signal-green" ], "failed" => [ "x-circle", "text-signal-red" ] } %>
<% borders = { "running" => "border-signal-yellow", "complete" => "border-signal-green", "failed" => "border-signal-red" } %>
<div class="overflow-x-auto rounded-xl bg-stone-50 p-4">
  <ol class="flex w-max items-stretch gap-2">
    <% workflow.columns.each_with_index do |column, index| %>
      <% if index.positive? %>
        <li class="flex items-center" aria-hidden="true">
          <%= heroicon "arrow-long-right", variant: :mini, options: { class: "size-5 text-ink-300" } %>
        </li>
      <% end %>
      <li class="flex w-56 flex-col justify-around gap-3">
        <% column.each do |step| %>
          <% record = run&.step(step.key) %>
          <article id="<%= step.key %>" class="group relative scroll-m-24 rounded-xl border bg-white text-xs shadow-sm target:ring-2 target:ring-rocket <%= borders.fetch(record&.status, "border-ink-900/10") %>">
            <header class="flex items-center gap-2 border-b border-ink-900/10 px-3 py-2">
              <%= heroicon step.node::ICON, variant: :mini, options: { class: "size-4 shrink-0 text-rocket", "aria-hidden": true } %>
              <span class="font-semibold text-ink-900"><%= step.node::LABEL %></span>
              <a href="#<%= step.key %>" class="truncate text-ink-400 hover:text-ink-900 hover:underline"><%= step.key %></a>
              <% if record %>
                <div class="absolute right-8 top-1.5 flex opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
                  <%= render "shared/admin_links/workflow_step", workflow_step: record %>
                </div>
                <% icon, css = icons.fetch(record.status) %>
                <%= heroicon icon, variant: :mini, options: { class: "ml-auto size-4 shrink-0 #{css}", "aria-label": record.status } %>
              <% end %>
            </header>
            <dl class="space-y-1.5 px-3 py-2">
              <% if step.from.many? %>
                <div><dt class="text-ink-400">From</dt><dd class="text-ink-900"><%= step.from.join(", ") %></dd></div>
              <% end %>
              <% recipe.params_for(step).each do |name, value| %>
                <div><dt class="text-ink-400"><%= name.humanize %></dt><dd class="line-clamp-3 text-ink-900" title="<%= value %>"><%= value %></dd></div>
              <% end %>
            </dl>
            <% if record %>
              <% if (blobs = record.output_blobs).any? %>
                <div class="flex flex-wrap gap-1 px-3 pb-2">
                  <% blobs.each do |blob| %>
                    <% if blob.video? %>
                      <%= video_tag rails_blob_path(blob), muted: true, class: "h-16 w-9 rounded object-cover" %>
                    <% else %>
                      <% lightbox = "#{step.key}-blob-#{blob.id}" %>
                      <button type="button" popovertarget="<%= lightbox %>" aria-label="View <%= blob.filename %>" class="cursor-zoom-in">
                        <%= image_tag rails_blob_path(blob), alt: "", class: "h-16 w-9 rounded object-cover" %>
                      </button>
                      <div id="<%= lightbox %>" popover class="size-full bg-black/90 p-4">
                        <button type="button" popovertarget="<%= lightbox %>" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
                          <%= image_tag rails_blob_path(blob), alt: blob.filename.to_s, class: "max-h-full max-w-full" %>
                        </button>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
              <% if record.error.present? %>
                <p class="px-3 pb-2 text-signal-red"><%= record.error %></p>
              <% end %>
              <% if record.failed? || (record.complete? && !run.running?) %>
                <div class="px-3 pb-3">
                  <%= button_to record.failed? ? "Retry" : "Re-run", run.subject.is_a?(Generation) ? rerun_library_media_path(run.subject.generated_media, key: step.key) : rerun_instagram_post_path(run.subject, key: step.key),
                        class: "rb-btn-ghost-on-light px-2.5 py-1 text-xs" %>
                </div>
              <% end %>
            <% end %>
          </article>
        <% end %>
      </li>
    <% end %>
  </ol>
</div>
