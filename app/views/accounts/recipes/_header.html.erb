<%# locals: (recipe:, f:, example:) %>
<header class="flex items-start gap-6">
  <%= example %>
  <div class="min-w-0 flex-1 space-y-3">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
      <%= link_to "Recipes", recipes_path, class: "underline underline-offset-2 hover:text-ink-900" %>
      <span class="mx-1">/</span>
      <% if (folder = RecipeFolder.find_by(id: recipe.recipe_folder_id_was)) %>
        <%= link_to folder.name, folder_recipes_path(folder), class: "underline underline-offset-2 hover:text-ink-900" %>
        <span class="mx-1">/</span>
      <% end %>
      <span aria-current="page"><%= recipe.new_record? ? "New recipe" : recipe.name_was %></span>
    </nav>
    <div class="min-w-0">
      <% inline = "-mx-2 block max-w-full min-w-0 field-sizing-content rounded-lg border-0 bg-transparent px-2 placeholder:text-ink-400 hover:bg-ink-900/5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rocket/30" %>
      <%# On change, not input: each save makes a group or a slug. %>
      <% autosave = { action: "change->autosave#queue" } if recipe.persisted? %>
      <%= f.text_field :folder_name, list: "recipe_folders", placeholder: "Ungrouped", "aria-label": "Folder", data: autosave, class: "#{inline} py-0.5 text-sm font-medium text-ink-500" %>
      <datalist id="recipe_folders">
        <% RecipeFolder.ordered.pluck(:name).each do |name| %>
          <option value="<%= name %>"></option>
        <% end %>
      </datalist>
      <h1><%= f.text_field :name, required: true, autofocus: recipe.new_record?, placeholder: "Recipe name", "aria-label": "Name", data: autosave, class: "#{inline} py-0.5 text-2xl font-semibold text-ink-900" %></h1>
    </div>
  </div>
  <%= render "shared/admin_links/recipe", recipe: recipe if recipe.persisted? %>
</header>
