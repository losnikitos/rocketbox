<%# locals: (input:, index:) %>
<%# One input: a folder and a tag. Remove drops the row, or clears the last one. %>
<% select_css = "min-w-0 cursor-pointer border-0 bg-transparent py-2 pl-3 text-ink-900 focus:outline-none focus:ring-0" %>
<div class="flex items-center overflow-hidden rounded-lg border border-ink-900/15 bg-white text-sm focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
  <span class="flex shrink-0 items-center self-stretch border-r border-ink-900/10 bg-stone-50 pl-3">
    <span class="flex size-5 items-center justify-center rounded border border-sky-300 bg-sky-50 text-sky-600">
      <%= heroicon "folder", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
    </span>
    <%= select_tag "recipe[inputs][][collection]", options_for_select(LibraryMedia.collections.keys.map { [ it.humanize, it ] }, input["collection"]),
          id: nil, "aria-label": "Input #{index + 1} folder", class: "#{select_css} font-medium" %>
  </span>
  <%= select_tag "recipe[inputs][][tag_id]", options_for_select(Tag.ordered.pluck(:name, :id), input["tag_id"]),
        id: nil, include_blank: "—", "aria-label": "Input #{index + 1} tag", class: "#{select_css} flex-1" %>
  <button type="button" aria-label="Remove input" class="mr-1 shrink-0 cursor-pointer rounded-md p-1.5 text-ink-400 transition hover:bg-ink-900/5 hover:text-ink-900"
          onclick="const row = this.parentElement; row.parentElement.children.length > 1 ? row.remove() : row.querySelector('[name$=&quot;[tag_id]&quot;]').value = ''">
    <%= heroicon "x-mark", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
  </button>
</div>
