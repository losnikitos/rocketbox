<%# locals: (folder:, count:, photos:, index:) %>
<%# One input: a folder, how many media a run takes from it, then those media. Picking a folder, changing the count or
    removing the row refreshes the inputs; the last row stays. `index` is nil for a row just added, until that refresh.
    Media already in `media_ids[]` stay picked, the rest of the count is random. %>
<% label = index ? "Input #{index + 1}" : "New input" %>
<div role="group" aria-label="<%= label %>" class="group/input space-y-2"
     onchange="['hidden', 'number'].includes(event.target.type) && this.closest('form').requestSubmit(this.closest('form').elements.refresh_inputs)">
  <div class="flex items-center gap-2">
    <% if index %><span class="text-sm font-medium text-ink-700"><%= index + 1 %>.</span><% end %>
    <div class="flex min-w-0 flex-1 items-center rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
      <%= render "shared/folder_pick", name: "recipe[inputs][][folder_id]", selected: folder&.id, label: "#{label} folder", padding: "py-3" %>
      <% if folder %>
        <%= link_to folder_path(folder), target: "_blank", aria: { label: "Open #{folder.path}" },
              class: "shrink-0 rounded-md p-1.5 text-ink-400 transition hover:bg-ink-900/5 hover:text-ink-900" do %>
          <%= heroicon "arrow-top-right-on-square", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        <% end %>
      <% end %>
      <button type="button" aria-label="Remove <%= label.downcase %>" class="mr-1 shrink-0 cursor-pointer rounded-md p-1.5 text-ink-400 transition group-only/input:hidden hover:bg-ink-900/5 hover:text-ink-900"
              onclick="const form = this.form; this.closest('[role=group]').remove(); form.requestSubmit(form.elements.refresh_inputs)">
        <%= heroicon "x-mark", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      </button>
    </div>
    <span class="text-lg font-semibold text-ink-400" aria-hidden="true">×</span>
    <%= number_field_tag "recipe[inputs][][count]", count, min: 1, id: nil, "aria-label": "#{label} count", title: "How many to take",
          class: "w-16 shrink-0 self-stretch rounded-lg border border-ink-900/15 bg-white px-2 text-lg font-semibold text-ink-900 tabular-nums focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30" %>
  </div>
  <% if folder && photos.any? %>
    <% wanted = Array(params[:media_ids]).grep(String) %>
    <% kept = photos.select { wanted.include?(it.id.to_s) }.first(count) %>
    <% selected = kept + (photos - kept).sample(count - kept.size) %>
    <% popover_id = "media-pick-#{index}" %>
    <div data-controller="media-pick" data-media-pick-max-value="<%= count %>" class="group space-y-1">
      <button type="button" popovertarget="<%= popover_id %>" style="anchor-name: --<%= popover_id %>"
              aria-label="Choose <%= folder.name.downcase %>"
              class="flex w-full min-w-0 cursor-pointer items-center justify-between gap-1 rounded-xl border border-ink-900/10 bg-white p-1.5 transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
        <span data-media-pick-target="preview" class="flex h-28 min-w-0 gap-1 overflow-hidden *:aspect-2/3 *:h-full *:shrink-0 *:overflow-hidden *:rounded-lg">
          <% selected.each do |media| %>
            <span class="block"><%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover", play: true %></span>
          <% end %>
        </span>
        <%= heroicon "chevron-down", options: { class: "size-5 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
      </button>
      <% if photos.size < count %>
        <p class="text-sm text-signal-red">Only <%= photos.size %> in <%= folder.name %>, a run takes <%= count %>.</p>
      <% end %>
      <div id="<%= popover_id %>" popover data-media-pick-target="popover"
           style="position-anchor: --<%= popover_id %>"
           class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-[anchor-size(width)] overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-2 shadow-lg">
        <% kinds = photos.map { it.video? ? "video" : "image" } %>
        <div class="mb-2 flex flex-wrap gap-2 *:gap-1.5 *:px-2.5 *:py-1.5">
          <button type="button" data-action="media-pick#none" class="rb-btn-ghost-on-light">None</button>
          <% %w[image video].each do |kind| %>
            <% if kinds.include?(kind) %>
              <button type="button" data-action="media-pick#random" data-media-pick-kind-param="<%= kind %>" aria-label="Random <%= pluralize(count, kind) %>" class="rb-btn-ghost-on-light">
                <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %>
                <%= pluralize(count, kind) %>
              </button>
            <% end %>
          <% end %>
        </div>
        <div class="grid grid-cols-4 gap-2">
          <% photos.zip(kinds).each do |media, kind| %>
            <label class="group/option relative block cursor-pointer overflow-hidden rounded-lg border border-ink-900/15 hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
              <%= check_box_tag "media_ids[]", media.id, selected.include?(media), id: nil, class: "sr-only", data: { media_pick_target: "option", action: "media-pick#pick", kind: } %>
              <span class="block"><%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover", play: true %></span>
              <span class="absolute top-1 right-1 flex size-5 items-center justify-center rounded-full border-2 border-white bg-black/20 text-transparent shadow-sm group-has-checked/option:border-rocket group-has-checked/option:bg-rocket group-has-checked/option:text-white" aria-hidden="true">
                <%= heroicon "check", variant: :micro, options: { class: "size-3.5" } %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif folder %>
    <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
      No media in <%= render "accounts/recipes/slot", folder: %>.
      <%= link_to "Add some", folder_path(folder), class: "underline hover:text-ink-900" %>
    </p>
  <% end %>
</div>
