<%# locals: (input:, index:) %>
<%# One input: a folder. Remove drops the row; the last row stays. %>
<div class="group/input flex items-center rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
  <%= render "shared/folder_pick", name: "recipe[inputs][][folder_id]", selected: input["folder_id"], label: "Input #{index + 1} folder" %>
  <button type="button" aria-label="Remove input" class="mr-1 shrink-0 cursor-pointer rounded-md p-1.5 text-ink-400 transition group-only/input:hidden hover:bg-ink-900/5 hover:text-ink-900"
          onclick="this.parentElement.remove()">
    <%= heroicon "x-mark", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
  </button>
</div>
