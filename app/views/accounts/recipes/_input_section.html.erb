<%# locals: (title:, icon:, chip:, key:, enabled:, blank:, off: "", css: nil) %>
<%# One input type. Its checkbox switches the fieldset on or off and refreshes the inputs; `on[key]` keeps a section on
    before it has a value. While it's off, the `blank` recipe param (set to `off`) clears the input. %>
<section aria-label="<%= title %>" class="<%= css %> rounded-2xl border border-ink-900/10 bg-stone-50 p-4">
  <label class="flex cursor-pointer items-center gap-2 text-sm">
    <%= check_box_tag "on[#{key}]", "1", enabled, id: nil, class: "size-4 accent-rocket",
          onchange: "this.closest('section').querySelector('fieldset').disabled = !this.checked; this.form.requestSubmit(this.form.elements.refresh_inputs)" %>
    <span class="flex size-5 items-center justify-center rounded border <%= chip %>">
      <%= heroicon icon, variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
    </span>
    <span class="font-medium text-ink-900"><%= title %></span>
  </label>
  <%= hidden_field_tag blank, off, id: nil %>
  <%= tag.fieldset disabled: !enabled, class: "mt-3 min-w-0 space-y-3 disabled:hidden" do %>
    <%= yield %>
  <% end %>
</section>
