<%# locals: (recipe:, path:, folder: true, arrow: "arrow-right") %>
<%= link_to path, class: "flex items-center gap-3 rounded-lg p-2 hover:bg-ink-900/5" do %>
  <% if recipe.example.attached? %>
    <%= render "accounts/recipes/example", example: recipe.example, css: "aspect-2/3 w-12 shrink-0 rounded-md object-cover" %>
  <% elsif recipe.type %>
    <%= image_tag recipe.type.cover, alt: "", class: "aspect-2/3 w-12 shrink-0 rounded-md object-cover" %>
  <% else %>
    <span class="aspect-2/3 w-12 shrink-0 rounded-md bg-ink-900/5" aria-hidden="true"></span>
  <% end %>
  <span class="min-w-0 space-y-1">
    <span class="block truncate text-sm font-semibold text-ink-900"><%= recipe.name %></span>
    <% if folder %>
      <span class="flex items-center gap-1">
        <%= heroicon arrow, variant: :micro, options: { class: "size-3.5 shrink-0 text-ink-500", role: "img", "aria-label": "Outputs to" } %>
        <%= render "accounts/recipes/slot", folder: recipe.output_folder %>
      </span>
    <% end %>
  </span>
<% end %>
