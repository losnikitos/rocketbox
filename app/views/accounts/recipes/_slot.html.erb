<%# locals: (collection:, tag:) %>
<span class="inline-flex items-center gap-1 rounded-full border border-ink-900/10 bg-white px-2 py-0.5 text-xs text-ink-700">
  <%= heroicon "folder", variant: :micro, options: { class: "size-3.5 text-sky-600", "aria-hidden": true } %>
  <span class="font-medium"><%= collection.humanize %></span>
  <%= heroicon "hashtag", variant: :micro, options: { class: "ml-1 size-3.5 text-ink-400", "aria-hidden": true } %>
  <%= tag&.name || "Unknown" %>
</span>
