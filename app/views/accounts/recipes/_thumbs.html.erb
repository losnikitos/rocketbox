<%# locals: (media:, examples: []) %>
<% if examples.any? || media.any? %>
  <ul class="flex flex-wrap gap-1.5 *:w-10 *:shrink-0">
    <% examples.each do |example| %>
      <li title="Example"><%= render "accounts/recipes/example", example:, css: "aspect-2/3 w-full rounded-md border border-ink-900/10 object-cover" %></li>
    <% end %>
    <% media.each do |item| %>
      <li>
        <%= link_to library_item_path(item), aria: { label: "Open #{item.kind}" }, class: "flex overflow-hidden rounded-md border border-ink-900/10 transition hover:border-ink-900/30" do %>
          <%= render "accounts/library/file", media: item, css: "aspect-2/3 w-full object-cover" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
