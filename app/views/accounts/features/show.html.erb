<% content_for(:title, "#{@feature.name} — Features — Rocketbox") %>

<div class="max-w-3xl space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Features", features_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= @feature.name %></span>
  </nav>

  <section class="rounded-2xl border border-ink-900/10 bg-white p-6">
    <%= form_with model: @setting, url: feature_path(@feature), method: :patch,
          html: { onchange: "this.requestSubmit()" }, class: "space-y-4" do |f| %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-base font-semibold text-ink-900"><%= @feature.name %></h1>
          <p class="mt-1 text-sm text-ink-500"><%= @feature.description %></p>
        </div>
        <label class="relative inline-flex shrink-0 cursor-pointer">
          <%= f.check_box :enabled, role: "switch", class: "peer sr-only", aria: { label: "#{@feature.name} on" } %>
          <span class="h-6 w-11 rounded-full bg-ink-900/15 transition peer-checked:bg-rocket peer-focus-visible:ring-2 peer-focus-visible:ring-rocket/30 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"></span>
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :recipe_id, "Background photo", class: tw_label_classes %>
          <%= f.select :recipe_id, Recipe.ordered.pluck(:name, :id), { include_blank: @setting.recipe_id ? false : "—" }, class: tw_input_classes %>
        </div>
        <div>
          <% if @feature.fixed_layer %>
            <p class="<%= tw_label_classes %>">Layer</p>
            <%= link_to Layer.find(@feature.layer).name, layer_path(@feature.layer), class: "text-sm text-ink-900 underline hover:text-ink-600" %>
          <% else %>
            <%= f.label :layer_slug, "Layer", class: tw_label_classes %>
            <%= f.select :layer_slug, Layer::ALL.map { [ it.name, it.slug ] }, {}, class: tw_input_classes %>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= button_to generate_feature_path(@feature), disabled: !@setting.enabled?,
          form: { class: "mt-4" }, class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" do %>
      <%= heroicon "square-3-stack-3d", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Compose draft now
    <% end %>
  </section>
</div>
