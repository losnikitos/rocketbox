<% content_for(:title, "#{@feature.name} — Features — Rocketbox") %>

<div class="max-w-3xl space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Features", features_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= @feature.name %></span>
  </nav>

  <section aria-labelledby="feature_settings" class="rounded-2xl border border-ink-900/10 bg-white p-6">
    <%= form_with model: @setting, url: feature_path(@feature), method: :patch,
          html: { onchange: "this.requestSubmit()" }, class: "space-y-4" do |f| %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 id="feature_settings" class="text-base font-semibold text-ink-900"><%= @feature.name %></h1>
          <p class="mt-1 text-sm text-ink-500"><%= @feature.description %></p>
        </div>
        <label class="relative inline-flex shrink-0 cursor-pointer">
          <%= f.check_box :enabled, role: "switch", class: "peer sr-only", aria: { label: "#{@feature.name} on" } %>
          <span class="h-6 w-11 rounded-full bg-ink-900/15 transition peer-checked:bg-rocket peer-focus-visible:ring-2 peer-focus-visible:ring-rocket/30 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"></span>
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <% if @feature.fixed_recipe_id %>
            <p class="<%= tw_label_classes %>">Background photo</p>
            <%= link_to @recipe&.name || "Recipe ##{@feature.fixed_recipe_id} missing", library_folders_path("photobank", "ready", recipe: @feature.fixed_recipe_id), class: "text-sm text-ink-900 underline hover:text-ink-600" %>
          <% else %>
            <%= f.label :recipe_id, "Background photo", class: tw_label_classes %>
            <%= f.select :recipe_id, Recipe.ordered.pluck(:name, :id), { include_blank: @setting.recipe_id ? false : "—" }, class: tw_input_classes %>
          <% end %>
        </div>
        <div>
          <% if @feature.fixed_layer %>
            <p class="<%= tw_label_classes %>">Layer</p>
            <%= link_to Layer.find(@feature.layer).name, layer_path(@feature.layer), class: "text-sm text-ink-900 underline hover:text-ink-600" %>
          <% else %>
            <%= f.label :layer_slug, "Layer", class: tw_label_classes %>
            <%= f.select :layer_slug, Layer::ALL.map { [ it.name, it.slug ] }, {}, class: tw_input_classes %>
          <% end %>
        </div>
      </div>
      <div>
        <p class="<%= tw_label_classes %>">Schedule</p>
        <p class="text-sm text-ink-900"><%= @feature.schedule %></p>
      </div>
    <% end %>
  </section>

  <section aria-labelledby="feature_stats" class="rounded-2xl border border-ink-900/10 bg-white p-6">
    <h2 id="feature_stats" class="text-sm font-semibold text-ink-900">Stats</h2>
    <% posts = @feature.posts(Current.account) %>
    <% stats = { "Posted" => posts.where(status: "published").count, "Drafts" => posts.where.not(status: "published").count,
                 "Photos left" => @feature.photo_backlog(Current.account).with_attached_file.count(&:story_image?) } %>
    <% stats["Reviews left"] = @feature.review_backlog(Current.account).count if @feature.reviews? %>
    <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <% stats.each do |label, count| %>
        <div>
          <dt class="text-sm text-ink-500"><%= label %></dt>
          <dd class="text-2xl font-semibold text-ink-900 tabular-nums"><%= count %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section aria-labelledby="feature_test_run" class="rounded-2xl border border-ink-900/10 bg-white p-6">
    <h2 id="feature_test_run" class="text-sm font-semibold text-ink-900">Test run</h2>
    <p class="mt-1 text-sm text-ink-500">Compose one draft from the photo<%= " and review" if @feature.reviews? %> you pick.</p>
    <%= form_with url: generate_feature_path(@feature), class: "mt-4 space-y-4" do |f| %>
      <div class="flex flex-wrap items-start gap-6">
        <fieldset data-controller="media-pick" class="group w-36">
          <legend class="<%= tw_label_classes %>">Photo</legend>
          <% if @photos.any? %>
            <% selected = @photos.sample %>
            <div class="space-y-2">
              <button type="button" popovertarget="feature-photo-pick" style="anchor-name: --feature-photo-pick" aria-label="Choose photo"
                      class="flex w-full cursor-pointer items-center justify-between gap-1 rounded-xl border border-ink-900/10 bg-white p-1.5 transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
                <span data-media-pick-target="preview" class="block size-24 shrink-0 overflow-hidden rounded-lg">
                  <%= render "accounts/library/file", media: selected, css: "aspect-square w-full object-cover" %>
                </span>
                <%= heroicon "chevron-down", options: { class: "size-5 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
              </button>
              <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light w-full justify-center gap-1.5 px-3 py-1.5">
                <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                Random
              </button>
            </div>
            <div id="feature-photo-pick" popover data-media-pick-target="popover" style="position-anchor: --feature-photo-pick"
                 class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-96 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-2 shadow-lg">
              <div class="grid grid-cols-4 gap-2">
                <% @photos.each do |media| %>
                  <label class="block cursor-pointer overflow-hidden rounded-lg border border-ink-900/15 transition hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                    <%= radio_button_tag :photo_id, media.id, media == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                    <%= render "accounts/library/file", media:, css: "aspect-square w-full object-cover" %>
                  </label>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
              <% if @recipe %>
                No <%= @recipe.name %> photos in Ready.
                <%= link_to "Make some", recipe_path(@recipe), class: "underline hover:text-ink-900" %>
              <% else %>
                Pick a background photo recipe above.
              <% end %>
            </p>
          <% end %>
        </fieldset>

        <% if @reviews %>
          <fieldset data-controller="media-pick" class="group w-64">
            <legend class="<%= tw_label_classes %>">Review</legend>
            <% if @reviews.any? %>
              <% selected = @reviews.sample %>
              <div class="space-y-2">
                <button type="button" popovertarget="feature-review-pick" style="anchor-name: --feature-review-pick" aria-label="Choose review"
                        class="flex w-full cursor-pointer items-center gap-1 rounded-xl border border-ink-900/10 bg-white px-2.5 py-1.5 text-left transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
                  <span data-media-pick-target="preview" class="min-w-0 flex-1">
                    <%= render "review_option", review: selected %>
                  </span>
                  <%= heroicon "chevron-down", options: { class: "size-5 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
                </button>
                <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light w-full justify-center gap-1.5 px-3 py-1.5">
                  <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                  Random
                </button>
              </div>
              <div id="feature-review-pick" popover data-media-pick-target="popover" style="position-anchor: --feature-review-pick"
                   class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-80 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-1 shadow-lg">
                <% @reviews.each do |review| %>
                  <label class="block cursor-pointer rounded-lg px-3 py-2 transition hover:bg-ink-900/5 has-checked:bg-rocket/10 has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                    <%= radio_button_tag :review_id, review.id, review == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                    <%= render "review_option", review: %>
                  </label>
                <% end %>
              </div>
            <% else %>
              <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
                No 5-star reviews with text yet.
                <%= link_to "See reviews", reviews_path, class: "underline hover:text-ink-900" %>
              </p>
            <% end %>
          </fieldset>
        <% end %>
      </div>

      <%= f.button disabled: @photos.empty? || @reviews&.none?,
            class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" do %>
        <%= heroicon "square-3-stack-3d", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Compose test draft
      <% end %>
    <% end %>
  </section>
</div>
