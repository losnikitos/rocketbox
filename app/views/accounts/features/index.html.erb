<% content_for(:title, "Features — Rocketbox") %>

<ul class="grid max-w-3xl gap-4">
  <% @features.each do |feature, setting| %>
    <li id="feature_<%= feature.slug.underscore %>">
      <%= link_to feature_path(feature), class: "flex items-start justify-between gap-4 rounded-2xl border border-ink-900/10 bg-white p-6 transition hover:border-ink-900/30" do %>
        <div>
          <h2 class="text-base font-semibold text-ink-900"><%= feature.name %></h2>
          <p class="mt-1 text-sm text-ink-500"><%= feature.description %></p>
        </div>
        <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= setting.enabled? ? "bg-rocket/10 text-rocket" : "bg-ink-900/5 text-ink-500" %>">
          <%= setting.enabled? ? "On" : "Off" %>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
