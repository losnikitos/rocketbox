<% content_for(:title, "Crawl — Rocketbox") %>

<div class="mx-auto max-w-3xl space-y-10">
  <section aria-labelledby="new-crawl-heading">
    <h2 id="new-crawl-heading" class="text-sm font-medium text-ink-900">Crawl a page</h2>
    <p class="mt-1 text-sm text-ink-500">Paste the business website, Google Maps listing, or booking page. We pull the business details, photos, and videos. Takes up to a couple of minutes.</p>

    <%= form_with model: @crawl, url: crawls_path, class: "mt-4 space-y-4" do |f| %>
      <% if @crawl.errors.any? %>
        <p class="<%= tw_alert_error_classes %>" role="alert"><%= @crawl.errors.full_messages.to_sentence %></p>
      <% end %>

      <div>
        <%= f.label :url, "URL", class: tw_label_classes %>
        <%= f.url_field :url, required: true, placeholder: "https://", class: tw_input_classes %>
      </div>

      <fieldset>
        <legend class="<%= tw_label_classes %>">Crawler</legend>
        <div class="mt-1 inline-flex gap-1 rounded-full bg-ink-900/5 p-1">
          <% Crawl::PROVIDERS.each do |key, label| %>
            <label class="cursor-pointer rounded-full px-3.5 py-1 text-sm font-medium text-ink-600 transition hover:text-ink-900 has-checked:bg-white has-checked:text-ink-900 has-checked:shadow-sm has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
              <%= f.radio_button :provider, key, class: "sr-only" %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <details class="group">
        <summary class="inline-flex cursor-pointer items-center gap-1 text-sm text-ink-600 hover:text-ink-900">
          <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
          Data instruction
        </summary>
        <%= f.text_area :data_instruction, rows: 12, required: true, "aria-label": "Data instruction", class: "#{tw_input_classes} mt-2 font-mono text-xs" %>
        <p class="mt-1 text-xs text-ink-500">Applies to this crawl only. The default lives in the admin under Prompts → <code>crawl_business</code>.</p>
      </details>

      <%= f.button type: :submit, class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm" do %>
        <%= heroicon "globe-alt", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Crawl
      <% end %>
    <% end %>
  </section>

  <% if @crawls.any? %>
    <section aria-labelledby="crawls-heading">
      <h2 id="crawls-heading" class="text-sm font-medium text-ink-900">History</h2>
      <ul class="mt-3 divide-y divide-ink-900/5 rounded-lg border border-ink-900/10 bg-white">
        <% @crawls.each do |crawl| %>
          <li>
            <%= link_to crawl_path(crawl), class: "flex items-center justify-between gap-3 px-4 py-3 transition hover:bg-ink-900/3" do %>
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-ink-900">
                  <%= crawl.title %>
                </p>
                <p class="truncate text-xs text-ink-500">
                  <%= Crawl::PROVIDERS[crawl.provider] %> · <%= time_ago_in_words(crawl.created_at) %> ago · <%= crawl.url %>
                </p>
              </div>
              <%= render "accounts/crawls/status", crawl: crawl %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
