<%# locals: (post:, preset:, renders:) %>
<%= form_with model: post, url: (post.persisted? ? post_path(post) : posts_path), class: "rb-surface-raised space-y-4 p-4" do |f| %>
  <h2 class="text-sm font-semibold text-ink-900"><%= post.persisted? ? "Settings" : "New post" %></h2>

  <div class="space-y-2">
    <%= f.label :preset_slug, "Preset", class: "text-xs font-medium text-ink-500" %>
    <%= f.select :preset_slug,
          Preset::ALL.map { [ "#{it.name} (#{it.slug})", it.slug ] },
          {},
          class: "block w-full rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm" %>
  </div>

  <div class="space-y-2">
    <span class="text-xs font-medium text-ink-500">Source image</span>
    <%= render "shared/media_bank_pick", name: "post[source]", selected: post.source, label: "Source image" %>
  </div>

  <%
    rule_options = preset.overlays.map { [ "##{it.number} · #{it.text}", it.number ] }
    rule_icon = "cursor-pointer rounded-lg p-1 text-ink-500 hover:bg-ink-900/5 hover:text-ink-900"
  %>
  <fieldset class="space-y-2" data-controller="rules-list">
    <legend class="text-xs font-medium text-ink-500">Rules</legend>
    <div data-rules-list-target="list" class="space-y-2">
      <% post.rules_list.each do |number| %>
        <%= render "accounts/posts/rule_row", options: rule_options, selected: number, icon_btn: rule_icon %>
      <% end %>
    </div>
    <template data-rules-list-target="template">
      <%= render "accounts/posts/rule_row", options: rule_options, selected: rule_options.dig(0, 1), icon_btn: rule_icon %>
    </template>
    <button type="button" data-action="rules-list#add"
          class="rb-btn-ghost-on-light gap-1 px-2.5 py-1 text-xs">
      <%= heroicon "plus", variant: :mini, options: { class: "size-3.5", "aria-hidden": true } %>
      Add rule
    </button>
  </fieldset>

  <div class="space-y-1 border-t border-ink-900/10 pt-3 text-xs text-ink-500">
    <p>Transition: <%= preset.transition_label %></p>
    <p>CTA: <%= preset.cta_text %> → <code class="font-mono"><%= preset.cta_href %></code></p>
  </div>

  <%= f.submit post.persisted? ? "Save" : "Create post",
        class: "rb-btn-primary w-full justify-center px-3.5 py-2 text-sm cursor-pointer" %>
<% end %>

<% if post.persisted? %>
  <div class="rb-surface-raised space-y-3 p-4">
    <h2 class="text-sm font-semibold text-ink-900">Render</h2>
    <p class="text-xs text-ink-500">Builds an MP4 with <%= preset.transition_label %> transitions.</p>
    <%= button_to "Render video", render_post_path(post),
          method: :post, class: "rb-btn-primary w-full justify-center px-3.5 py-2 text-sm cursor-pointer" %>

    <% latest = Array(renders) %>
    <% if latest.any? %>
      <ul class="space-y-2">
        <% latest.first(5).each do |row| %>
          <li class="flex items-center justify-between gap-2 text-sm">
            <span class="text-ink-600">
              <span class="capitalize"><%= row.status %></span>
              <span class="text-xs text-ink-400"><%= time_ago_in_words(row.created_at) %> ago</span>
            </span>
            <% if row.done? && row.file.attached? %>
              <%= link_to "Download", post_render_path(row), class: "font-medium text-rocket hover:underline" %>
            <% elsif row.failed? %>
              <span class="text-xs text-signal-red" title="<%= row.error %>"><%= row.error.to_s.truncate(40) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
