<% content_for(:title, "Create Instagram post — Rocketbox") %>

<h2 class="font-manrope text-lg font-bold text-ink-900">Create Instagram post</h2>
<p class="mt-2 text-sm text-ink-600">Pick a recipe. We’ll turn your selected images into a post, story, or reel.</p>

<div class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5">
  <% @selected_media.each do |media| %>
    <div class="min-w-0">
      <% if media.file.attached? %>
        <%= image_tag url_for(media.file), alt: media.kind, class: "aspect-2/3 w-full rounded-lg object-cover" %>
      <% else %>
        <div class="flex aspect-2/3 items-center justify-center rounded-lg bg-ink-900/5 text-xs text-ink-500">Missing</div>
      <% end %>
    </div>
  <% end %>
</div>

<%= form_with url: instagram_posts_path, method: :post, class: "mt-8 max-w-xl space-y-5" do %>
  <% @selected_media.each do |media| %>
    <%= hidden_field_tag "library_media_ids[]", media.id %>
  <% end %>

  <div>
    <label for="recipe_id" class="block text-sm font-medium text-ink-900">Recipe</label>
    <%= select_tag :recipe_id,
          options_for_select(@recipes.map { [ "#{it.name} (#{[ it.format&.humanize, (pluralize(it.input_count, "image") if it.input_count) ].compact.join(", ")})", it.id ] }, params[:recipe_id]),
          include_blank: "Choose a recipe…",
          class: "mt-1.5 w-full rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-900",
          required: true %>
    <% if Current.user.admin? %>
      <p class="mt-2 text-xs text-ink-500"><%= link_to "Manage recipes", recipes_path, class: "underline underline-offset-2 hover:text-ink-900" %></p>
    <% end %>
  </div>

  <div>
    <label for="caption" class="block text-sm font-medium text-ink-900">Caption <span class="font-normal text-ink-500">(optional)</span></label>
    <%= text_area_tag :caption, params[:caption], rows: 3, class: "mt-1.5 w-full rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-900", placeholder: "Caption used when you publish…" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= submit_tag "Create draft & generate", class: "rb-btn-primary px-4 py-2 text-sm" %>
    <%= link_to "Back to uploads", library_uploads_path, class: "rb-btn-ghost-on-light px-4 py-2 text-sm" %>
  </div>
<% end %>
