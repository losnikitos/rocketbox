<% content_for(:title, "#{@post.prompt.name} — Posts — Rocketbox") %>

<% if @post.generating? || (@post.draft? && !@post.generated_video.attached?) %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<% status_pill_class = smm_post_status_pill_class(@post.status) %>

<div class="flex items-start justify-between gap-4">
  <div class="min-w-0">
    <p class="text-sm text-ink-500">
      <%= link_to "Posts", smm_posts_path, class: "underline underline-offset-2" %>
      <span class="mx-1">/</span>
      Draft
    </p>
    <% if @post.published_at.present? %>
      <p class="mt-2 text-sm text-ink-600">Published <%= l(@post.published_at, format: :short) %></p>
    <% end %>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium capitalize <%= status_pill_class %>">
      <%= @post.status %>
    </span>
    <%= render "shared/admin_links/smm_post", smm_post: @post %>
  </div>
</div>

<% if @post.error_message.present? %>
  <p class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800"><%= @post.error_message %></p>
<% end %>

<div class="mt-6 space-y-6">
  <div class="w-full max-w-md rounded-2xl border border-ink-900/10 bg-white p-3">
    <div class="flex flex-wrap gap-2">
      <% @post.library_media.each do |media| %>
        <% if media.file.attached? %>
          <div class="relative shrink-0">
            <%= image_tag url_for(media.file),
                  alt: media.kind,
                  class: "h-20 aspect-2/3 rounded-lg object-cover" %>
            <div class="pointer-events-none absolute inset-0 rounded-lg ring-1 ring-inset ring-ink-900/10" aria-hidden="true"></div>
          </div>
        <% end %>
      <% end %>
    </div>
    <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-ink-700"><%= @post.prompt.body %></p>
  </div>

  <div class="w-full max-w-md">
    <% if @post.generated_video.attached? %>
      <div data-controller="post-reaction"
           data-post-reaction-url-value="<%= react_smm_post_path(@post) %>"
           data-post-reaction-reaction-value="<%= @post.reaction %>">
        <div class="group relative" data-controller="video-preview">
          <%= video_tag url_for(@post.generated_video),
                muted: true,
                loop: true,
                preload: "metadata",
                playsinline: true,
                class: "aspect-2/3 w-full rounded-lg bg-ink-900/5 object-cover",
                data: { video_preview_target: "video" } %>
          <button type="button"
                  class="absolute inset-0 z-10 flex cursor-pointer items-center justify-center"
                  data-video-preview-target="button"
                  data-action="click->video-preview#toggle"
                  aria-label="Play video">
            <span class="flex size-10 items-center justify-center rounded-full bg-black/45 text-white group-data-[playing]:hidden">
              <%= heroicon "play", options: { class: "size-5 translate-x-px" } %>
            </span>
            <span class="hidden size-10 items-center justify-center rounded-full bg-black/45 text-white opacity-0 group-data-[playing]:flex group-data-[playing]:group-hover:opacity-100">
              <%= heroicon "pause", options: { class: "size-5" } %>
            </span>
          </button>
        </div>

        <div class="mt-1 flex justify-end gap-0.5">
          <button type="button"
                  class="rounded-md p-1 text-ink-400 transition-colors hover:bg-ink-900/5 aria-pressed:text-signal-green"
                  data-post-reaction-target="up"
                  data-action="click->post-reaction#up"
                  aria-label="Thumbs up"
                  aria-pressed="false">
            <%= heroicon "hand-thumb-up", variant: :micro, options: { class: "size-4" } %>
          </button>
          <button type="button"
                  class="rounded-md p-1 text-ink-400 transition-colors hover:bg-ink-900/5 aria-pressed:text-signal-red"
                  data-post-reaction-target="down"
                  data-action="click->post-reaction#down"
                  aria-label="Thumbs down"
                  aria-pressed="false">
            <%= heroicon "hand-thumb-down", variant: :micro, options: { class: "size-4" } %>
          </button>
        </div>

        <form class="mt-3 space-y-2"
              data-post-reaction-target="comment"
              data-action="submit->post-reaction#submitComment"
              <%= "hidden" unless @post.reaction == "down" %>>
          <label for="reaction_comment" class="sr-only">What went wrong? (optional)</label>
          <textarea id="reaction_comment"
                    rows="3"
                    placeholder="What went wrong? (optional)"
                    data-post-reaction-target="commentField"
                    class="w-full rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-900"><%= @post.reaction_comment %></textarea>
          <button type="submit" class="rb-btn-ghost-on-light px-3 py-1.5 text-xs">Save comment</button>
        </form>
      </div>
    <% elsif @post.generating? || @post.draft? %>
      <div class="flex aspect-2/3 items-center justify-center rounded-lg bg-stone-50 px-3 text-center text-sm text-ink-600">
        Generating with AI…
      </div>
    <% elsif @post.failed? %>
      <div class="flex aspect-2/3 items-center justify-center rounded-lg bg-stone-50 px-3 text-center text-sm text-ink-600">
        Generation failed. Create a new draft from uploads to try again.
      </div>
    <% else %>
      <div class="flex aspect-2/3 items-center justify-center rounded-lg bg-stone-50 px-3 text-center text-sm text-ink-600">
        No video yet.
      </div>
    <% end %>
  </div>
</div>

<% if @post.caption.present? %>
  <div class="mt-8">
    <h3 class="text-sm font-medium text-ink-900">Caption</h3>
    <p class="mt-2 whitespace-pre-wrap text-sm text-ink-700"><%= @post.caption %></p>
  </div>
<% end %>

<% if @post.publishable? %>
  <div class="mt-8">
    <%= button_to "Looks good — publish to Instagram",
          publish_smm_post_path(@post),
          method: :post,
          class: "rb-btn-primary px-4 py-2 text-sm" %>
  </div>
<% end %>
