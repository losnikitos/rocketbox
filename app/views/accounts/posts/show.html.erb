<% content_for(:title, "#{@preset.name} — Posts — Rocketbox") %>
<% content_for(:fit, "true") %>
<% scenes = @post.scenes %>
<%# Filmstrip is always 9:16 reel; design canvas 1080×1920 → preview 360×640 (⅓). %>
<% width, height = 1080, 1920 %>
<% frame_w, frame_h = 360, 640 %>
<% scale = frame_h.to_f / height %>

<% content_for(:breadcrumbs) do %>
  <%= link_to posts_path, class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
    <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Posts
  <% end %>
  <span class="text-sm text-ink-400">/</span>
  <span class="text-sm text-ink-700" aria-current="page"><%= @preset.name %></span>
<% end %>

<% content_for(:header_actions) do %>
  <%= button_to post_path(@post), method: :delete,
        form: { data: { turbo_confirm: "Delete this post?" } },
        class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm text-signal-red hover:text-signal-red" do %>
    <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Delete
  <% end %>
<% end %>

<div class="flex min-h-0 min-w-0 flex-1 flex-col md:m-2">
  <ol class="flex min-h-0 flex-1 items-center gap-3 overflow-x-auto p-3 md:p-4"
      aria-label="Scenes">
    <% scenes.each_with_index do |scene, i| %>
      <li class="flex shrink-0 flex-col" style="width: <%= frame_w %>px">
        <%= link_to post_path(@post, scene: scene.slug),
              aria: { selected: params[:scene] == scene.slug, label: "#{i + 1}. #{scene.label}" },
              class: "block overflow-hidden rounded-lg bg-white ring-2 ring-transparent aria-selected:ring-rocket focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket",
              style: "width: #{frame_w}px; height: #{frame_h}px" do %>
          <div class="origin-top-left"
               style="width: <%= width %>px; height: <%= height %>px; transform: scale(<%= scale %>)">
            <%= render "accounts/posts/scene", scene:, preset: @preset %>
          </div>
        <% end %>
        <p class="mt-1.5 text-center text-[10px] leading-tight font-medium text-ink-700"
           title="<%= scene.label %>">
          <%= i + 1 %>. <%= scene.label %>
        </p>
      </li>
    <% end %>
  </ol>
</div>

<% content_for(:aside) do %>
  <%= render "accounts/posts/form", post: @post, preset: @preset, renders: @renders %>
<% end %>
