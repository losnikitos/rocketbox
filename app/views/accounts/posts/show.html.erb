<% content_for(:title, "#{@post.format.humanize} — Posts — Rocketbox") %>

<% status_pill_class = smm_post_status_pill_class(@post.status) %>

<%= turbo_stream_from @post if @post.generating? %>

<div class="flex items-start justify-between gap-4">
  <div class="min-w-0">
    <p class="text-sm text-ink-500">
      <%= link_to "Posts", instagram_posts_path, class: "underline underline-offset-2" %>
      <span class="mx-1">/</span>
      <%= @post.format.humanize %>
    </p>
    <% if @post.published_at.present? %>
      <p class="mt-2 text-sm text-ink-600">Published <%= l(@post.published_at, format: :short) %></p>
    <% end %>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <span class="rounded-full bg-ink-900/5 px-2.5 py-0.5 text-xs font-medium capitalize text-ink-700">
      <%= @post.carousel? ? "Carousel" : @post.format %>
    </span>
    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium capitalize <%= status_pill_class %>">
      <%= @post.status %>
    </span>
    <%= render "shared/admin_links/smm_post", smm_post: @post %>
  </div>
</div>

<% if @post.error_message.present? %>
  <p class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800"><%= @post.error_message %></p>
<% end %>

<div class="mt-6 flex flex-col gap-6 md:flex-row">
  <div class="min-w-0 flex-1 space-y-8">
    <% if @post.smm_slides.any? %>
      <div data-controller="post-reaction"
           data-post-reaction-url-value="<%= react_instagram_post_path(@post) %>"
           data-post-reaction-reaction-value="<%= @post.reaction %>">
        <%= render "accounts/posts/slides", post: @post %>

        <div class="mt-1 flex max-w-md gap-0.5">
          <button type="button"
                  class="rounded-md p-1 text-ink-400 transition-colors hover:bg-ink-900/5 aria-pressed:text-signal-green"
                  data-post-reaction-target="up"
                  data-action="click->post-reaction#up"
                  aria-label="Thumbs up"
                  aria-pressed="false">
            <%= heroicon "hand-thumb-up", variant: :micro, options: { class: "size-4" } %>
          </button>
          <button type="button"
                  class="rounded-md p-1 text-ink-400 transition-colors hover:bg-ink-900/5 aria-pressed:text-signal-red"
                  data-post-reaction-target="down"
                  data-action="click->post-reaction#down"
                  aria-label="Thumbs down"
                  aria-pressed="false">
            <%= heroicon "hand-thumb-down", variant: :micro, options: { class: "size-4" } %>
          </button>
        </div>

        <form class="mt-3 max-w-md space-y-2"
              data-post-reaction-target="comment"
              data-action="submit->post-reaction#submitComment"
              <%= "hidden" unless @post.reaction == "down" %>>
          <label for="reaction_comment" class="sr-only">What went wrong? (optional)</label>
          <textarea id="reaction_comment"
                    rows="3"
                    placeholder="What went wrong? (optional)"
                    data-post-reaction-target="commentField"
                    class="w-full rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-900"><%= @post.reaction_comment %></textarea>
          <button type="submit" class="rb-btn-ghost-on-light px-3 py-1.5 text-xs">Save comment</button>
        </form>
      </div>
    <% elsif @post.generating? || @post.draft? %>
      <div class="flex aspect-9/16 w-64 items-center justify-center rounded-lg bg-stone-50 px-3 text-center text-sm text-ink-600">
        Generating with AI…
      </div>
    <% end %>

    <% if @post.caption.present? %>
      <div>
        <h3 class="text-sm font-medium text-ink-900">Caption</h3>
        <p class="mt-2 whitespace-pre-wrap text-sm text-ink-700"><%= @post.caption %></p>
      </div>
    <% end %>

    <% if @post.publishable? %>
      <div>
        <%= button_to "Looks good — publish to Instagram",
              publish_instagram_post_path(@post),
              method: :post,
              class: "rb-btn-primary px-4 py-2 text-sm" %>
      </div>
    <% end %>
  </div>

  <% if Current.user.admin? && (@post.recipe || @post.prompt) %>
    <aside id="generation" class="w-full shrink-0 space-y-6 rounded-2xl border border-ink-900/10 bg-stone-50 p-6 md:w-96 lg:w-108" aria-labelledby="generation-heading">
      <h2 id="generation-heading" class="text-sm font-medium text-ink-900">Generation</h2>

      <%= render "accounts/generations/options", record: @post, rows: [
            [ "Recipe", @post.recipe ? link_to(@post.recipe.name, edit_recipe_path(@post.recipe), class: "underline hover:text-ink-600") : "Deleted" ],
            [ "Shot", @post.shot && link_to(@post.shot.name, edit_shot_path(@post.shot), class: "underline hover:text-ink-600") ]
          ] %>

      <% if @post.library_media.any? %>
        <section aria-labelledby="generation-photos-heading">
          <h3 id="generation-photos-heading" class="text-sm text-ink-500">Photos</h3>
          <ul class="mt-2 flex flex-wrap gap-2">
            <% @post.library_media.each do |media| %>
              <li>
                <%= link_to library_item_path(media), title: media.media_type&.name,
                      class: "block rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                  <%= render "accounts/library/file", media:, css: "aspect-2/3 w-16 rounded-md object-cover" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @post.prompt.present? %>
        <section>
          <label for="generation-prompt" class="text-sm text-ink-500">Prompt</label>
          <textarea id="generation-prompt" readonly rows="6"
                    class="mt-1 block w-full resize-y rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-700"><%= @post.prompt %></textarea>
        </section>
      <% end %>
    </aside>
  <% end %>
</div>
