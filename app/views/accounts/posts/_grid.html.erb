<%# locals: (posts:) %>
<div class="mt-6 space-y-8">
  <% posts.group_by { |post| post.created_at.to_date }.each do |day, items| %>
    <section>
      <h3 class="mb-3 text-sm font-medium text-ink-900"><%= upload_day_label(day) %></h3>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        <% items.each do |post| %>
          <li class="group relative min-w-0">
            <%= link_to smm_post_path(post), class: "relative block" do %>
              <% if post.generated_video.attached? %>
                <%= video_tag url_for(post.generated_video),
                      muted: true,
                      preload: "metadata",
                      playsinline: true,
                      class: "aspect-2/3 w-full rounded-lg bg-ink-900/5 object-cover" %>
              <% elsif (cover = post.library_media.find { |m| m.file.attached? }) %>
                <%= image_tag url_for(cover.file), alt: "", class: "aspect-2/3 w-full rounded-lg object-cover" %>
              <% else %>
                <div class="flex aspect-2/3 items-center justify-center rounded-lg bg-ink-900/5 text-xs text-ink-500">
                  <%= post.status %>
                </div>
              <% end %>
              <span class="absolute left-2 top-2 rounded-full bg-white/90 px-2 py-0.5 text-xs font-medium capitalize shadow-sm <%= smm_post_status_text_class(post.status) %>">
                <%= post.status %>
              </span>
            <% end %>
            <div class="absolute right-1 top-1 z-10 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
              <%= render "shared/admin_links/smm_post", smm_post: post %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
