<%# Standalone document: inlined CSS so headless Chrome needs no asset server or session. %>
<%# data_url true embeds image bytes for Ferrum; false uses public/blob paths in the preview iframe. %>
<%
  data_url = local_assigns.fetch(:data_url, false)
  board = @storyboard || @post.storyboard
  bg = board.background_for(@scene, data_url: data_url)
  from_bg = @scene.from && (data_url ? Storyboard.image_data_url(@scene.from) : Storyboard.preview_url(@scene.from))
  to_bg = @scene.to && (data_url ? Storyboard.image_data_url(@scene.to) : Storyboard.preview_url(@scene.to))
  body_style = bg && !@scene.transition? ? "background-image: url(#{bg})" : nil
%>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style><%= raw Rails.application.assets.load_path.find("tailwind.css").content(encoding: "UTF-8") %></style>
  </head>
  <body class="overflow-hidden bg-ink-900 bg-cover bg-center" <%= tag.attributes(style: body_style) %>>
    <%= render board.template_for(@scene), scene: @scene, from_bg: from_bg, to_bg: to_bg %>
  </body>
</html>
