<%# Standalone document: inlined CSS so headless Chrome needs no asset server or session. %>
<%# data_url true embeds image bytes for Ferrum; false uses blob paths in Studio. %>
<%
  data_url = local_assigns.fetch(:data_url, false)
  preset = @preset || @post.preset
%>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style><%= raw Rails.application.assets.load_path.find("tailwind.css").content(encoding: "UTF-8") %></style>
  </head>
  <body class="h-screen w-screen overflow-hidden">
    <%= render "accounts/posts/scene", scene: @scene, preset:, data_url: %>
  </body>
</html>
