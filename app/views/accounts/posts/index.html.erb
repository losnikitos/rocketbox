<% content_for(:title, "Posts — Rocketbox") %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="font-manrope text-lg font-bold text-ink-900">Posts</h2>
    <p class="mt-2 text-sm text-ink-600">Draft Instagram posts generated from your library.</p>
  </div>
  <%= link_to "Select media in uploads", library_uploads_path, class: "text-sm font-medium text-ink-900 underline underline-offset-2" %>
</div>

<% if @posts.present? %>
  <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    <% @posts.each do |post| %>
      <li class="min-w-0">
        <% if post.generated_video.attached? %>
          <div class="group relative" data-controller="video-preview">
            <%= video_tag url_for(post.generated_video),
                  muted: true,
                  loop: true,
                  preload: "metadata",
                  playsinline: true,
                  class: "aspect-[9/16] w-full object-cover bg-ink-900/5",
                  data: { video_preview_target: "video" } %>
            <button type="button"
                    class="absolute inset-0 z-10 flex cursor-pointer items-center justify-center"
                    data-video-preview-target="button"
                    data-action="click->video-preview#toggle"
                    aria-label="Play video">
              <span class="flex size-10 items-center justify-center rounded-full bg-black/45 text-white group-data-[playing]:hidden">
                <%= heroicon "play", options: { class: "size-5 translate-x-px" } %>
              </span>
              <span class="hidden size-10 items-center justify-center rounded-full bg-black/45 text-white opacity-0 group-data-[playing]:flex group-data-[playing]:group-hover:opacity-100">
                <%= heroicon "pause", options: { class: "size-5" } %>
              </span>
            </button>
          </div>
          <%= link_to smm_post_path(post), class: "mt-2 block text-xs text-ink-500" do %>
            <%= post.prompt.name %> · <%= post.status %> · <%= l(post.created_at, format: :short) %>
          <% end %>
        <% else %>
          <%= link_to smm_post_path(post), class: "block" do %>
            <% if (cover = post.library_media.find { |m| m.file.attached? }) %>
              <%= image_tag url_for(cover.file), alt: "", class: "aspect-[9/16] w-full object-cover" %>
            <% else %>
              <div class="flex aspect-[9/16] items-center justify-center bg-ink-900/5 text-xs text-ink-500">
                <%= post.status %>
              </div>
            <% end %>
            <p class="mt-2 text-xs text-ink-500">
              <%= post.prompt.name %> · <%= post.status %> · <%= l(post.created_at, format: :short) %>
            </p>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-6 text-sm text-ink-600">
    No posts yet. <%= link_to "Select images in uploads", library_uploads_path, class: "font-medium text-ink-900 underline underline-offset-2" %> to create a draft.
  </p>
<% end %>
