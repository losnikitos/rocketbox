<% content_for(:title, "Posts — Rocketbox") %>

<% content_for(:header_actions) do %>
  <%= link_to new_post_path, class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm" do %>
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    New post
  <% end %>
<% end %>

<ul class="flex flex-wrap gap-3">
  <% @posts.each do |post| %>
    <% preset = post.preset %>
    <% thumbs = post.scenes.select(&:still?).filter_map { Preset.preview_url(it.image) } %>
    <li>
      <%= link_to post_path(post), class: "block rounded-2xl border border-ink-900/10 bg-white p-3",
            aria: { label: preset.name } do %>
        <span class="flex gap-2">
          <% if thumbs.any? %>
            <% thumbs.each do |url| %>
              <span class="h-72 shrink-0 overflow-hidden rounded-lg bg-cover bg-center"
                    style="aspect-ratio: <%= preset.size.join(" / ") %>; background-image: url(<%= url %>)"
                    aria-hidden="true"></span>
            <% end %>
          <% else %>
            <span class="h-72 shrink-0 rounded-lg bg-ink-100" style="aspect-ratio: <%= preset.size.join(" / ") %>" aria-hidden="true"></span>
          <% end %>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>
