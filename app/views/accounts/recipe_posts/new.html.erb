<% content_for(:title, "#{@recipe.name} — Recipes — Rocketbox") %>

<div class="max-w-4xl space-y-6">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Recipes", recipes_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= @recipe.name %></span>
  </nav>

  <section class="space-y-1 rounded-2xl border border-ink-900/10 bg-white p-6">
    <div class="flex items-center gap-2">
      <h2 class="text-sm font-semibold text-ink-900"><%= @recipe.name %></h2>
      <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= @recipe.format %></span>
    </div>
    <p class="line-clamp-10 text-sm text-ink-600"><%= @recipe.body %></p>
  </section>

  <%= form_with url: recipe_posts_path(@recipe), class: "space-y-6" do |f| %>
    <% if @error %>
      <p class="<%= tw_alert_error_classes %>" role="alert"><%= @error %></p>
    <% end %>

    <% @slots.each_with_index do |(type, photos), index| %>
      <fieldset data-controller="media-pick">
        <legend class="<%= tw_label_classes %>"><%= index + 1 %>. <%= type&.name || "Unknown media type" %></legend>
        <% if photos.any? %>
          <% selected = photos.find { it.id.to_s == params.dig(:media_ids, index.to_s) } || photos.first %>
          <% popover_id = "media-pick-#{index}" %>
          <div class="flex items-center gap-2">
            <button type="button" popovertarget="<%= popover_id %>" style="anchor-name: --<%= popover_id %>"
                    aria-label="Choose <%= type&.name&.downcase || "media" %>"
                    class="flex w-full max-w-md cursor-pointer items-center gap-4 rounded-2xl border border-ink-900/10 bg-white p-3 text-left text-sm text-ink-600 transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
              <span data-media-pick-target="preview" class="block size-24 shrink-0 overflow-hidden rounded-lg">
                <%= render "accounts/library/file", media: selected, css: "aspect-square w-full object-cover" %>
              </span>
              <span class="flex-1"><%= pluralize(photos.size, "photo") %></span>
              <%= heroicon "chevron-right", options: { class: "size-5 text-ink-400", "aria-hidden": true } %>
            </button>
            <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light gap-1.5 px-3 py-1.5">
              <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              Random
            </button>
          </div>
          <div id="<%= popover_id %>" popover data-media-pick-target="popover"
               style="position-anchor: --<%= popover_id %>"
               class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-[anchor-size(width)] overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-2 shadow-lg">
            <div class="grid grid-cols-4 gap-2">
              <% photos.each do |media| %>
                <label class="block cursor-pointer overflow-hidden rounded-lg border border-ink-900/15 transition hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                  <%= radio_button_tag "media_ids[#{index}]", media.id, media == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                  <%= render "accounts/library/file", media:, css: "aspect-square w-full object-cover" %>
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
            No <%= type&.name&.downcase || "matching" %> photos in the photobank.
            <%= link_to "Add some", library_photobank_path(type: type&.slug), class: "underline hover:text-ink-900" %>
          </p>
        <% end %>
      </fieldset>
    <% end %>

    <div class="max-w-md">
      <%= render "shared/generation_options", record: @post, scope: "smm_post", refresh_url: new_recipe_post_path(@recipe) %>
    </div>

    <%= f.button class: "rb-btn-primary gap-1.5 px-3.5 py-2 text-sm" do %>
      <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Generate
    <% end %>
  <% end %>
</div>
