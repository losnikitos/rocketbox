<% account = Current.account %>
<% labels = { business_name: "Business name", name: "Person name", phone: "Phone", address: "Address", homepage_url: "Website", business_description: "Description" } %>

<section class="rounded-lg border border-ink-900/10 bg-white p-4" aria-labelledby="business-card-heading">
  <div class="flex items-center justify-between gap-2">
    <h2 id="business-card-heading" class="text-sm font-medium text-ink-900">Business card</h2>
    <% if media.extraction_status %>
      <%= button_to extract_library_media_path(media), class: "inline-flex items-center gap-1 text-xs text-ink-500 hover:text-ink-900" do %>
        <%= heroicon "arrow-path", variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
        Re-extract
      <% end %>
    <% end %>
  </div>

  <% case media.extraction_status %>
  <% when nil %>
    <p class="mt-1 text-sm text-ink-500">Read the details off this card and fill in your business profile.</p>
    <%= button_to extract_library_media_path(media), class: "rb-btn-primary mt-3 gap-1.5 px-3.5 py-1.5 text-sm" do %>
      <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Extract info
    <% end %>

  <% when "pending" %>
    <% content_for :head do %>
      <meta http-equiv="refresh" content="5">
    <% end %>
    <p class="mt-3 flex items-center gap-2 text-sm text-ink-600" role="status">
      <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4 animate-spin", "aria-hidden": true } %>
      Reading the card…
    </p>

  <% when "failed" %>
    <p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">
      Couldn’t read the card: <%= media.extracted_info["error"] %>
    </p>

  <% when "done" %>
    <% extracted = media.extracted_account_attributes %>
    <% changed = extracted.reject { |column, value| account[column].to_s.strip == value } %>
    <% new_logo = media.extracted_logo.attached? %>
    <% logo_changed = new_logo && media.extracted_logo.checksum != account.logo.attachment&.checksum %>
    <% up_to_date = changed.empty? && !logo_changed %>

    <% if extracted.empty? && !new_logo %>
      <p class="mt-3 text-sm text-ink-500">Nothing readable was found on this card.</p>
    <% else %>
      <dl class="mt-3 divide-y divide-ink-900/5 font-mono text-xs">
        <% extracted.each do |column, value| %>
          <div class="py-2">
            <dt class="mb-1 font-sans text-ink-500"><%= labels.fetch(column) %></dt>
            <%= render "shared/field_diff", current: account[column], value: value, source: "From card" %>
          </div>
        <% end %>

        <% if new_logo %>
          <div class="py-2">
            <dt class="mb-1 font-sans text-ink-500">Logo</dt>
            <dd class="flex items-center gap-3">
              <% if logo_changed %>
                <% if account.logo.attached? %>
                  <%= image_tag url_for(account.logo), alt: "Current logo",
                        class: "size-16 rounded-lg object-contain opacity-60 ring-2 ring-red-200" %>
                <% else %>
                  <span class="flex size-16 items-center justify-center rounded-lg bg-red-50 font-sans text-xs italic text-red-800/60 ring-2 ring-red-200">Not set</span>
                <% end %>
                <%= heroicon "arrow-right", variant: :mini, options: { class: "size-4 text-ink-400", "aria-hidden": true } %>
                <%= image_tag url_for(media.extracted_logo), alt: "Logo from card",
                      class: "size-16 rounded-lg bg-white object-contain ring-2 ring-green-300" %>
              <% else %>
                <%= image_tag url_for(media.extracted_logo), alt: "Logo from card (unchanged)",
                      class: "size-16 rounded-lg bg-white object-contain ring-1 ring-ink-900/10" %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <%= button_to apply_extraction_library_media_path(media), method: :patch,
            disabled: up_to_date,
            class: "rb-btn-primary mt-4 gap-1.5 px-3.5 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" do %>
        <%= heroicon "check", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        <%= up_to_date ? "Business is up to date" : "Apply to business" %>
      <% end %>
    <% end %>
  <% end %>
</section>
