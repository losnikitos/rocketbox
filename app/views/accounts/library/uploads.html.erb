<% content_for(:title, "#{@collection.humanize} — Rocketbox") %>

<%= form_with url: library_media_index_path, multipart: true, class: "hidden",
      data: { controller: "drop-upload" } do %>
  <%= hidden_field_tag :collection, @collection %>
  <%= hidden_field_tag :source_id, nil, data: { drop_upload_target: "source" } %>
  <%= file_field_tag "files[]",
        multiple: true,
        accept: "image/*,video/*",
        id: "library-upload-input",
        data: { drop_upload_target: "input", action: "change->drop-upload#changed" } %>
<% end %>

<% if @review_media %>
  <%= render "accounts/library/review_media", attachments: @review_media %>
<% else %>
<div data-controller="library-select">
  <% if @library_media.present? %>
    <ul class="@container flex flex-wrap items-start gap-3 [--cols:3] sm:[--cols:4] lg:[--cols:5] xl:[--cols:6] 2xl:[--cols:8]">
      <% @library_media.group_by { it.origin&.source_media || it }.each do |source, group| %>
        <% generated = group.first.origin %>
        <%= tag.li class: "min-w-0 max-w-full rounded-xl border-2 border-stone-200 bg-white p-2 data-drop-over:border-rocket", aria: { label: ("Generated from one source" if generated) }, data: { source_id: source.id } do %>
          <% if generated %>
            <%= link_to library_item_path(source), class: "mb-2 flex items-center gap-2 text-xs font-medium text-ink-600 hover:text-ink-900" do %>
              <%= render "accounts/library/file", media: source, css: "size-6 rounded object-cover" %>
              Source
            <% end %>
          <% else %>
            <div class="mb-2 h-6" aria-hidden="true"></div>
          <% end %>
          <ul class="flex flex-wrap gap-2 *:w-[calc((100cqw_-_(var(--cols)_-_1)_*_0.75rem)_/_var(--cols)_-_1.25rem)]">
            <%= render partial: "accounts/library/tile", collection: generated ? group : [source], as: :media %>
          </ul>
        <% end %>
      <% end %>
    </ul>

    <div
      class="sticky bottom-4 z-20 mt-6 hidden flex-col gap-3 rounded-xl border border-ink-900/10 bg-white/95 p-3 shadow-lg backdrop-blur data-[open]:flex sm:data-[open]:flex-row sm:data-[open]:items-center sm:data-[open]:justify-between"
      data-library-select-target="bar"
    >
      <p class="text-sm text-ink-700">
        <span class="font-semibold text-ink-900" data-library-select-target="count">0</span>
        selected
      </p>
      <div class="flex items-center gap-2">
        <%= form_with url: bulk_update_library_media_index_path, method: :patch do %>
          <select
            name="media_type_id"
            aria-label="Set media type"
            data-action="change->library-select#setMediaType"
            class="rounded-lg border border-ink-900/15 bg-white px-2.5 py-2 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30"
          >
            <option value="" disabled selected hidden>Set media type…</option>
            <% MediaType.ordered.each do |t| %>
              <option value="<%= t.id %>"><%= t.name %></option>
            <% end %>
            <option value="">Not set</option>
          </select>
        <% end %>
      </div>
    </div>
  <% elsif (media_type = MediaType.find_by(slug: params[:type])) %>
    <p class="text-sm text-ink-600">No <%= media_type.name.pluralize.downcase %> yet.</p>
  <% elsif (recipe = params[:recipe].presence && Recipe.find_by(id: params[:recipe])) %>
    <p class="text-sm text-ink-600">No media from <%= recipe.name %> yet.</p>
  <% else %>
    <p class="text-sm text-ink-600">
      No media yet. Drop photos or videos anywhere here<% if @collection == "inbox" && (Current.account.telegram_user_id.present? || Current.account.whatsapp_phone.present?) %>, or send a photo to the bot<% end %>.
    </p>
  <% end %>
</div>
<% end %>
