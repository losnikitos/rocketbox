<% content_for(:title, "Uploads — Rocketbox") %>

<%= form_with url: library_media_index_path, multipart: true, class: "hidden",
      data: { controller: "drop-upload" } do %>
  <%= file_field_tag "files[]",
        multiple: true,
        accept: "image/*,video/*",
        id: "library-upload-input",
        data: { drop_upload_target: "input", action: "change->drop-upload#changed" } %>
<% end %>

<% if @review_media %>
  <%= render "accounts/library/review_media", attachments: @review_media %>
<% else %>
<div data-controller="library-select" data-library-select-max-value="<%= SmmPost::MAX_MEDIA %>">
  <% if @library_media.present? %>
    <div class="space-y-8">
      <% @library_media.group_by { |m| m.created_at.to_date }.each do |day, items| %>
        <section>
          <h3 class="mb-3 text-sm font-medium text-ink-900"><%= upload_day_label(day) %></h3>
          <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            <% items.each do |media| %>
              <% selectable = media.story_image? %>
              <li class="group relative min-w-0 rounded-lg" data-library-select-target="item">
                <% if selectable %>
                  <label class="absolute left-2 top-2 z-10 flex cursor-pointer items-center rounded bg-white/90 p-1 shadow-sm opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100 has-[:checked]:opacity-100">
                    <input
                      type="checkbox"
                      name="library_media_ids[]"
                      form="create-instagram-post"
                      value="<%= media.id %>"
                      data-library-select-target="checkbox"
                      data-image="true"
                      data-action="change->library-select#changed"
                      class="size-4 rounded border-ink-900/30 text-rocket focus:ring-rocket"
                    >
                    <span class="sr-only">Select media</span>
                  </label>
                <% end %>

                <%= link_to library_upload_path(media), aria: { label: "Open #{media.kind}" }, class: "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                  <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full rounded-lg object-cover" %>
                <% end %>
                <div class="pointer-events-none absolute inset-0 rounded-lg ring-2 ring-inset ring-ink-900/10" aria-hidden="true"></div>
                <% if media.media_type %>
                  <span class="pointer-events-none absolute bottom-2 left-2 rounded-full bg-white/90 px-2 py-0.5 text-xs font-medium text-ink-900 shadow-sm"><%= media.media_type.humanize %></span>
                <% end %>
                <div class="absolute right-1 top-1 z-10 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
                  <%= render "shared/admin_links/library_media", library_media: media %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>

    <div
      class="sticky bottom-4 z-20 mt-6 hidden flex-col gap-3 rounded-xl border border-ink-900/10 bg-white/95 p-3 shadow-lg backdrop-blur data-[open]:flex sm:data-[open]:flex-row sm:data-[open]:items-center sm:data-[open]:justify-between"
      data-library-select-target="bar"
    >
      <p class="text-sm text-ink-700">
        <span class="font-semibold text-ink-900" data-library-select-target="count">0</span>
        selected
      </p>
      <div class="flex items-center gap-2">
        <%= form_with url: bulk_update_library_media_index_path, method: :patch do %>
          <select
            name="media_type"
            aria-label="Set media type"
            data-action="change->library-select#setMediaType"
            class="rounded-lg border border-ink-900/15 bg-white px-2.5 py-2 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30"
          >
            <option value="" disabled selected hidden>Set media type…</option>
            <% LibraryMedia.media_types.each_key do |t| %>
              <option value="<%= t %>"><%= t.humanize %></option>
            <% end %>
            <option value="">Not set</option>
          </select>
        <% end %>
        <form id="create-instagram-post" action="<%= new_instagram_post_path %>" method="get">
          <button type="submit" class="rb-btn-primary px-4 py-2 text-sm">
            Create Instagram post
          </button>
        </form>
      </div>
    </div>
  <% elsif LibraryMedia.media_types.key?(params[:type]) %>
    <p class="text-sm text-ink-600">No <%= params[:type].pluralize.humanize(capitalize: false) %> yet.</p>
  <% else %>
    <p class="text-sm text-ink-600">
      No media yet. Drop photos or videos anywhere here<% if Current.account.telegram_user_id.present? || Current.account.whatsapp_phone.present? %>, or send a photo to the bot<% end %>.
    </p>
  <% end %>
</div>
<% end %>
