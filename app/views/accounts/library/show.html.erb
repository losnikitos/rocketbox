<% content_for(:title, "#{@media.kind.humanize} — #{@collection.humanize} — Rocketbox") %>
<% blob = @media.file.blob if @media.file.attached? %>

<div class="flex flex-col gap-6 md:flex-row">
  <div class="flex min-w-0 flex-1 flex-col gap-4">
    <%= link_to library_collection_path(@collection), class: "inline-flex items-center gap-1 self-start text-sm text-ink-600 hover:text-ink-900" do %>
      <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      <%= @collection.humanize %>
    <% end %>
    <div class="flex flex-1 items-center justify-center rounded-lg bg-white p-4">
      <% if blob&.image? %>
        <button type="button" popovertarget="hero-media" aria-label="View full size" class="cursor-zoom-in">
          <%= render "accounts/library/file", media: @media, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
        </button>
        <div id="hero-media" popover class="size-full bg-black/90 p-4">
          <button type="button" popovertarget="hero-media" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
            <%= render "accounts/library/file", media: @media, css: "max-h-full max-w-full" %>
          </button>
        </div>
      <% else %>
        <%= render "accounts/library/file", media: @media, controls: true, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
      <% end %>
    </div>

    <%= render "accounts/library/business_card", media: @media if @media.business_card? && @media.story_image? %>

    <% if (run = @media.origin&.workflow_run) %>
      <section class="space-y-3 rounded-2xl border border-ink-900/10 bg-white p-4" aria-labelledby="workflow-heading">
        <div class="flex items-center gap-2">
          <h3 id="workflow-heading" class="text-sm font-semibold text-ink-900"><%= @media.origin.recipe.name %></h3>
          <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= run.status %></span>
          <% if run.running? %>
            <%= button_to stop_library_media_path(@media), class: "rb-btn-ghost-on-light gap-1 px-3 py-1 text-xs" do %>
              <%= heroicon "stop", variant: :micro, options: { class: "size-3", "aria-hidden": true } %>
              Stop
            <% end %>
          <% end %>
          <div class="ml-auto"><%= render "shared/admin_links/generation", generation: @media.origin %></div>
        </div>
        <% if run.error.present? %>
          <p class="text-sm text-signal-red"><%= run.error %></p>
        <% end %>
        <%= render "accounts/recipes/schematic", workflow: run.workflow_class, recipe: @media.origin.recipe, run: %>
      </section>
    <% end %>
  </div>

  <%# Only the recipe thumbnails target this frame; everything else inside navigates the whole page. %>
  <turbo-frame id="side_panel" target="_top" class="contents">
  <aside id="details" class="w-full shrink-0 rounded-2xl border border-ink-900/10 bg-stone-50 p-6 md:w-96 lg:w-108">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-medium text-ink-900"><a href="#details" class="hover:underline">Details</a></h2>
      <%= render "shared/admin_links/library_media", library_media: @media, links: { remove: false } %>
    </div>

    <%= form_with model: @media, url: library_media_path(@media), class: "mt-4" do |f| %>
      <%= f.label :media_type, "Media type", class: "mb-1 block text-sm text-ink-500" %>
      <%= f.select :media_type,
            LibraryMedia.media_types.keys.map { |t| [ t.humanize, t ] },
            { include_blank: "Not set" },
            class: "block w-full rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30",
            onchange: "this.form.requestSubmit()" %>
    <% end %>

    <% if @media.story_image? %>
      <section id="apply_recipe" class="mt-6" aria-labelledby="apply-recipe-heading">
        <h3 id="apply-recipe-heading" class="text-sm text-ink-500"><a href="#apply_recipe" class="hover:underline">Apply recipe</a></h3>
        <% if @media.media_type.nil? %>
          <p class="mt-1 text-sm text-ink-600">Set a media type to see recipes.</p>
        <% elsif (recipes = @media.recipes).empty? %>
          <p class="mt-1 text-sm text-ink-600">No <%= @media.media_type.humanize(capitalize: false) %> recipes yet.</p>
        <% else %>
          <ul class="mt-2 grid grid-cols-3 gap-2">
            <% recipes.each do |recipe| %>
              <% covered = recipe.examples.any? %>
              <li class="relative aspect-2/3 overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900/5 transition hover:border-ink-900/30"
                  data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
                <% recipe.examples.each_with_index do |example, index| %>
                  <div class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
                    <%= render "accounts/recipes/example", example:, css: "size-full object-cover" %>
                  </div>
                <% end %>
                <%= link_to new_library_media_generation_path(@media, recipe_id: recipe.id), data: { turbo_frame: "side_panel" },
                      class: "absolute inset-0 flex items-start focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-rocket" do %>
                  <span class="w-full p-1.5 text-xs font-semibold <%= covered ? "bg-linear-to-b from-black/60 to-transparent pb-5 text-white" : "text-ink-900" %>">
                    <%= recipe.name %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    <% end %>

    <% if @media.generations.any? %>
      <section id="generated" class="mt-6" aria-labelledby="generated-heading">
        <h3 id="generated-heading" class="text-sm text-ink-500"><a href="#generated" class="hover:underline">Generated</a></h3>
        <ul class="mt-2 grid grid-cols-3 gap-2">
          <% @media.generations.sort_by(&:created_at).reverse_each do |generation| %>
            <li class="group relative">
              <%= link_to library_item_path(generation.generated_media), title: generation.recipe.name, class: "block rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                <%= render "accounts/library/file", media: generation.generated_media, css: "aspect-2/3 w-full rounded-md object-cover" %>
              <% end %>
              <div class="absolute right-1 top-1 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
                <%= render "shared/admin_links/generation", generation: %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if (origin = @media.origin) %>
      <section class="mt-6" aria-labelledby="made-from-heading">
        <h3 id="made-from-heading" class="text-sm text-ink-500">Made from</h3>
        <%= link_to library_item_path(origin.source_media), class: "mt-2 flex items-center gap-3 rounded-md text-sm text-ink-900 hover:text-rocket" do %>
          <%= render "accounts/library/file", media: origin.source_media, css: "size-12 shrink-0 rounded-md object-cover" %>
          <span>Source media<span class="block text-ink-500"><%= origin.recipe.name %></span></span>
        <% end %>
      </section>
    <% end %>

    <div class="mt-6 flex flex-wrap gap-2">
      <% if blob %>
        <%= link_to rails_blob_path(@media.file, disposition: "attachment"), class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Download
        <% end %>
      <% end %>
      <%= button_to library_media_path(@media), method: :delete,
            form: { data: { turbo_confirm: "Delete this media? Posts made from it stay." } },
            class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" do %>
        <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Delete
      <% end %>
    </div>

    <details class="group mt-6">
      <summary class="inline-flex cursor-pointer items-center gap-1 text-sm text-ink-600 hover:text-ink-900">
        <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
        Show more
      </summary>
      <dl class="mt-3 space-y-3 text-sm">
        <% [
             [ "Type", @media.kind.humanize ],
             [ "Source", @media.origin ? "Generated" : @media.telegram_file_id ? "Telegram" : @media.whatsapp_media_id ? "WhatsApp" : "Upload" ],
             [ "Uploaded", l(@media.created_at, format: :long) ],
             [ "File name", blob&.filename ],
             [ "Format", blob&.content_type ],
             [ "Size", blob && number_to_human_size(blob.byte_size) ],
             [ "Dimensions", blob&.metadata&.values_at("width", "height")&.compact&.join(" × ").presence ],
             [ "Duration", blob&.metadata&.dig("duration")&.then { |s| "#{s.round(1)} s" } ]
           ].each do |label, value| %>
          <% next if value.blank? %>
          <div>
            <dt class="text-ink-500"><%= label %></dt>
            <dd class="mt-0.5 break-all text-ink-900"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </details>
  </aside>
  </turbo-frame>
</div>
