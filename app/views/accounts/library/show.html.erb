<% content_for(:title, "#{@media.kind.humanize} — #{@media.folder.path} — Rocketbox") %>
<% content_for(:fit, "true") %>
<% blob = @media.file.blob if @media.file.attached? %>
<% [ @media, *@versions, *@siblings ].filter_map(&:transformation_run).select(&:running?).uniq.each do |run| %>
  <%= turbo_stream_from run %>
<% end %>

<% content_for(:breadcrumbs) do %>
  <%= link_to folder_path(@media.folder), class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
    <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    <%= @media.folder.path %>
  <% end %>
  <%= render "shared/admin_links/library_media", library_media: @media, links: { remove: false } %>
<% end %>

<div class="flex min-w-0 flex-1 flex-col gap-4 md:min-h-0 md:gap-0">
  <div class="flex flex-col gap-6 md:min-h-0 md:flex-1 md:flex-row md:gap-0">
    <% if @versions.size > 1 %>
      <% original, *generations = @versions %>
      <% groups = { "Original" => [ original ] }.merge(generations.sort_by(&:created_at).reverse.group_by { upload_day_label(it.created_at.to_date) }) %>
      <nav aria-label="Versions" class="-mt-1 flex shrink-0 gap-4 overflow-x-auto p-1 md:mt-0 md:flex-col md:overflow-y-auto md:border-r md:border-ink-900/10 md:p-3">
        <% groups.each do |label, items| %>
          <section class="shrink-0">
            <h3 class="mb-1.5 text-xs text-ink-500"><%= label %></h3>
            <div class="flex gap-2 md:grid md:grid-cols-2">
              <% items.each do |media| %>
                <%= link_to library_item_path(media), aria: { current: ("page" if media == @media) },
                      class: "group shrink-0 rounded-md ring-2 ring-transparent aria-[current=page]:ring-rocket focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                  <%= render "accounts/library/file", media:, play: true, css: "aspect-2/3 w-16 rounded-md object-cover group-aria-[current=page]:outline-2 group-aria-[current=page]:-outline-offset-2 group-aria-[current=page]:outline-white" %>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
      </nav>
    <% end %>
    <% if (movable = Current.user&.admin?) %>
      <%= form_with url: "", method: :patch, class: "hidden", data: { drag_move_target: "form" } do %>
        <%= hidden_field_tag "library_media[folder_id]", nil, id: nil, data: { drag_move_target: "value" } %>
      <% end %>
    <% end %>
    <%= tag.div class: "relative flex min-w-0 items-center justify-center rounded-lg bg-white md:m-2 md:flex-1 md:@container-size",
          draggable: ("true" if movable), data: { move_url: (library_media_path(@media) if movable) } do %>
      <% if blob&.image? %>
        <button type="button" popovertarget="hero-media" aria-label="View full size"
                class="cursor-zoom-in rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
          <%= render "accounts/library/file", media: @media, css: "max-h-[70vh] md:max-h-[100cqh] max-w-full rounded-lg object-contain" %>
        </button>
        <div id="hero-media" popover class="size-full bg-black/90 p-4">
          <button type="button" popovertarget="hero-media" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
            <%= render "accounts/library/file", media: @media, css: "max-h-full max-w-full" %>
          </button>
        </div>
      <% else %>
        <%= render "accounts/library/file", media: @media, controls: true, css: "max-h-[70vh] md:max-h-[100cqh] max-w-full rounded-lg object-contain" %>
      <% end %>
    <% end %>
  </div>

  <% if @siblings.size > 1 %>
    <nav aria-label="<%= (@media.transformation_run&.workflow_node if @media.ready?)&.label || @media.folder.name %> media"
         class="relative flex shrink-0 gap-2 overflow-x-auto p-1 md:border-t md:border-ink-900/10 md:px-4 md:py-3" data-controller="center-current">
      <% @siblings.each do |media| %>
        <%= link_to library_item_path(media), aria: { current: ("page" if media == @media) },
              class: "group shrink-0 rounded-md ring-2 ring-transparent aria-[current=page]:ring-rocket focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
          <%= render "accounts/library/file", media:, play: true, css: "aspect-2/3 h-20 rounded-md object-cover group-aria-[current=page]:outline-2 group-aria-[current=page]:-outline-offset-2 group-aria-[current=page]:outline-white" %>
        <% end %>
      <% end %>
    </nav>
  <% end %>
</div>

<% content_for(:aside) do %>
  <details open class="group rb-surface-raised p-4">
    <summary class="flex cursor-pointer items-center gap-2">
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-500 transition group-open:rotate-90", "aria-hidden": true } %>
      <h2 class="text-sm font-semibold text-ink-900">Media</h2>
    </summary>
    <div class="mt-3 space-y-4">
      <% if Tag.exists? %>
        <%= form_with url: library_media_path(@media), method: :patch,
              html: { onchange: "event.target.type == 'checkbox' && this.requestSubmit()" },
              class: "flex rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30" do %>
          <%= render "shared/tag_pick", name: "library_media[tag_ids][]", selected: @media.tag_ids, label: "Tags", multiple: true %>
        <% end %>
      <% end %>
      <div class="flex flex-wrap gap-2">
        <% if blob %>
          <%= link_to rails_blob_path(@media.file, disposition: "attachment"), class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm" do %>
            <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
            Download
          <% end %>
        <% end %>
        <%= button_to library_media_path(@media), method: :delete,
              form: { data: { turbo_confirm: "Delete this media? Posts made from it stay." } },
              class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" do %>
          <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Delete
        <% end %>
      </div>
    </div>
  </details>

  <%= render "accounts/library/business_card", media: @media if @media.business_card? && @media.story_image? %>

  <% if (run = @media.transformation_run) %>
    <details open class="group rb-surface-raised p-4">
      <summary class="flex cursor-pointer items-center gap-2">
        <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-500 transition group-open:rotate-90", "aria-hidden": true } %>
        <h2 id="transformation-run-heading" class="text-sm font-semibold text-ink-900">Generation</h2>
        <% unless run.complete? %>
          <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= run.status %></span>
        <% end %>
        <div class="ml-auto"><%= render "shared/admin_links/transformation_run", transformation_run: run %></div>
      </summary>
      <% step = run.workflow_node %>
      <% if run.error.present? || run.workflow_run || run.prompt_text.present? %>
        <div class="mt-3 space-y-3">
          <% if run.error.present? %>
            <p class="text-sm text-signal-red"><%= run.error %></p>
          <% end %>
          <% if (workflow = run.workflow_run&.workflow) %>
            <%= link_to workflow_path(workflow, node: step&.id, run: run.workflow_run_id), id: "made-by-step",
                  class: "-mx-2 flex items-center gap-3 rounded-lg p-2 hover:bg-ink-900/5" do %>
              <% if (cover = step&.transformation&.cover) %>
                <%= image_tag cover, alt: "", class: "aspect-2/3 w-12 shrink-0 rounded-md object-cover" %>
              <% end %>
              <span class="min-w-0 space-y-0.5">
                <span class="block truncate text-sm font-semibold text-ink-900"><%= workflow.name %></span>
                <span class="block truncate text-xs text-ink-500"><%= [ step&.label || "Deleted step", run.workflow_run.name ].join(" · ") %></span>
              </span>
            <% end %>
          <% end %>
          <% if run.transformation ? run.transformation.ai? : run.prompt_text.present? %>
            <%= render "accounts/transformation_runs/options", record: run, rows: [
                  [ "Prompt", run.prompt && link_to(run.prompt.name, edit_prompt_path(run.prompt), class: "underline hover:text-ink-600") ]
                ] %>
          <% end %>
          <% if run.prompt_text.present? %>
            <div>
              <label for="transformation-run-prompt" class="text-sm text-ink-500">Prompt as sent</label>
              <textarea id="transformation-run-prompt" readonly rows="6"
                        class="mt-1 block w-full resize-y rounded-lg border border-ink-900/15 bg-white px-3 py-2 text-sm text-ink-700"><%= run.prompt_text %></textarea>
            </div>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>

  <% if Current.user&.admin? && blob %>
    <details id="run_in_workflow" open class="group rb-surface-raised p-4">
      <summary class="flex cursor-pointer items-center gap-2">
        <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-500 transition group-open:rotate-90", "aria-hidden": true } %>
        <h2 class="text-sm font-semibold text-ink-900">Run in workflow</h2>
      </summary>
      <div class="-mx-2 mt-2">
        <% if (starts = Workflow.starts_for(@media)).empty? %>
          <p class="p-2 text-sm text-ink-600">No workflow starts from <%= @media.folder.path %> yet.</p>
        <% else %>
          <ul class="flex flex-col gap-0.5">
            <% starts.each do |workflow, node| %>
              <li>
                <%= button_to workflow_runs_path(workflow), params: { node_id: node.id, media_id: @media.id },
                      class: "flex w-full cursor-pointer items-center gap-3 rounded-lg p-2 text-left hover:bg-ink-900/5" do %>
                  <%= heroicon "play", variant: :mini, options: { class: "size-5 shrink-0 text-ink-500", "aria-hidden": true } %>
                  <span class="min-w-0 space-y-0.5">
                    <span class="block truncate text-sm font-semibold text-ink-900"><%= workflow.name %></span>
                    <span class="block truncate text-xs text-ink-500"><%= node.label %></span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </details>
  <% end %>

  <details class="group rb-surface-raised p-4">
    <summary class="flex cursor-pointer items-center gap-2">
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 text-ink-500 transition group-open:rotate-90", "aria-hidden": true } %>
      <h2 class="text-sm font-semibold text-ink-900">Details</h2>
    </summary>
    <div class="mt-3">
      <dl class="space-y-2 text-sm">
        <% [
             [ "Type", @media.kind.humanize ],
             [ "Source", @media.transformation_run ? "Generated" : @media.telegram_file_id ? "Telegram" : @media.whatsapp_media_id ? "WhatsApp" : "Upload" ],
             [ "Uploaded", l(@media.created_at, format: :long) ],
             [ "File name", blob&.filename ],
             [ "Format", blob&.content_type ],
             [ "Size", blob && number_to_human_size(blob.byte_size) ],
             [ "Dimensions", blob&.metadata&.values_at("width", "height")&.compact&.join(" × ").presence ],
             [ "Duration", blob&.metadata&.dig("duration")&.then { |s| "#{s.round(1)} s" } ]
           ].each do |label, value| %>
          <% next if value.blank? %>
          <div>
            <dt class="text-ink-500"><%= label %></dt>
            <dd class="mt-0.5 break-all text-ink-900"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </details>
<% end %>
