<% content_for(:title, "#{@media.kind.humanize} — #{@collection.humanize} — Rocketbox") %>
<% blob = @media.file.blob if @media.file.attached? %>
<% source = @media.origin&.source_media if blob %>
<% source = nil unless source&.file&.attached? %>

<%= link_to library_collection_path(@collection), class: "mb-4 inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
  <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
  <%= @collection.humanize %>
<% end %>

<div class="flex flex-col gap-6 md:flex-row">
  <% if @versions.size > 1 %>
    <nav aria-label="Versions" class="-mt-1 flex shrink-0 gap-2 overflow-x-auto p-1 md:flex-col md:overflow-y-auto">
      <% @versions.each_with_index do |media, index| %>
        <%= link_to library_item_path(media), aria: { current: ("page" if media == @media) },
              class: "group shrink-0 rounded-md ring-2 ring-transparent aria-[current=page]:ring-rocket focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
          <%= render "accounts/library/file", media:, css: "aspect-2/3 w-16 rounded-md object-cover group-aria-[current=page]:outline-2 group-aria-[current=page]:-outline-offset-2 group-aria-[current=page]:outline-white" %>
          <% if index.zero? %><span class="block pt-1 text-center text-xs text-ink-500">Original</span><% end %>
        <% end %>
      <% end %>
    </nav>
  <% end %>
  <div class="group flex min-w-0 flex-1 flex-col gap-4">
    <div class="relative flex flex-1 items-center justify-center rounded-lg bg-white">
      <% if blob&.image? %>
        <% after = "group-has-[#compare-original:checked]:hidden" if source %>
        <% before = "hidden group-has-[#compare-original:checked]:block" %>
        <% if source %>
          <label class="relative cursor-pointer rounded-lg has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
            <%= check_box_tag "compare", "original", false, id: "compare-original", class: "peer sr-only", aria: { label: "Show original" } %>
            <%= render "accounts/library/file", media: @media, css: "max-h-[70vh] max-w-full rounded-lg object-contain #{after}" %>
            <%= render "accounts/library/file", media: source, css: "max-h-[70vh] max-w-full rounded-lg object-contain #{before}" %>
            <span class="pointer-events-none absolute left-2 top-2 hidden rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white peer-checked:block">Original</span>
          </label>
          <button type="button" popovertarget="hero-media" aria-label="View full size" title="View full size"
                  class="absolute right-2 top-2 cursor-pointer rounded-full bg-white/90 p-2 text-ink-600 shadow-sm transition hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-rocket">
            <%= heroicon "arrows-pointing-out", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          </button>
        <% else %>
          <button type="button" popovertarget="hero-media" aria-label="View full size"
                  class="cursor-zoom-in rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
            <%= render "accounts/library/file", media: @media, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
          </button>
        <% end %>
        <div id="hero-media" popover class="size-full bg-black/90 p-4">
          <button type="button" popovertarget="hero-media" popovertargetaction="hide" aria-label="Close" class="flex size-full cursor-zoom-out items-center justify-center">
            <%= render "accounts/library/file", media: @media, css: "max-h-full max-w-full #{after}" %>
            <%= render "accounts/library/file", media: source, css: "max-h-full max-w-full #{before}" if source %>
          </button>
        </div>
      <% else %>
        <%= render "accounts/library/file", media: @media, controls: true, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
      <% end %>
    </div>

    <% if @siblings.size > 1 %>
      <nav aria-label="<%= @media.media_type&.name || "Untyped" %> media"
           class="relative flex gap-2 overflow-x-auto p-1" data-controller="center-current">
        <% @siblings.each do |media| %>
          <%= link_to library_item_path(media), aria: { current: ("page" if media == @media) },
                class: "group shrink-0 rounded-md ring-2 ring-transparent aria-[current=page]:ring-rocket focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
            <%= render "accounts/library/file", media:, css: "aspect-2/3 h-20 rounded-md object-cover group-aria-[current=page]:outline-2 group-aria-[current=page]:-outline-offset-2 group-aria-[current=page]:outline-white" %>
          <% end %>
        <% end %>
      </nav>
    <% end %>

    <%= render "accounts/library/business_card", media: @media if @media.business_card? && @media.story_image? %>
  </div>

  <%# Only the recipe thumbnails target this frame; everything else inside navigates the whole page. %>
  <turbo-frame id="side_panel" target="_top" class="contents">
  <aside id="details" class="w-full shrink-0 rounded-2xl border border-ink-900/10 bg-stone-50 p-6 md:w-96 lg:w-108">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-medium text-ink-900"><a href="#details" class="hover:underline">Details</a></h2>
      <%= render "shared/admin_links/library_media", library_media: @media, links: { remove: false } %>
    </div>

    <%= form_with model: @media, url: library_media_path(@media), class: "mt-4" do |f| %>
      <%= f.label :media_type_id, "Media type", class: "mb-1 block text-sm text-ink-500" %>
      <%= f.select :media_type_id,
            MediaType.ordered.pluck(:name, :id),
            { include_blank: "Not set" },
            class: "block w-full rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30",
            onchange: "this.form.requestSubmit()" %>
    <% end %>

    <% if (generation = @media.origin) %>
      <section class="mt-6 space-y-2" aria-labelledby="generation-heading">
        <div class="flex items-center gap-2">
          <h3 id="generation-heading" class="text-sm text-ink-500">Generation</h3>
          <% unless generation.complete? %>
            <span class="rounded-full bg-ink-900/5 px-2 py-0.5 text-xs font-medium capitalize text-ink-700"><%= generation.status %></span>
          <% end %>
          <div class="ml-auto"><%= render "shared/admin_links/generation", generation: %></div>
        </div>
        <% if generation.error.present? %>
          <p class="text-sm text-signal-red"><%= generation.error %></p>
        <% end %>
        <%= render "accounts/recipes/card", recipe: generation.recipe %>
        <% options = generation.options.to_h %>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-ink-900/10">
            <% [
                 [ "Extra prompt", generation.prompt ],
                 [ "Model", options["model"] ],
                 [ "Aspect ratio", options["aspect_ratio"].presence || "Auto" ],
                 [ "Size", options["resolution"]&.upcase ],
                 [ "Duration", options["duration"]&.then { "#{it} s" } ],
                 [ "Quality", (options["quality"]&.capitalize || "Auto" unless generation.video?) ]
               ].each do |label, value| %>
              <% next if value.blank? %>
              <tr>
                <th scope="row" class="w-28 py-1.5 pr-3 text-left align-top font-normal text-ink-500"><%= label %></th>
                <td class="py-1.5 text-ink-900"><span class="line-clamp-3" title="<%= value %>"><%= value %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>

    <% if @media.story_image? %>
      <section id="apply_recipe" class="mt-6" aria-labelledby="apply-recipe-heading">
        <h3 id="apply-recipe-heading" class="text-sm text-ink-500"><a href="#apply_recipe" class="hover:underline">Apply recipe</a></h3>
        <% if @media.media_type.nil? %>
          <p class="mt-1 text-sm text-ink-600">Set a media type to see recipes.</p>
        <% elsif (recipes = @media.recipes).empty? %>
          <p class="mt-1 text-sm text-ink-600">No <%= @media.media_type.name.downcase %> recipes yet.</p>
        <% else %>
          <ul class="mt-2 flex snap-x gap-2 overflow-x-auto pb-1">
            <% recipes.each do |recipe| %>
              <% covered = recipe.examples.any? %>
              <li class="relative aspect-2/3 w-28 shrink-0 snap-start overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900/5 transition hover:border-ink-900/30"
                  data-controller="scrub" data-action="mousemove->scrub#scrub mouseleave->scrub#reset">
                <% recipe.examples.each_with_index do |example, index| %>
                  <div class="absolute inset-0 <%= "hidden" if index.positive? %>" data-scrub-target="slide">
                    <%= render "accounts/recipes/example", example:, css: "size-full object-cover" %>
                  </div>
                <% end %>
                <%= link_to new_library_media_generation_path(@media, recipe_id: recipe.id), data: { turbo_frame: "side_panel" },
                      class: "absolute inset-0 flex items-start focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-rocket" do %>
                  <span class="w-full p-1.5 text-xs font-semibold <%= covered ? "bg-linear-to-b from-black/60 to-transparent pb-5 text-white" : "text-ink-900" %>">
                    <%= recipe.name %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    <% end %>

    <div class="mt-6 flex flex-wrap gap-2">
      <% if blob %>
        <%= link_to rails_blob_path(@media.file, disposition: "attachment"), class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Download
        <% end %>
      <% end %>
      <%= button_to library_media_path(@media), method: :delete,
            form: { data: { turbo_confirm: "Delete this media? Posts made from it stay." } },
            class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" do %>
        <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Delete
      <% end %>
    </div>

    <details class="group mt-6">
      <summary class="inline-flex cursor-pointer items-center gap-1 text-sm text-ink-600 hover:text-ink-900">
        <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
        Show more
      </summary>
      <dl class="mt-3 space-y-3 text-sm">
        <% [
             [ "Type", @media.kind.humanize ],
             [ "Source", @media.origin ? "Generated" : @media.telegram_file_id ? "Telegram" : @media.whatsapp_media_id ? "WhatsApp" : "Upload" ],
             [ "Uploaded", l(@media.created_at, format: :long) ],
             [ "File name", blob&.filename ],
             [ "Format", blob&.content_type ],
             [ "Size", blob && number_to_human_size(blob.byte_size) ],
             [ "Dimensions", blob&.metadata&.values_at("width", "height")&.compact&.join(" × ").presence ],
             [ "Duration", blob&.metadata&.dig("duration")&.then { |s| "#{s.round(1)} s" } ]
           ].each do |label, value| %>
          <% next if value.blank? %>
          <div>
            <dt class="text-ink-500"><%= label %></dt>
            <dd class="mt-0.5 break-all text-ink-900"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </details>
  </aside>
  </turbo-frame>
</div>
