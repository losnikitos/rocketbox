<% content_for(:title, "#{@media.kind.humanize} — #{@collection.humanize} — Rocketbox") %>
<% blob = @media.file.blob if @media.file.attached? %>

<div class="flex flex-col gap-6 md:flex-row">
  <div class="flex min-w-0 flex-1 flex-col gap-4">
    <%= link_to library_collection_path(@collection), class: "inline-flex items-center gap-1 self-start text-sm text-ink-600 hover:text-ink-900" do %>
      <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      <%= @collection.humanize %>
    <% end %>
    <div class="flex flex-1 items-center justify-center rounded-lg bg-ink-900/5 p-4">
      <%= render "accounts/library/file", media: @media, controls: true, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
    </div>

    <%= render "accounts/library/business_card", media: @media if @media.business_card? && @media.story_image? %>
  </div>

  <aside class="w-full shrink-0 md:w-64 md:border-l md:border-ink-900/10 md:pl-6 lg:w-72">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-medium text-ink-900">Details</h2>
      <%= render "shared/admin_links/library_media", library_media: @media, links: { remove: false } %>
    </div>

    <%= form_with model: @media, url: library_media_path(@media), class: "mt-4" do |f| %>
      <%= f.label :media_type, "Media type", class: "mb-1 block text-sm text-ink-500" %>
      <%= f.select :media_type,
            LibraryMedia.media_types.keys.map { |t| [ t.humanize, t ] },
            { include_blank: "Not set" },
            class: "block w-full rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30",
            onchange: "this.form.requestSubmit()" %>
    <% end %>

    <dl class="mt-4 space-y-3 text-sm">
      <% [
           [ "Type", @media.kind.humanize ],
           [ "Source", @media.telegram_file_id ? "Telegram" : @media.whatsapp_media_id ? "WhatsApp" : "Upload" ],
           [ "Uploaded", l(@media.created_at, format: :long) ],
           [ "File name", blob&.filename ],
           [ "Format", blob&.content_type ],
           [ "Size", blob && number_to_human_size(blob.byte_size) ],
           [ "Dimensions", blob&.metadata&.values_at("width", "height")&.compact&.join(" × ").presence ],
           [ "Duration", blob&.metadata&.dig("duration")&.then { |s| "#{s.round(1)} s" } ]
         ].each do |label, value| %>
        <% next if value.blank? %>
        <div>
          <dt class="text-ink-500"><%= label %></dt>
          <dd class="mt-0.5 break-all text-ink-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-6 flex flex-wrap gap-2">
      <% if blob %>
        <%= link_to rails_blob_path(@media.file, disposition: "attachment"), class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon "arrow-down-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Download
        <% end %>
      <% end %>
      <%= button_to library_media_path(@media), method: :delete,
            form: { data: { turbo_confirm: "Delete this media? Posts made from it stay." } },
            class: "inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5" do %>
        <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        Delete
      <% end %>
    </div>
  </aside>
</div>
