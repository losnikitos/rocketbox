<%# locals: (media:) %>
<li class="group relative min-w-0 rounded-lg">
  <%= link_to library_item_path(media), aria: { label: "Open #{media.kind}" }, class: "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
    <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full rounded-lg object-cover" %>
  <% end %>
  <div class="pointer-events-none absolute inset-0 rounded-lg ring-2 ring-inset ring-ink-900/10" aria-hidden="true"></div>
  <% if media.video? %>
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <%= heroicon "play", variant: :solid, options: { class: "size-10 text-white drop-shadow-md" } %>
    </div>
  <% end %>
  <% if media.tag %>
    <span class="pointer-events-none absolute bottom-2 left-2 rounded-full bg-white/90 px-2 py-0.5 text-xs font-medium text-ink-900 shadow-sm opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"><%= media.tag.name %></span>
  <% end %>
  <% if media.generated_media.any? %>
    <div class="absolute bottom-2 right-2 z-10 flex gap-2" aria-label="Generated media">
      <% media.generated_media.first(3).each do |generated| %>
        <%= link_to library_item_path(generated), aria: { label: "Open generated #{generated.kind}" }, class: "block rounded-md shadow-sm ring-2 ring-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
          <%= render "accounts/library/file", media: generated, css: "aspect-2/3 w-8 rounded-md object-cover" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <div class="absolute right-1 top-1 z-10 opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100">
    <%= render "shared/admin_links/library_media", library_media: media %>
  </div>
</li>
