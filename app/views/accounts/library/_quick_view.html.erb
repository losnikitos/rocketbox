<%# locals: (media:, button: true, id: "#{dom_id(media, :quick_view)}_#{SecureRandom.hex(4)}") %>
<%# Hover "Quick view" button that opens the media in a lightbox; the parent needs `group relative`. Without the button, %>
<%# only the lightbox, for a trigger of its own pointing popovertarget at the id it's given. %>
<%# The id is unique per render: popovertarget opens the first match, which may be hidden (e.g. in a closed <details>). %>
<% if media.file.attached? %>
  <% if button %>
    <button type="button" popovertarget="<%= id %>"
            class="absolute inset-x-1.5 bottom-1.5 flex cursor-zoom-in items-center justify-center gap-1.5 rounded-lg bg-white/90 p-1.5 text-xs font-medium text-ink-700 opacity-0 shadow-sm transition group-hover:opacity-100 group-focus-within:opacity-100 hover:bg-white hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-rocket">
      <%= heroicon "eye", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Quick view
    </button>
  <% end %>
  <div id="<%= id %>" popover class="size-full bg-black/90 p-4"
       ontoggle="const v = this.querySelector('video'); if (v) event.newState == 'open' ? v.play().catch(() => {}) : v.pause()">
    <button type="button" popovertarget="<%= id %>" popovertargetaction="hide" aria-label="Close" class="absolute inset-0 cursor-zoom-out"></button>
    <%# Clicks pass through to the close button, except on video controls. %>
    <div class="pointer-events-none relative flex size-full items-center justify-center [&_video]:pointer-events-auto">
      <%= render "accounts/library/file", media:, controls: true, css: "max-h-full max-w-full" %>
    </div>
  </div>
<% end %>
