<%# locals: (media:, css:, controls: false) %>
<% if media.file.attached? %>
  <% if media.story_image? %>
    <%= image_tag url_for(media.file), alt: media.kind, class: css %>
  <% elsif media.video? %>
    <%= video_tag url_for(media.file), controls:, muted: !controls, playsinline: true, preload: "metadata", class: "bg-ink-900/5 #{css}" %>
  <% else %>
    <div class="flex flex-col items-center justify-center gap-2 bg-ink-900/5 px-3 text-center <%= css %>">
      <span class="text-sm font-medium text-ink-900 break-all"><%= media.file.filename %></span>
    </div>
  <% end %>
<% elsif (run = media.recipe_run) %>
  <% failed = run.failed? %>
  <div class="@container flex flex-1 flex-col self-stretch items-center justify-center gap-1 bg-ink-900/5 text-center text-sm <%= css %>" title="<%= run.error %>">
    <%= heroicon failed ? "x-circle" : "arrow-path", variant: :mini, options: { class: "size-5 shrink-0 #{failed ? "text-signal-red" : "animate-spin text-signal-yellow"}", "aria-hidden": true } %>
    <span class="sr-only @[6rem]:not-sr-only <%= failed ? "text-signal-red" : "text-ink-500" %>"><%= failed ? "Generation failed" : "Generating…" %></span>
  </div>
<% else %>
  <div class="flex items-center justify-center bg-ink-900/5 text-sm text-ink-500 <%= css %>">Missing file</div>
<% end %>
