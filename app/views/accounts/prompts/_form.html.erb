<%# locals: (prompt:) %>
<div class="@container space-y-4">
  <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
    <%= link_to "Prompts", prompts_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    <span class="mx-1">/</span>
    <span aria-current="page"><%= prompt.new_record? ? "New prompt" : prompt.name_was %></span>
  </nav>

  <div class="grid items-start gap-8 @3xl:grid-cols-2">
    <%= form_with model: prompt, id: "prompt_form", multipart: true, class: "min-w-0 space-y-4" do |f| %>
      <% if prompt.errors.any? %>
        <div class="<%= tw_alert_error_classes %>" role="alert">
          <ul class="list-inside list-disc">
            <% prompt.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="max-w-md">
        <%= f.label :name, class: tw_label_classes %>
        <%= f.text_field :name, required: true, autofocus: prompt.new_record?, placeholder: "Bank holiday story", class: tw_input_classes %>
      </div>

      <%= render layout: "shared/pipeline_step", locals: { title: "Input" } do %>
        <%= render layout: "shared/input_field", locals: { name: "Inbox", icon: "inbox" } do %>
          <%= f.select :tag_id, Tag.ordered.pluck(:name, :id), {}, required: true, "aria-label": "Tag",
                class: "min-w-0 flex-1 cursor-pointer border-0 bg-transparent py-2 pl-3 text-ink-900 focus:outline-none focus:ring-0" %>
        <% end %>
      <% end %>

      <%= render layout: "shared/pipeline_step", locals: { title: "Processing" } do %>
        <fieldset>
          <legend class="<%= tw_label_classes %>">Makes</legend>
          <div class="<%= tw_segments_classes %>">
            <% { "image" => "photo", "video" => "film" }.each do |kind, icon| %>
              <label class="<%= tw_segment_classes %> flex items-center justify-center gap-1.5 px-3 py-1.5 text-sm font-medium text-ink-900 before:inset-y-2">
                <%= f.radio_button :kind, kind, class: "sr-only", onchange: "this.form.requestSubmit(this.form.elements.refresh)" %>
                <%= heroicon icon, variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                <%= kind.humanize %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <div>
          <%= f.label :body, "Prompt", class: tw_label_classes %>
          <%= f.text_area :body, required: true, rows: 6, class: tw_input_classes %>
        </div>
        <%= render "shared/generation_options", record: prompt, scope: "prompt",
              refresh_url: prompt.persisted? ? edit_prompt_path(prompt) : new_prompt_path %>
      <% end %>

      <%= render layout: "shared/pipeline_step", locals: { title: "Output" } do %>
        <div class="grid grid-cols-2 gap-3">
          <%= render "shared/folder_field", name: "Photobank", icon: "photo" %>
        </div>
        <p class="text-xs text-ink-500">Results keep the input item's tag.</p>
      <% end %>
    <% end %>

    <%= render "shared/examples", record: prompt, form_id: "prompt_form" %>
  </div>

  <div class="flex items-center justify-end gap-2">
    <%= link_to "Cancel", prompts_path, class: "rounded-lg px-3.5 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" %>
    <button type="submit" form="prompt_form" class="rb-btn-primary px-3.5 py-2 text-sm">Save</button>
  </div>
</div>
