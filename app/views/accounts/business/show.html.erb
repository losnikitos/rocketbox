<% content_for(:title, "Business — Rocketbox") %>

<%= form_with model: Current.account, url: business_path, method: :patch, multipart: true,
      class: "space-y-8",
      data: { controller: "autosave", action: "input->autosave#queue change->autosave#queue submit->autosave#submit" } do |form| %>
  <div class="flex flex-col items-center text-center">
    <%= form.label :logo, class: "group relative cursor-pointer" do %>
      <% if Current.account.logo.attached? %>
        <%= image_tag Current.account.logo.variant(resize_to_limit: [ 384, 384 ]),
              alt: "#{Current.account.business_name} logo",
              class: "size-48 rounded-2xl object-cover ring-1 ring-ink-900/10 transition group-hover:ring-ink-900/25" %>
      <% else %>
        <span class="flex size-48 items-center justify-center rounded-2xl bg-ink-900/5 text-ink-400 ring-1 ring-ink-900/10 transition group-hover:bg-ink-900/10 group-hover:ring-ink-900/25">
          <%= heroicon "camera", options: { class: "size-12" } %>
        </span>
      <% end %>
      <span class="sr-only">Change logo</span>
      <%= form.file_field :logo, accept: "image/*", class: "sr-only" %>
    <% end %>

    <h2 class="mt-4 font-manrope text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
      <%= Current.account.business_name.presence || "Your business" %>
    </h2>
  </div>

  <div class="mx-auto max-w-md space-y-4">
    <div>
      <%= form.label :business_name, "Name", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.text_field :business_name, required: true, autocomplete: "organization", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <div>
      <%= form.label :business_description, "Description", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.text_area :business_description, rows: 3, placeholder: "What your business does", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <div>
      <%= form.label :homepage_url, "Homepage URL", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.url_field :homepage_url, autocomplete: "url", placeholder: "https://", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <div>
      <%= form.label :phone, "Phone", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.telephone_field :phone, autocomplete: "tel", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <div>
      <%= form.label :address, "Address", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.text_field :address, autocomplete: "street-address", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <div>
      <%= form.label :business_hours, "Business hours", class: tw_label_classes %>
      <%= autosave_field do %>
        <%= form.text_area :business_hours, rows: 4, placeholder: "Mon–Fri 9am–6pm\nSat 10am–4pm\nSun closed", class: tw_input_autosave_classes %>
      <% end %>
    </div>

    <fieldset>
      <legend class="<%= tw_label_classes %>">Brand voice</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        <% { "classic" => "Clean and stylish", "bold" => "Bolder and more unexpected", "wild" => "Strange ideas, hard to scroll past" }.each do |voice, hint| %>
          <label class="cursor-pointer rounded-lg border border-ink-900/15 px-3 py-2 transition hover:border-ink-900/30 has-checked:border-rocket has-checked:ring-2 has-checked:ring-rocket/30 has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
            <%= form.radio_button :brand_voice, voice, class: "sr-only" %>
            <span class="block text-sm font-medium text-ink-900"><%= voice.capitalize %></span>
            <span class="mt-0.5 block text-xs text-ink-500"><%= hint %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
  </div>
<% end %>
