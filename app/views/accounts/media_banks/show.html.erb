<% content_for(:title, "#{bank_business_label(@media)} — Media bank — Rocketbox") %>
<% content_for(:fit, "true") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to media_banks_path, class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
    <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Media bank
  <% end %>
<% end %>

<% content_for(:header_actions) do %>
  <%= button_to media_bank_path(@media), method: :delete,
        form: { data: { turbo_confirm: "Delete this image?" } },
        class: "rb-btn-ghost-on-light gap-1.5 px-3.5 py-1.5 text-sm text-signal-red hover:text-signal-red" do %>
    <%= heroicon "trash", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Delete
  <% end %>
<% end %>

<div class="flex min-w-0 flex-1 flex-col gap-4 md:min-h-0 md:flex-row md:gap-0"
     data-controller="gallery-lightbox"
     data-gallery-lightbox-prev-value="<%= @prev && media_bank_path(@prev) %>"
     data-gallery-lightbox-next-value="<%= @next && media_bank_path(@next) %>">
  <div class="relative flex min-w-0 flex-1 items-center justify-center rounded-lg bg-white md:m-2">
    <% if @media.file.attached? && @media.file.blob&.image? %>
      <button type="button" popovertarget="bank-hero-<%= @media.id %>" aria-label="View full size"
              class="cursor-zoom-in rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
        <%= image_tag url_for(@media.file), alt: @media.tags.map(&:name).join(" "),
              class: "max-h-[70vh] max-w-full rounded-lg object-contain md:max-h-[calc(100vh-8rem)]" %>
      </button>
      <div id="bank-hero-<%= @media.id %>" popover data-gallery-lightbox-target="panel" class="size-full bg-black/90 p-4">
        <button type="button" popovertarget="bank-hero-<%= @media.id %>" popovertargetaction="hide" aria-label="Close"
                class="flex size-full cursor-zoom-out items-center justify-center">
          <%= image_tag url_for(@media.file), alt: @media.tags.map(&:name).join(" "), class: "max-h-full max-w-full" %>
        </button>
      </div>
    <% else %>
      <p class="text-sm text-ink-500">Missing file</p>
    <% end %>
  </div>

  <aside class="w-full shrink-0 space-y-4 md:w-72 md:border-l md:border-ink-900/10 md:p-4 lg:w-80">
    <div class="rounded-2xl border border-ink-900/10 bg-white p-4">
      <h2 class="text-sm font-semibold text-ink-900"><%= bank_business_label(@media) %></h2>
      <% if @media.tags.any? %>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% @media.tags.ordered.each do |tag| %>
            <%= link_to media_banks_path(tag_id: tag.id) do %>
              <%= render "accounts/tags/tag", tag: %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <p class="mt-3 text-xs text-ink-500">Copy this page URL into a Studio post’s source field.</p>
      <p class="mt-1 break-all font-mono text-xs text-ink-700"><%= media_bank_url(@media) %></p>
    </div>

    <nav aria-label="Neighbours" class="flex gap-2">
      <% if @prev %>
        <%= link_to media_bank_path(@prev), class: "rb-btn-ghost-on-light flex-1 justify-center gap-1 px-3 py-2 text-sm" do %>
          <%= heroicon "chevron-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          Prev
        <% end %>
      <% end %>
      <% if @next %>
        <%= link_to media_bank_path(@next), class: "rb-btn-ghost-on-light flex-1 justify-center gap-1 px-3 py-2 text-sm" do %>
          Next
          <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
        <% end %>
      <% end %>
    </nav>
  </aside>
</div>
