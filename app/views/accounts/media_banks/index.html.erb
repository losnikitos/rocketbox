<% content_for(:title, "Media bank — Rocketbox") %>

<% content_for(:header_actions) do %>
  <label for="media-bank-upload" class="rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
    <%= heroicon "arrow-up-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Upload
  </label>
<% end %>

<%= form_with url: media_banks_path, multipart: true, class: "hidden",
      data: { controller: "drop-upload", action: "dragstart@document->drop-upload#internalStart dragend@document->drop-upload#internalEnd" } do %>
  <%= hidden_field_tag :source_id, nil, data: { drop_upload_target: "source" } %>
  <%= hidden_field_tag :tag_id, @tag&.id %>
  <%= file_field_tag "files[]", multiple: true, accept: "image/*", id: "media-bank-upload",
        data: { drop_upload_target: "input", action: "change->drop-upload#changed" } %>
<% end %>

<nav aria-label="Tags" class="mb-6 flex flex-wrap items-center gap-2">
  <%= link_to media_banks_path,
        class: "rounded-lg px-2.5 py-1 text-sm font-medium #{@tag ? "text-ink-500 hover:bg-ink-900/5 hover:text-ink-900" : "bg-ink-900/5 text-ink-900"}" do %>
    All <span class="tabular-nums text-ink-400">(<%= LibraryMedia.bank.count %>)</span>
  <% end %>
  <% @tags.each do |tag| %>
    <% count = @tag_counts[tag.id] %>
    <%= link_to media_banks_path(tag_id: tag.id),
          class: "rounded-lg px-2.5 py-1 text-sm font-medium #{@tag == tag ? "bg-ink-900/5 text-ink-900" : "text-ink-500 hover:bg-ink-900/5 hover:text-ink-900"}" do %>
      #<%= tag.name %> <span class="tabular-nums text-ink-400">(<%= count %>)</span>
    <% end %>
  <% end %>
</nav>

<% if @items.empty? %>
  <p class="text-sm text-ink-500">No images yet. Use Upload or run <code class="font-mono text-ink-700">bin/rails media_bank:seed</code>.</p>
<% else %>
  <div class="space-y-8" data-controller="gallery-lightbox">
    <% @groups.each do |label, items| %>
      <section>
        <h2 class="mb-3 text-sm font-semibold text-ink-900"><%= label %> <span class="font-normal tabular-nums text-ink-400">(<%= items.size %>)</span></h2>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
          <% items.each do |item| %>
            <li class="group relative min-w-0">
              <% if item.file.attached? && item.file.variable? %>
                <button type="button" popovertarget="bank-<%= item.id %>" aria-label="View full size"
                        class="block w-full cursor-zoom-in rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
                  <%= image_tag url_for(item.file.variant(resize_to_limit: [ 280, 280 ])),
                        alt: item.tags.map(&:name).join(" "),
                        class: "aspect-square w-full rounded-xl object-cover" %>
                </button>
                <div id="bank-<%= item.id %>" popover data-gallery-lightbox-target="panel" class="size-full bg-black/90 p-4">
                  <button type="button" popovertarget="bank-<%= item.id %>" popovertargetaction="hide" aria-label="Close"
                          class="flex size-full cursor-zoom-out items-center justify-center">
                    <%= image_tag url_for(item.file), alt: item.tags.map(&:name).join(" "), class: "max-h-full max-w-full" %>
                  </button>
                </div>
              <% end %>
              <div class="mt-1.5 flex items-start justify-between gap-1">
                <div class="min-w-0">
                  <%= link_to media_bank_path(item), class: "block truncate text-xs font-medium text-ink-700 hover:text-ink-900" do %>
                    #<%= item.id %>
                  <% end %>
                  <p class="truncate text-xs text-ink-400"><%= item.tags.ordered.map { "##{it.name}" }.join(" ") %></p>
                </div>
                <%= button_to media_bank_path(item), method: :delete,
                      form: { data: { turbo_confirm: "Delete this image?" } },
                      class: "shrink-0 text-xs text-signal-red opacity-0 hover:underline group-hover:opacity-100 focus-visible:opacity-100" do %>
                  Delete
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>
