<% content_for(:title, "#{@workflow.name_was} — Rocketbox") %>
<% content_for(:fit, "true") %>
<% tile = "flex size-28 cursor-grab flex-col items-center justify-center gap-2 rounded-xl border border-ink-900/10 bg-white p-2 text-center text-xs font-medium text-ink-900 hover:bg-ink-900/5 active:cursor-grabbing" %>
<% tiles = "flex flex-wrap content-start gap-2 p-3" %>
<% section_heading = "px-3 pt-3 text-xs font-medium text-ink-500" %>
<% search = "block w-48 rounded-lg border border-ink-900/15 bg-white py-1 pr-2 pl-7 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30" %>
<% search_icon = { class: "pointer-events-none absolute top-1/2 left-2 size-4 -translate-y-1/2 text-ink-400", "aria-hidden": true } %>
<% top = { turbo_frame: "_top" } %>

<% content_for(:heading) do %>
  <%= form_with model: @workflow, class: "min-w-0",
        data: { controller: "autosave", action: "change->autosave#queue submit->autosave#submit" } do |f| %>
    <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
      <%= link_to "Workflows", workflows_path, class: "underline underline-offset-2 hover:text-ink-900" %>
    </nav>
    <div class="flex min-w-0 items-center gap-3">
      <h1 class="-ml-2 min-w-0 font-manrope text-xl font-bold tracking-tight sm:text-2xl">
        <%= f.text_field :name, required: true, placeholder: "Workflow name", "aria-label": "Name",
              class: "block max-w-full min-w-0 field-sizing-content rounded-lg border-0 bg-transparent px-2 py-0.5 placeholder:text-ink-400 hover:bg-ink-900/5 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rocket/30" %>
      </h1>
      <label title="Run each new media that lands in a start folder, on its own" class="flex cursor-pointer items-center gap-2 text-sm font-medium text-ink-700">
        <%= f.check_box :autorun, role: "switch", class: "rb-switch" %>
        Autorun
      </label>
    </div>
  <% end %>
<% end %>
<% content_for(:header_actions) { render "shared/admin_links/workflow", workflow: @workflow } %>

<% thumb = "h-15 w-auto rounded-md" %>
<%# How long one or several step runs took: the slowest, once none is running. %>
<% took = ->(runs) { (seconds = Array(runs).map(&:duration)).all? ? "#{number_with_precision(seconds.max, precision: 1)} s" : "…" } %>
<% thumbs = ->(media) { capture do %>
  <span class="flex items-center gap-0.5">
    <% media.first(4).each do |media| %>
      <span class="block size-7 shrink-0 overflow-hidden rounded"><%= render "accounts/library/file", media:, css: "size-full object-cover" %></span>
    <% end %>
    <% if media.size > 4 %><span class="pl-0.5 text-xs text-ink-500 tabular-nums">+<%= media.size - 4 %></span><% end %>
  </span>
<% end } %>
<% status = ->(run) { (state = run.state) && tag.span(state.humanize, title: ("Its picks are locked" unless run.draft?), class: run_status_pill_class(state)) } %>
<%# The media a run started from, then the ones it ended with. %>
<% ends = ->(run) { tag.span(thumbs.(run.inputs) + thumbs.(run.outputs), class: "flex items-center gap-2") if run.inputs.any? || run.outputs.any? } %>
<% here = workflow_path(@workflow, run: @run.id) %>
<% add_to_canvas = ->(media, corner) { button_tag type: :submit, form: "workflow_add", name: "workflow[nodes_attributes][0][library_media_id]", value: media.id,
     title: "Add to canvas", aria: { label: "Add to canvas" },
     class: "absolute top-1.5 #{corner} cursor-pointer rounded-lg bg-white/90 p-1 text-ink-700 opacity-0 shadow-sm transition group-hover:opacity-100 group-focus-within:opacity-100 hover:bg-white hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-rocket" do
       heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true }
     end } %>

<div class="flex min-w-0 flex-1 flex-col md:min-h-0 md:flex-row" data-controller="workflow" data-workflow-url-value="<%= here %>"
     data-action="flow:moved->workflow#move flow:copied->workflow#copy flow:linked->workflow#link flow:cleared->workflow#clear keydown@document->workflow#remove">
  <div class="flex min-w-0 flex-1 flex-col md:min-h-0">
    <% if @workflow.errors.any? %>
      <div class="<%= tw_alert_error_classes %> m-3" role="alert">
        <ul class="list-inside list-disc">
          <%# Node and edge errors (nodes.base, edges.to_id) are whole sentences. %>
          <% @workflow.errors.each do |error| %>
            <li><%= error.attribute.to_s.include?(".") ? error.message : error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="relative flex flex-col md:min-h-0 md:flex-1" data-action="dragover->workflow#over drop->workflow#drop">
      <%= render "shared/flow", nodes: @nodes, edges: @edges, height: "h-[60dvh] md:h-auto md:min-h-0 md:flex-1" %>
      <% if @nodes.empty? %>
        <p class="pointer-events-none absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-ink-500">
          Add folders and transformations with + Add.
        </p>
      <% end %>
      <button type="button" popovertarget="workflow_palette" style="anchor-name: --workflow-palette" class="absolute top-3 left-3 z-10 inline-flex cursor-pointer items-center gap-1 rounded-lg border border-ink-900/15 bg-white px-3.5 py-2 text-sm font-semibold text-ink-900 hover:bg-stone-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
        <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %> Add
      </button>
      <div id="workflow_palette" popover aria-label="Add" style="position-anchor: --workflow-palette"
           class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline] w-xl rounded-lg border border-ink-900/15 bg-white shadow-lg">
        <div class="border-b border-ink-900/10 p-2">
          <label class="relative block w-fit">
            <%= heroicon "magnifying-glass", variant: :mini, options: search_icon %>
            <%= search_field_tag nil, nil, id: nil, autocomplete: "off", aria: { label: "Search" },
                  data: { action: "input->workflow#filter" }, class: search %>
          </label>
        </div>
        <div class="max-h-96 overflow-y-auto">
          <section aria-labelledby="palette_folders">
            <h3 id="palette_folders" class="<%= section_heading %>">Folders</h3>
            <div class="<%= tiles %>">
              <% Folder.roots.ordered.includes(:children).flat_map { [ it, *it.children ] }.each do |folder| %>
                <%= button_tag type: :submit, form: "workflow_add", name: "workflow[nodes_attributes][0][folder_id]", value: folder.id, draggable: "true",
                      title: folder.path, data: { workflow_target: "item", action: "dragstart->workflow#pick dragend->workflow#unpick" }, class: tile do %>
                  <%= heroicon "folder", options: { class: "size-7 #{folder_color(folder)}", "aria-hidden": true } %>
                  <span class="line-clamp-2"><%= folder.path %></span>
                <% end %>
              <% end %>
            </div>
          </section>
          <% Transformation::Type.all.group_by(&:group).each do |group, types| %>
            <section aria-labelledby="palette_<%= group.slug %>">
              <h3 id="palette_<%= group.slug %>" class="<%= section_heading %>"><%= group.label %></h3>
              <div class="<%= tiles %>">
                <% types.each do |type| %>
                  <%= button_tag type: :submit, form: "workflow_add", name: "workflow[nodes_attributes][0][transformation_attributes][kind]", value: type.slug, draggable: "true",
                        title: type.description || type.label, data: { workflow_target: "item", action: "dragstart->workflow#pick dragend->workflow#unpick" }, class: tile do %>
                    <%= image_tag type.cover, alt: "", draggable: "false", class: "aspect-2/3 h-14 rounded-md object-cover" %>
                    <span class="line-clamp-2"><%= type.label %></span>
                  <% end %>
                <% end %>
              </div>
            </section>
          <% end %>
          <section aria-labelledby="palette_notes">
            <h3 id="palette_notes" class="<%= section_heading %>">Notes</h3>
            <div class="<%= tiles %>">
              <%= button_tag type: :submit, form: "workflow_add", name: "workflow[nodes_attributes][0][note]", value: "Note", draggable: "true",
                    title: "A sticky note", data: { workflow_target: "item", action: "dragstart->workflow#pick dragend->workflow#unpick" }, class: tile do %>
                <%= heroicon "pencil-square", options: { class: "size-7 text-amber-400", "aria-hidden": true } %>
                <span class="line-clamp-2">Note</span>
              <% end %>
            </div>
          </section>
        </div>
      </div>
    </div>

    <%= form_with model: @workflow, id: "workflow_add", class: "hidden", data: { workflow_target: "add", action: "submit->workflow#place" } do %>
      <%= hidden_field_tag "workflow[nodes_attributes][0][x]", nil, id: nil, data: { workflow_target: "x" } %>
      <%= hidden_field_tag "workflow[nodes_attributes][0][y]", nil, id: nil, data: { workflow_target: "y" } %>
    <% end %>
    <%= form_with model: @workflow, class: "hidden", data: { workflow_target: "connect" } do %>
      <%= hidden_field_tag "workflow[edges_attributes][0][id]", nil, id: nil, data: { workflow_target: "edge" } %>
      <%= hidden_field_tag "workflow[edges_attributes][0][from_id]", nil, id: nil, data: { workflow_target: "from" } %>
      <%= hidden_field_tag "workflow[edges_attributes][0][to_id]", nil, id: nil, data: { workflow_target: "to" } %>
      <%= hidden_field_tag "workflow[edges_attributes][0][slot]", nil, id: nil, data: { workflow_target: "slot" } %>
    <% end %>
    <%= form_with url: copy_workflow_path(@workflow, run: @run.id), class: "hidden", data: { workflow_target: "copy" } do %>
      <%= hidden_field_tag :node_id, nil, id: nil, data: { workflow_target: "copyNode" } %>
      <%= hidden_field_tag :x, nil, id: nil, data: { workflow_target: "copyX" } %>
      <%= hidden_field_tag :y, nil, id: nil, data: { workflow_target: "copyY" } %>
    <% end %>
    <%= form_with url: run_workflow_path(@workflow, run: @run.id), id: "workflow_play", class: "hidden" do %><% end %>

    <%= turbo_stream_from @run %>
    <section aria-label="Runs" class="h-56 shrink-0 overflow-y-auto border-t border-ink-900/10">
      <header class="sticky top-0 z-20 flex items-center justify-between gap-2 border-b border-ink-900/10 bg-white px-3 py-1.5">
        <h2 class="text-xs font-medium text-ink-500">Runs</h2>
        <%= button_to workflow_runs_path(@workflow), class: "flex cursor-pointer items-center gap-1 rounded-lg px-2.5 py-1 text-sm font-medium text-ink-600 transition hover:bg-ink-900/5 hover:text-ink-900" do %>
          <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %> New run
        <% end %>
      </header>
      <% if @runs.empty? %>
        <p class="p-6 text-center text-sm text-ink-500">No runs yet.</p>
      <% end %>
      <% @runs.each do |run| %>
        <div class="relative border-b border-ink-900/10">
          <%= link_to workflow_path(@workflow, run: run.id), aria: { current: ("page" if run == @run) }, data: { action: "workflow#keep" },
                class: "flex min-h-11 items-center gap-3 py-2 pr-12 pl-10 text-sm text-ink-900 transition hover:bg-ink-900/5 aria-[current=page]:bg-rocket/10" do %>
            <span><span class="font-medium"><%= run.name %></span> <span class="text-ink-500">&middot; <%= upload_day_label(run.created_at.to_date) %> <%= run.created_at.strftime("%H:%M") %></span></span>
            <%= status.(run) %>
            <%= ends.(run) %>
          <% end %>
          <details id="<%= dom_id(run) %>" class="group">
            <summary aria-label="Steps" title="Steps"
                     class="absolute top-1.5 left-1.5 flex size-8 cursor-pointer list-none items-center justify-center rounded-lg text-ink-400 transition hover:bg-ink-900/5 hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-rocket [&::-webkit-details-marker]:hidden">
              <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
            </summary>
            <% if run.error %>
              <p class="<%= tw_alert_error_classes %> m-3" role="alert"><%= run.error %></p>
            <% end %>
            <% if run.step_runs.any? %>
              <table class="w-full border-t border-ink-900/10 text-left text-sm">
                <thead class="text-xs text-ink-500">
                  <tr>
                    <th class="px-3 py-2 font-medium">Step</th>
                    <th class="px-3 py-2 font-medium">Status</th>
                    <th class="px-3 py-2 font-medium">Inputs</th>
                    <th class="px-3 py-2 font-medium">Output</th>
                    <th class="px-3 py-2 text-right font-medium">Time</th>
                    <th class="w-0 px-3 py-2"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ink-900/10">
                  <% run.step_runs.each do |step_run| %>
                    <tr>
                      <td class="px-3 py-2 font-medium text-ink-900">
                        <% if (node = step_run.workflow_node) %>
                          <%= link_to node.label, workflow_path(@workflow, run: run.id, node: node.id), class: "hover:underline" %>
                        <% else %>
                          <%= step_run.transformation&.name || "Removed step" %>
                        <% end %>
                      </td>
                      <td class="px-3 py-2">
                        <span title="<%= step_run.error %>" class="<%= run_status_pill_class(step_run.status) %>"><%= step_run.status.humanize %></span>
                      </td>
                      <% [ step_run.source_media, [ step_run.generated_media ] ].each do |media| %>
                        <td class="px-3 py-2"><%= render "media", media:, css: thumb %></td>
                      <% end %>
                      <td class="px-3 py-2 text-right text-ink-600 tabular-nums"><%= took.(step_run) %></td>
                      <td class="px-3 py-2"><%= render "shared/admin_links/transformation_run", transformation_run: step_run %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% elsif !run.error %>
              <p class="px-3 pb-3 pl-10 text-sm text-ink-500">Press play on a start folder or media to run the workflow.</p>
            <% end %>
          </details>
          <div class="absolute top-0 right-3 flex h-11 items-center">
            <%= render "shared/admin_links/workflow_run", workflow_run: run %>
          </div>
        </div>
      <% end %>
    </section>
  </div>

  <%= turbo_frame_tag "inspector", class: "hidden shrink-0 has-[*]:block space-y-4 overflow-y-auto border-ink-900/10 p-4 max-md:border-t md:w-96 md:border-l lg:w-108" do %>
    <% if (edge = @selected_edge) %>
      <header class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <p class="text-xs text-ink-500">Connection</p>
          <h2 class="truncate text-sm font-semibold text-ink-900"><%= edge.from.label %> → <%= edge.to.label %></h2>
        </div>
        <%= link_to here, data: top, aria: { label: "Close" }, class: "rounded-lg p-1 text-ink-500 transition hover:bg-ink-900/5 hover:text-ink-900" do %>
          <%= heroicon "x-mark", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
        <% end %>
      </header>
      <%= button_to "Remove connection", workflow_path(@workflow), method: :patch, form: { data: top },
            data: { workflow_target: "remove" }, aria: { keyshortcuts: "Delete" },
            class: "cursor-pointer rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5",
            params: { workflow: { edges_attributes: { "0" => { id: edge.id, _destroy: 1 } } } } %>
    <% elsif (node = @selected) %>
      <header class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <p class="text-xs text-ink-500"><%= node.step? ? "Transformation" : node.note? ? "Note" : node.library_media ? "Media" : "Folder" %></p>
          <h2 id="node_<%= node.id %>_heading" class="truncate text-sm font-semibold text-ink-900"><%= node.label %></h2>
        </div>
        <%= link_to here, data: top, aria: { label: "Close" }, class: "rounded-lg p-1 text-ink-500 transition hover:bg-ink-900/5 hover:text-ink-900" do %>
          <%= heroicon "x-mark", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
        <% end %>
      </header>

      <% start = @start_nodes.include?(node) %>
      <% if (status = TransformationRun.status_of(@node_runs)) %>
        <dl aria-label="Stats" class="grid grid-cols-2 gap-3 border-t border-ink-900/10 pt-4 text-sm">
          <div>
            <dt class="text-xs text-ink-500">Status</dt>
            <dd class="mt-1"><span class="<%= run_status_pill_class(status) %>"><%= status.humanize %></span></dd>
          </div>
          <div>
            <dt class="text-xs text-ink-500">Took</dt>
            <dd class="mt-1 text-ink-900 tabular-nums"><%= took.(@node_runs) %></dd>
          </div>
        </dl>
        <% @node_runs.filter_map(&:error).uniq.each do |error| %>
          <p class="<%= tw_alert_error_classes %>" role="alert"><%= error %></p>
        <% end %>
      <% elsif node.step? %>
        <p class="border-t border-ink-900/10 pt-4 text-sm text-ink-500">This step hasn't run in this run.</p>
      <% end %>
      <% if node.folder && start %>
        <section aria-label="Picks" class="space-y-2 border-t border-ink-900/10 pt-4">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xs text-ink-500"><%= @run.draft? ? "Play takes" : "Play took (locked once the run started)" %></h3>
            <% if @run.draft? && @run.picks.key?(node.id.to_s) %>
              <%= button_to "Newest #{node.newest}", workflow_run_path(@workflow, @run), method: :patch, params: { node_id: node.id }, form: { data: top },
                    title: "Take its newest media again", class: "rb-btn-ghost-on-light px-2.5 py-1 text-xs" %>
            <% end %>
          </div>
          <% if @folder_media.any? %>
            <% picked = @run.picked(node, Current.account) %>
            <%= form_with url: workflow_run_path(@workflow, @run), method: :patch, data: top, html: { onchange: "this.requestSubmit()" } do %>
              <%= hidden_field_tag :node_id, node.id, id: nil %>
              <ul aria-label="Media" class="grid grid-cols-3 gap-2">
                <% @folder_media.each do |media| %>
                  <li class="group relative cursor-grab active:cursor-grabbing" draggable="true" data-action="dragstart->workflow#pick dragend->workflow#unpick">
                    <label class="group/option relative block cursor-pointer overflow-hidden has-disabled:cursor-default rounded-lg border border-ink-900/15 hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                      <%= check_box_tag "media_ids[]", media.id, picked.include?(media), id: nil, disabled: !@run.draft?, class: "sr-only" %>
                      <span class="block"><%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover", play: true %></span>
                      <span class="absolute top-1 right-1 flex size-5 items-center justify-center rounded-full border-2 border-white bg-black/20 text-transparent shadow-sm group-has-checked/option:border-rocket group-has-checked/option:bg-rocket group-has-checked/option:text-white" aria-hidden="true">
                        <%= heroicon "check", variant: :micro, options: { class: "size-3.5" } %>
                      </span>
                    </label>
                    <%= add_to_canvas.(media, "left-1.5") %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          <% else %>
            <p class="text-sm text-ink-500"><%= node.tag_ids.any? ? "No media in this folder has those tags." : "This folder is empty." %></p>
          <% end %>
        </section>
      <% elsif node.step? ? @node_runs.any? : (@run_inputs + @run_outputs).any? %>
        <% { "Inputs" => @run_inputs, "Outputs" => @run_outputs }.each do |label, media| %>
          <section aria-label="<%= label %>" class="space-y-2 border-t border-ink-900/10 pt-4">
            <h3 class="text-xs text-ink-500"><%= label %></h3>
            <% if media.any? %>
              <%= render "media", media:, css: "h-36 w-auto max-w-full rounded-lg object-contain" %>
            <% else %>
              <p class="text-sm text-ink-500">None in this run.</p>
            <% end %>
          </section>
        <% end %>
      <% end %>

      <section aria-label="Settings" class="space-y-4 border-t border-ink-900/10 pt-4">
        <h3 class="text-xs text-ink-500">Settings</h3>
        <div class="flex flex-wrap items-center gap-2">
          <% if node.folder %>
            <%= link_to "Open in library", library_folders_path(*[ node.folder.parent&.slug, node.folder.slug ].compact), data: top,
                  class: "rb-btn-ghost-on-light px-3.5 py-1.5 text-sm" %>
          <% elsif node.library_media %>
            <%= link_to "Open in library", library_item_path(node.library_media), data: top, class: "rb-btn-ghost-on-light px-3.5 py-1.5 text-sm" %>
          <% end %>
          <%= button_to "Remove from workflow", workflow_path(@workflow), method: :patch, form: { data: top },
                data: { workflow_target: "remove" }, aria: { keyshortcuts: "Delete" },
                class: "cursor-pointer rounded-lg border border-signal-red/40 bg-white px-3.5 py-1.5 text-sm font-semibold text-signal-red transition hover:bg-ink-900/5",
                params: { workflow: { nodes_attributes: { "0" => { id: node.id, _destroy: 1 } } } } %>
        </div>

        <% if (node.step? || node.folder) && Tag.exists? %>
          <%= form_with model: @workflow, data: top, html: { onchange: "event.target.type == 'checkbox' && this.requestSubmit()" } do %>
            <%= hidden_field_tag "workflow[nodes_attributes][0][id]", node.id, id: nil %>
            <p class="<%= tw_label_classes %>"><%= node.step? ? "Tag what it makes" : "Only media tagged" %></p>
            <div class="flex rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
              <%= render "shared/tag_pick", name: "workflow[nodes_attributes][0][tag_ids][]", selected: node.tag_ids, label: "Tags", multiple: true %>
            </div>
            <p class="mt-1 text-xs text-ink-500">
              <%= node.step? ? "Its results get these tags." : "Steps it feeds take only its media with all of these tags." %>
            </p>
          <% end %>
        <% end %>

        <% if node.step? %>
          <%= turbo_frame_tag "transformation", src: transformation_path(node.transformation), target: "_top", class: "block border-t border-ink-900/10 pt-4" do %>
            <p class="text-sm text-ink-500">Loading…</p>
          <% end %>
        <% elsif (media = node.library_media) %>
          <div class="border-t border-ink-900/10 pt-4">
            <div class="group relative w-40">
              <%= render "accounts/library/file", media:, play: true, css: "aspect-2/3 w-full rounded-lg object-cover" %>
              <%= render "accounts/library/quick_view", media: %>
            </div>
          </div>
        <% elsif node.note? %>
          <%= form_with model: @workflow, data: top, html: { onchange: "this.requestSubmit()" }, class: "space-y-4 border-t border-ink-900/10 pt-4" do %>
            <%= hidden_field_tag "workflow[nodes_attributes][0][id]", node.id, id: nil %>
            <div>
              <%= label_tag "workflow_node_note", "Note", class: tw_label_classes %>
              <%= text_area_tag "workflow[nodes_attributes][0][note]", node.note, id: "workflow_node_note", rows: 8,
                    aria: { describedby: "workflow_node_note_hint" }, class: tw_input_classes %>
              <p id="workflow_node_note_hint" class="mt-1 text-xs text-ink-500">Markdown: **bold**, # heading, - list. Saves when you click away.</p>
            </div>
            <fieldset>
              <legend class="<%= tw_label_classes %>">Color</legend>
              <div class="flex gap-2">
                <% Folder.colors.each_key do |color| %>
                  <label title="<%= color.humanize %>"
                         class="size-8 cursor-pointer rounded-full border-2 <%= AppHelper::NOTE_COLORS[color] %> has-checked:ring-2 has-checked:ring-rocket has-checked:ring-offset-2 has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                    <%= radio_button_tag "workflow[nodes_attributes][0][color]", color, node.color == color, id: nil, class: "sr-only" %>
                    <span class="sr-only"><%= color.humanize %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        <% else %>
          <%= form_with model: @workflow, data: top, html: { onchange: "this.requestSubmit()" } do %>
            <%= hidden_field_tag "workflow[nodes_attributes][0][id]", node.id, id: nil %>
            <%= label_tag "workflow_node_newest", "Newest", class: tw_label_classes %>
            <div class="w-24">
              <%= number_field_tag "workflow[nodes_attributes][0][newest]", node.newest, id: "workflow_node_newest", min: 1, required: true,
                    aria: { describedby: "workflow_node_newest_hint" }, class: tw_input_classes %>
            </div>
            <p id="workflow_node_newest_hint" class="mt-1 text-xs text-ink-500">How many of its newest media it gives the steps it feeds.</p>
          <% end %>
          <%# A start folder's media are its picks above. %>
          <% unless start %>
            <% if @folder_media.any? %>
              <ul aria-label="Media" class="grid grid-cols-3 gap-2 border-t border-ink-900/10 pt-4">
                <% @folder_media.each do |media| %>
                  <li class="group relative cursor-grab active:cursor-grabbing" draggable="true" data-action="dragstart->workflow#pick dragend->workflow#unpick">
                    <%= link_to library_item_path(media), data: top, class: "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                      <%= render "accounts/library/file", media:, play: true, css: "aspect-2/3 w-full rounded-lg object-cover" %>
                    <% end %>
                    <%= render "accounts/library/quick_view", media: %>
                    <%= add_to_canvas.(media, "right-1.5") %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="border-t border-ink-900/10 pt-4 text-sm text-ink-500"><%= node.tag_ids.any? ? "No media in this folder has those tags." : "This folder is empty." %></p>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>
