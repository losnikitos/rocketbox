<%# locals: (items:, css:, pin: nil) %>
<%# A node's items in the inspector: media as thumbnails (see _media), prompts (beside their first example) and reviews as text cards. pin (a folder %>
<%# node) makes each text card a pin toggle for it, inside the inspector's Pins form. %>
<% media, texts = items.partition { it.is_a?(LibraryMedia) } %>
<% if media.any? %>
  <%= render "accounts/workflows/media", media:, css: %>
<% end %>
<% if texts.any? %>
  <ul class="space-y-1.5">
    <% texts.each do |item| %>
      <li>
        <%= content_tag pin ? :label : :div, title: ("Pin" if pin),
              class: "relative block rounded-lg border border-ink-900/10 bg-white p-2.5 text-sm #{"group/option cursor-pointer pr-9 hover:border-ink-900/30 has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30" if pin}" do %>
          <% if pin %>
            <%# Taking one, a new pin replaces the last. %>
            <%= tag.input type: pin.take > 1 ? "checkbox" : "radio", name: "workflow[nodes_attributes][0][pinned_ids][]", value: item.id,
                  checked: pin.pinned_ids.include?(item.id), aria: { label: "Pin" }, class: "sr-only" %>
          <% end %>
          <% if item.is_a?(Prompt) %>
            <div class="flex gap-2.5">
              <% if (example = item.examples.first) %>
                <%= render "shared/example", example:, variant: :small, css: "aspect-2/3 w-16 shrink-0 rounded object-cover" %>
              <% end %>
              <div class="min-w-0">
                <%= link_to item.name, edit_prompt_path(item), data: { turbo_frame: "_top" }, class: "flex items-center gap-1.5 font-medium text-ink-900 hover:underline" %>
                <p class="mt-1 line-clamp-4 text-ink-600"><%= item.body.presence || "Writing…" %></p>
              </div>
            </div>
          <% else %>
            <p class="font-medium text-ink-900"><%= item.customer_name %> · <%= "★" * item.rating %></p>
            <p class="mt-1 line-clamp-4 text-ink-600"><%= item.body %></p>
          <% end %>
          <% if pin %>
            <span class="absolute top-2 right-2 flex size-6 items-center justify-center rounded-full bg-stone-100 text-ink-700 opacity-0 group-hover/option:opacity-100 group-has-focus-visible/option:opacity-100 group-has-checked/option:bg-rocket group-has-checked/option:text-white group-has-checked/option:opacity-100" aria-hidden="true">
              <%= lucide_icon "pin", class: "size-3.5 group-has-checked/option:fill-current", "aria-hidden": true %>
            </span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
