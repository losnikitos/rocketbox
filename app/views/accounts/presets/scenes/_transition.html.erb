<%# locals: (scene:, from_bg:, to_bg:, bg: nil) %>
<%# Simple fade stand-in: from fades out L→R, to fades in L→R. Empty sides stay gray. %>
<div class="relative size-full overflow-hidden bg-ink-900/10">
  <div class="absolute inset-0 bg-ink-900/10 bg-cover bg-center"
       style="mask-image: linear-gradient(to right, #000, transparent); -webkit-mask-image: linear-gradient(to right, #000, transparent);<%= from_bg && " background-image: url(#{from_bg})" %>"></div>
  <div class="absolute inset-0 bg-ink-900/10 bg-cover bg-center"
       style="mask-image: linear-gradient(to right, transparent, #000); -webkit-mask-image: linear-gradient(to right, transparent, #000);<%= to_bg && " background-image: url(#{to_bg})" %>"></div>
</div>
