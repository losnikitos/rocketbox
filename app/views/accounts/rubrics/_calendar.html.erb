<%# locals: (rubrics:, posts:, date:, days:, week:, draft: nil) %>
<%# Past days show what each rubric posted; the next month, what each is planned to post (a placeholder once it has nothing fresh); later, only when. The draft (dashed) stands in for its saved self. %>
<%
  now = Time.current
  horizon = now + 1.month
  rubrics = rubrics.map { it.id && it.id == draft&.id ? draft : it }
  rubrics += [ draft ] if draft&.new_record?
  scheduled = rubrics.reject { it.errors[:schedule].any? }
  plan = Rubric.plan(scheduled, horizon)
  entries = posts.map { [ it.scheduled_at.in_time_zone, it.rubric, it, it.library_media, false ] }
  entries += plan.filter_map { |time, rubric, media| [ time, rubric, nil, media, media.nil? ] if days.cover?(time.to_date) }
  later = [ days.first.beginning_of_day, horizon ].max..days.last.end_of_day
  if later.begin < later.end
    scheduled.each { |rubric| entries += rubric.occurrences(later).map { [ it, rubric, nil, nil, false ] } }
  end
  by_day = entries.sort_by(&:first).group_by { it.first.to_date }
  # An autosave PATCH redraws it too; its links go back to edit.
  nav_link = ->(day) { url_for(request.query_parameters.merge("date" => day.iso8601, action: action_name == "update" ? "edit" : action_name)) }
  step = week ? 1.week : 1.month
  title = week ? "#{days.first.strftime(days.first.month == days.last.month ? "%-d" : "%-d %b")} – #{days.last.strftime("%-d %b %Y")}" : date.strftime("%B %Y")
%>
<section id="rubric_calendar" aria-label="Calendar" class="rounded-2xl border border-ink-900/10 bg-white p-4">
  <div class="mb-3 flex items-center gap-1">
    <h2 class="mr-auto font-manrope text-lg font-bold tracking-tight text-ink-900"><%= title %></h2>
    <%= link_to nav_link.(date - step), class: "rounded-lg p-1.5 text-ink-500 hover:bg-ink-900/5 hover:text-ink-900", aria: { label: "Previous #{week ? "week" : "month"}" } do %>
      <%= heroicon "chevron-left", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
    <% end %>
    <%= link_to "Today", nav_link.(Date.current), class: "rounded-lg px-2.5 py-1 text-sm font-medium text-ink-700 hover:bg-ink-900/5" %>
    <%= link_to nav_link.(date + step), class: "rounded-lg p-1.5 text-ink-500 hover:bg-ink-900/5 hover:text-ink-900", aria: { label: "Next #{week ? "week" : "month"}" } do %>
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <div class="grid min-w-2xl grid-cols-7 gap-px overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900/10">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |weekday| %>
        <div class="bg-white py-1.5 text-center text-xs font-medium uppercase tracking-wide text-ink-500"><%= weekday %></div>
      <% end %>
      <% days.each do |day| %>
        <% day_entries = by_day.fetch(day, []) %>
        <% shown = week ? day_entries : day_entries.first(4) %>
        <% in_range = week || day.month == date.month %>
        <div class="<%= week ? "min-h-64" : "min-h-28" %> p-1.5 <%= in_range ? "bg-white" : "bg-stone-50" %>">
          <div class="mb-1 text-right text-xs font-semibold tabular-nums <%= day == Date.current ? "text-rocket" : in_range ? "text-ink-700" : "text-ink-400" %>">
            <%= day.day %>
          </div>
          <ul class="space-y-1">
            <% shown.each do |time, rubric, post, media, short| %>
              <% shortage = "add #{rubric.reel? ? "videos" : "media"} to #{rubric.source}" if short %>
              <% aspect = !week ? "aspect-square" : rubric.post? ? "aspect-4/5" : "aspect-9/16" %>
              <% icon, tone, label = case post&.status
                   when "published" then [ "check", "bg-signal-green", "Published" ]
                   when "failed" then [ "x-mark", "bg-signal-red", "Failed" ]
                   when "scheduled" then [ "clock", "bg-ink-500", "Scheduled" ]
                   when "publishing" then [ "arrow-path", "bg-ink-500", "Publishing" ]
                   else short ? [ "exclamation-triangle", "bg-amber-500", "No fresh media" ]
                     : rubric.auto_publish? ? [ "clock", "bg-ink-500", "Scheduled" ] : [ "pause", "bg-ink-400", "Auto-publish off" ]
                   end %>
              <% badge = capture do %>
                <span role="img" aria-label="<%= label %>" class="flex size-4 shrink-0 items-center justify-center rounded-full text-white ring-1 ring-white <%= tone %>">
                  <%= heroicon icon, variant: :micro, options: { class: "size-3", "aria-hidden": true } %>
                </span>
              <% end %>
              <% thumb = media&.file&.representable? %>
              <li title="<%= [ time.strftime("%H:%M"), rubric.name.presence || "New rubric", rubric.format, label, post&.error_message, shortage ].compact.join(" · ") %>"
                  class="group overflow-hidden rounded-md border text-xs <%= AppHelper::NOTE_COLORS[rubric.color] %> <%= "border-dashed" if rubric.equal?(draft) %>">
                <% entry = capture do %>
                  <% if media || short %>
                    <div class="relative">
                      <% if thumb %>
                        <%= image_tag media.file.representation(:small), alt: "", class: "#{aspect} w-full object-cover" %>
                      <% else %>
                        <div class="<%= aspect %> flex items-center justify-center bg-ink-900/5 text-ink-400">
                          <%= heroicon "photo", options: { class: "size-5", "aria-hidden": true } %>
                        </div>
                      <% end %>
                      <div class="absolute top-1 right-1"><%= badge %></div>
                      <% if !post && media && rubric.persisted? && !rubric.changed? %>
                        <%= button_to rubric_posts_path(rubric), params: { scheduled_at: time.iso8601 }, form: { class: "absolute inset-x-1 bottom-1" },
                              class: "flex w-full items-center justify-center gap-1 rounded bg-white/90 p-1 font-medium text-ink-700 opacity-0 shadow-sm group-hover:opacity-100 group-focus-within:opacity-100 pointer-coarse:opacity-100 hover:bg-white hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-rocket",
                              title: "Keep this media for this time", aria: { label: "Lock in this post" } do %>
                          <%= heroicon "lock-closed", variant: :micro, options: { class: "size-3", "aria-hidden": true } %>
                          Lock in
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                  <div class="flex items-center gap-1 px-1 py-0.5">
                    <%= badge unless media || short %>
                    <span class="shrink-0 tabular-nums text-ink-500"><%= time.strftime("%H:%M") %></span>
                    <span class="truncate font-medium text-ink-900"><%= rubric.name.presence || "New rubric" %></span>
                  </div>
                <% end %>
                <%= post ? link_to(entry, rubric_post_path(rubric, post), class: "block hover:bg-ink-900/5") : entry %>
              </li>
            <% end %>
            <% if day_entries.size > shown.size %>
              <li class="px-1 text-xs text-ink-500">+<%= day_entries.size - shown.size %> more</li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
