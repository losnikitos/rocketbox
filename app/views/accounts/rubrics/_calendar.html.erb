<%# locals: (rubrics:, posts:, date:, days:, week:, draft: nil) %>
<%# Past days show what each rubric posted; the next month, what each is planned to post; later, only when. The draft (dashed) stands in for its saved self. %>
<%
  now = Time.current
  horizon = now + 1.month
  rubrics = rubrics.map { it.id && it.id == draft&.id ? draft : it }
  rubrics += [ draft ] if draft&.new_record?
  scheduled = rubrics.reject { it.errors[:schedule].any? }
  plan = Rubric.plan(scheduled, horizon)
  shortages = plan.reject(&:last).uniq { it[1] }
  entries = posts.map { [ it.created_at.in_time_zone, it.rubric, it, it.library_media, false ] }
  entries += plan.filter_map { |time, rubric, media, fresh| [ time, rubric, nil, media, !fresh ] if days.cover?(time.to_date) }
  later = [ days.first.beginning_of_day, horizon ].max..days.last.end_of_day
  if later.begin < later.end
    scheduled.each { |rubric| entries += rubric.occurrences(later).map { [ it, rubric, nil, nil, false ] } }
  end
  by_day = entries.sort_by(&:first).group_by { it.first.to_date }
  nav_link = ->(day) { url_for(request.query_parameters.merge("date" => day.iso8601)) }
  step = week ? 1.week : 1.month
  title = week ? "#{days.first.strftime(days.first.month == days.last.month ? "%-d" : "%-d %b")} – #{days.last.strftime("%-d %b %Y")}" : date.strftime("%B %Y")
%>
<section aria-label="Calendar" class="rounded-2xl border border-ink-900/10 bg-white p-4">
  <div class="mb-3 flex items-center gap-1">
    <h2 class="mr-auto font-manrope text-lg font-bold tracking-tight text-ink-900"><%= title %></h2>
    <%= link_to nav_link.(date - step), class: "rounded-lg p-1.5 text-ink-500 hover:bg-ink-900/5 hover:text-ink-900", aria: { label: "Previous #{week ? "week" : "month"}" } do %>
      <%= heroicon "chevron-left", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
    <% end %>
    <%= link_to "Today", nav_link.(Date.current), class: "rounded-lg px-2.5 py-1 text-sm font-medium text-ink-700 hover:bg-ink-900/5" %>
    <%= link_to nav_link.(date + step), class: "rounded-lg p-1.5 text-ink-500 hover:bg-ink-900/5 hover:text-ink-900", aria: { label: "Next #{week ? "week" : "month"}" } do %>
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-5", "aria-hidden": true } %>
    <% end %>
  </div>

  <% if shortages.any? %>
    <ul aria-label="Running short" class="mb-3 space-y-1 rounded-lg bg-signal-yellow/15 px-3 py-2 text-sm text-ink-900">
      <% shortages.each do |time, rubric, media, _fresh| %>
        <li class="flex items-start gap-1.5">
          <%= heroicon "exclamation-triangle", variant: :mini, options: { class: "mt-0.5 size-4 shrink-0 text-amber-500", "aria-hidden": true } %>
          <span>
            <span class="font-medium"><%= rubric.name.presence || "New rubric" %></span>
            <%= media ? "runs out of fresh media" : "has nothing to post" %> on <%= time.strftime("%a %-d %b") %>.
            Add more <%= rubric.reel? ? "videos" : "media" %> to <%= rubric.folder.path %>.
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="overflow-x-auto">
    <div class="grid min-w-2xl grid-cols-7 gap-px overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900/10">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |weekday| %>
        <div class="bg-white py-1.5 text-center text-xs font-medium uppercase tracking-wide text-ink-500"><%= weekday %></div>
      <% end %>
      <% days.each do |day| %>
        <% day_entries = by_day.fetch(day, []) %>
        <% shown = week ? day_entries : day_entries.first(4) %>
        <% in_range = week || day.month == date.month %>
        <div class="<%= week ? "min-h-64" : "min-h-28" %> p-1.5 <%= in_range ? "bg-white" : "bg-stone-50" %>">
          <div class="mb-1 text-right text-xs font-semibold tabular-nums <%= day == Date.current ? "text-rocket" : in_range ? "text-ink-700" : "text-ink-400" %>">
            <%= day.day %>
          </div>
          <ul class="space-y-1">
            <% shown.each do |time, rubric, post, media, short| %>
              <% shortage = (media ? "repeat" : "no media in #{rubric.folder.path}") if short %>
              <% aspect = !week ? "aspect-square" : rubric.post? ? "aspect-4/5" : "aspect-9/16" %>
              <li title="<%= [ time.strftime("%H:%M"), rubric.name.presence || "New rubric", rubric.format, post&.status, post&.error_message, shortage ].compact.join(" · ") %>"
                  class="overflow-hidden rounded-md border text-xs <%= AppHelper::NOTE_COLORS[rubric.color] %> <%= "border-dashed" if rubric.equal?(draft) %> <%= "opacity-50" unless post || rubric.auto_publish? %>">
                <% if media&.file&.representable? %>
                  <%= image_tag media.file.representation(:small), alt: "", class: "#{aspect} w-full object-cover" %>
                <% end %>
                <div class="flex items-center gap-1 px-1 py-0.5">
                  <% if post %>
                    <%= heroicon post.status == "failed" ? "x-mark" : "check", variant: :micro,
                          options: { class: "size-3 shrink-0 #{post.status == "failed" ? "text-signal-red" : "text-ink-500"}", "aria-hidden": true } %>
                  <% elsif short %>
                    <%= heroicon "exclamation-triangle", variant: :micro, options: { class: "size-3 shrink-0 text-amber-500", "aria-hidden": true } %>
                  <% end %>
                  <span class="shrink-0 tabular-nums text-ink-500"><%= time.strftime("%H:%M") %></span>
                  <span class="truncate font-medium text-ink-900"><%= rubric.name.presence || "New rubric" %></span>
                </div>
              </li>
            <% end %>
            <% if day_entries.size > shown.size %>
              <li class="px-1 text-xs text-ink-500">+<%= day_entries.size - shown.size %> more</li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
