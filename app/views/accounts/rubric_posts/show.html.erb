<% content_for(:title, "#{@rubric.name} — #{@post.scheduled_at.strftime("%-d %b")} — Rocketbox") %>
<% media = @post.library_media %>
<% content_for(:header_actions) { render "shared/admin_links/rubric_post", rubric_post: @post } %>

<% content_for(:breadcrumbs) do %>
  <%= link_to edit_rubric_path(@rubric), class: "inline-flex items-center gap-1 text-sm text-ink-600 hover:text-ink-900" do %>
    <%= heroicon "arrow-left", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    <%= @rubric.name %>
  <% end %>
<% end %>

<div class="grid items-start gap-6 md:grid-cols-2">
  <div class="flex justify-center rounded-2xl border border-ink-900/10 bg-white p-6">
    <% if media %>
      <%= render "accounts/library/file", media:, controls: true, css: "max-h-[70vh] max-w-full rounded-lg object-contain" %>
    <% else %>
      <p class="py-24 text-sm text-ink-500">Media deleted</p>
    <% end %>
  </div>

  <div class="space-y-4 rounded-2xl border border-ink-900/10 bg-white p-6">
    <div class="flex items-center gap-2">
      <span class="size-3 shrink-0 rounded-full border-2 <%= AppHelper::NOTE_COLORS[@rubric.color] %>" aria-hidden="true"></span>
      <h2 class="mr-auto font-manrope text-lg font-bold tracking-tight text-ink-900">
        <%= link_to @rubric.name, edit_rubric_path(@rubric), class: "hover:underline" %>
      </h2>
      <span class="<%= rubric_post_status_pill_class(@post.status) %>"><%= @post.status.capitalize %></span>
    </div>

    <dl class="space-y-2 text-sm">
      <% [
           [ @post.published_at ? "Published" : "Scheduled for", (@post.published_at || @post.scheduled_at).strftime("%a %-d %b, %H:%M") ],
           [ "Format", @rubric.format.capitalize ],
           [ "From", @rubric.source ]
         ].each do |label, value| %>
        <div>
          <dt class="text-ink-500"><%= label %></dt>
          <dd class="mt-0.5 text-ink-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <% if @post.error_message %>
      <p class="text-sm text-signal-red"><%= @post.error_message %></p>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <% unless @post.published_at %>
        <%= button_to publish_rubric_post_path(@rubric, @post),
              class: "rb-btn-primary gap-1.5 px-3.5 py-1.5 text-sm" do %>
          <%= heroicon "paper-airplane", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          <%= @post.status == "failed" ? "Retry" : "Publish now" %>
        <% end %>
      <% end %>
      <% if media %>
        <%= link_to "Open media", library_item_path(media), class: "rb-btn-ghost-on-light px-3.5 py-1.5 text-sm" %>
      <% end %>
    </div>
  </div>
</div>
