<% content_for(:title, "Jobs — Rocketbox") %>

<% if @jobs.any? %>
  <ul class="flex flex-wrap items-start gap-3 pb-24">
    <% @jobs.each do |job| %>
      <li id="<%= dom_id(job) %>" data-move-job="<%= job.id %>"
          class="max-w-full space-y-3 rounded-2xl border border-ink-900/10 bg-white p-3 data-drop-over:border-rocket data-drop-over:bg-rocket/5 data-drop-over:outline-2 data-drop-over:outline-rocket">
        <%# w-0 min-w-full: a long name truncates instead of widening the card past its thumbs. %>
        <div class="flex w-0 min-w-full items-center gap-2">
          <%= render "accounts/jobs/job", job: %>
          <span class="truncate text-sm font-medium text-ink-900"><%= job.name %></span>
        </div>
        <ul aria-label="Media" class="flex flex-wrap gap-2">
          <% job.library_media.sort_by(&:created_at).each do |media| %>
            <li class="w-40">
              <%= link_to library_item_path(media), class: "block", draggable: "true",
                    data: { move_url: library_media_path(media), move_attr: "data-move-job", move_field: "library_media[job_id]", move_from: job.id } do %>
                <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full rounded-lg object-cover", play: true %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>

  <div data-move-job="new"
       class="fixed bottom-6 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 rounded-2xl border-2 border-dashed border-ink-900/20 bg-white/90 px-6 py-4 text-sm font-medium text-ink-600 shadow-lg backdrop-blur data-drop-over:border-rocket data-drop-over:bg-rocket/10 data-drop-over:text-rocket">
    <%= heroicon "plus", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Drop here for a new job
  </div>
<% else %>
  <p class="text-sm text-ink-600">No jobs yet.</p>
<% end %>
