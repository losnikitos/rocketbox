<% content_for(:title, "Jobs — Rocketbox") %>

<% if @jobs.any? %>
  <% content_for(:header_actions) do %>
    <%= button_tag type: :submit, form: "merge-jobs", class: "rb-btn-ghost-on-light cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm" do %>
      <%= heroicon "arrows-pointing-in", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Merge selected
    <% end %>
  <% end %>
<% end %>

<div class="mx-auto max-w-3xl">
  <% if @jobs.any? %>
    <%= form_with url: merge_jobs_path, id: "merge-jobs" do %>
      <ul class="divide-y divide-ink-900/5 rounded-2xl border border-ink-900/10 bg-white">
        <% @jobs.each do |job| %>
          <li id="<%= dom_id(job) %>" class="flex items-center gap-4 p-4 has-checked:bg-rocket/5">
            <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
              <%= check_box_tag "job_ids[]", job.id, false, id: nil, class: "size-4 shrink-0 accent-rocket" %>
              <%= render "accounts/jobs/job", job: %>
              <span class="truncate text-sm font-medium text-ink-900"><%= job.name %></span>
            </label>
            <ul aria-label="Media" class="flex max-w-1/2 flex-wrap justify-end gap-1.5">
              <% job.library_media.sort_by(&:created_at).each do |media| %>
                <li>
                  <%= link_to library_item_path(media), class: "block w-12 overflow-hidden rounded-md" do %>
                    <%= render "accounts/library/file", media:, variant: :small, css: "aspect-2/3 w-full object-cover" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% else %>
    <p class="text-sm text-ink-600">No jobs yet.</p>
  <% end %>
</div>
