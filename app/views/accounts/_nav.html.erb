<%# locals: (current:) %>
<nav class="sm:w-44 sm:shrink-0" aria-label="Account sections">
  <ul class="flex gap-1 sm:flex-col sm:gap-0.5">
    <% [
      [library_path, "Library", current == :library],
      [settings_path, "Settings", current == :settings],
      [integrations_path, "Integrations", current == :integrations],
      [subscription_path, "Subscription", current == :subscription]
    ].each do |path, label, active| %>
      <li class="min-w-0 flex-1 sm:flex-none">
        <%= link_to label,
              path,
              class: [
                "block rounded-[10px] px-3 py-2 text-center text-sm font-medium transition hover:bg-ink-900/5 sm:text-left",
                (active ? "bg-rocket/15 text-ink-900" : "text-ink-700"),
              ].join(" "),
              aria: { current: (active ? "page" : nil) } %>
      </li>
    <% end %>
  </ul>
</nav>
