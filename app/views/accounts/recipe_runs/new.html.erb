<% content_for(:title, "#{@recipe.name} — Recipes — Rocketbox") %>

<%= render "accounts/recipes/header", recipe: @recipe %>

<%= form_with url: recipe_runs_path(@recipe), class: "mt-6 max-w-4xl space-y-6" do |f| %>
  <% if @error %>
    <p class="<%= tw_alert_error_classes %>" role="alert"><%= @error %></p>
  <% end %>

  <div class="flex flex-wrap items-start gap-6">
    <% @slots.each_with_index do |(collection, slot_tag, photos), index| %>
      <fieldset data-controller="media-pick" class="group w-36">
        <legend class="<%= tw_label_classes %>"><%= index + 1 %>. <%= slot_tag&.name || "Unknown tag" %> <span class="text-ink-500">· <%= collection.humanize %></span></legend>
        <% if photos.any? %>
          <% selected = photos.find { it.id.to_s == params.dig(:media_ids, index.to_s) } || photos.first %>
          <% popover_id = "media-pick-#{index}" %>
          <div class="space-y-2">
            <button type="button" popovertarget="<%= popover_id %>" style="anchor-name: --<%= popover_id %>"
                    aria-label="Choose <%= slot_tag&.name&.downcase || "media" %>"
                    class="flex w-full cursor-pointer items-center justify-between gap-1 rounded-xl border border-ink-900/10 bg-white p-1.5 transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
              <span data-media-pick-target="preview" class="block size-24 shrink-0 overflow-hidden rounded-lg">
                <%= render "accounts/library/file", media: selected, css: "aspect-square w-full object-cover" %>
              </span>
              <%= heroicon "chevron-down", options: { class: "size-5 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
            </button>
            <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light w-full justify-center gap-1.5 px-3 py-1.5">
              <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              Random
            </button>
          </div>
          <div id="<%= popover_id %>" popover data-media-pick-target="popover"
               style="position-anchor: --<%= popover_id %>"
               class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-96 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-2 shadow-lg">
            <div class="grid grid-cols-4 gap-2">
              <% photos.each do |media| %>
                <label class="block cursor-pointer overflow-hidden rounded-lg border border-ink-900/15 transition hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                  <%= radio_button_tag "media_ids[#{index}]", media.id, media == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                  <%= render "accounts/library/file", media:, css: "aspect-square w-full object-cover" %>
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
            No <%= slot_tag&.name&.downcase || "matching" %> photos in <%= collection.humanize %>.
            <%= link_to "Add some", library_collection_path(collection, tag: slot_tag&.slug), class: "underline hover:text-ink-900" %>
          </p>
        <% end %>
      </fieldset>
    <% end %>

    <% if @shots %>
      <fieldset data-controller="media-pick" class="group w-64">
        <legend class="<%= tw_label_classes %>">Shot</legend>
        <% if @shots.any? %>
          <% selected = @shots.find { it.id.to_s == params[:shot_id] } || @shots.sample %>
          <div class="space-y-2">
            <button type="button" popovertarget="shot-pick" style="anchor-name: --shot-pick" aria-label="Choose shot"
                    class="flex w-full cursor-pointer items-center gap-1 rounded-xl border border-ink-900/10 bg-white px-2.5 py-1.5 text-left transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
              <span data-media-pick-target="preview" class="min-w-0 flex-1">
                <%= render "shot_option", shot: selected %>
              </span>
              <%= heroicon "chevron-down", options: { class: "size-5 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
            </button>
            <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light w-full justify-center gap-1.5 px-3 py-1.5">
              <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              Random
            </button>
          </div>
          <div id="shot-pick" popover data-media-pick-target="popover" style="position-anchor: --shot-pick"
               class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-80 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-1 shadow-lg">
            <% @shots.each do |shot| %>
              <label class="block cursor-pointer rounded-lg px-3 py-2 transition hover:bg-ink-900/5 has-checked:bg-rocket/10 has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                <%= radio_button_tag :shot_id, shot.id, shot == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                <%= render "shot_option", shot: %>
              </label>
            <% end %>
          </div>
        <% else %>
          <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
            No <%= @recipe.shot_group %> shots yet.
            <%= link_to "Add some", shots_path(group: @recipe.shot_group), class: "underline hover:text-ink-900" %>
          </p>
        <% end %>
      </fieldset>
    <% end %>
  </div>

  <details class="group">
    <summary class="inline-flex cursor-pointer items-center gap-1 text-sm font-medium text-ink-700 hover:text-ink-900">
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
      Prompt
    </summary>
    <div class="mt-1 space-y-1 rounded-2xl border border-ink-900/10 bg-white p-6">
      <h2 class="text-sm font-semibold text-ink-900"><%= @recipe.name %></h2>
      <p class="text-sm whitespace-pre-line text-ink-600"><%= @recipe.body %></p>
    </div>
  </details>

  <div class="max-w-xl">
    <%= label_tag "recipe_run_extra_prompt", "Extra prompt", class: tw_label_classes %>
    <%= text_area_tag "recipe_run[extra_prompt]", @run.extra_prompt, rows: 3, placeholder: "Added after the recipe prompt", class: tw_input_classes %>
  </div>

  <details class="group">
    <summary class="inline-flex cursor-pointer items-center gap-1 text-sm font-medium text-ink-700 hover:text-ink-900">
      <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
      Options
    </summary>
    <div class="mt-3 max-w-xl">
      <%= render "shared/generation_options", record: @run, scope: "recipe_run", refresh_url: new_recipe_run_path(@recipe) %>
    </div>
  </details>

  <%= f.button class: "rb-btn-primary gap-1.5 px-3.5 py-2 text-sm" do %>
    <%= heroicon "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
    Generate
  <% end %>
<% end %>

<% if @made.any? %>
  <section class="mt-10 max-w-4xl">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h2 class="text-sm font-semibold text-ink-900">Made with <%= @recipe.name %></h2>
      <% if @recipe.output_collection == "ready" %>
        <%= link_to "View all", library_ready_path(recipe: @recipe.id), class: "text-sm text-ink-600 underline hover:text-ink-900" %>
      <% end %>
    </div>
    <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      <% @made.limit(24).each do |media| %>
        <li class="min-w-0">
          <%= link_to library_item_path(media), aria: { label: "Open #{media.kind}" }, class: "block overflow-hidden rounded-lg border border-ink-900/10 transition hover:border-ink-900/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
            <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
