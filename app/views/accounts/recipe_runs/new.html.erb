<% content_for(:title, "#{@recipe.name} — Recipes — Rocketbox") %>
<% island = "space-y-4 rounded-2xl border border-ink-900/10 bg-stone-50 p-6" %>
<% island_title = "scroll-m-24 text-base font-semibold text-ink-900" %>

<%= render layout: "accounts/recipes/header", locals: { recipe: @recipe } do %>
  <h1 class="text-2xl font-semibold text-ink-900"><%= @recipe.name %></h1>
  <% if @recipe.examples.any? %>
    <ul aria-label="Examples" class="flex flex-wrap gap-2">
      <% @recipe.examples.each do |example| %>
        <li><%= render "accounts/recipes/example", example:, css: "aspect-2/3 w-20 rounded-lg object-cover" %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%= form_with url: recipe_runs_path(@recipe), class: "@container mt-6 space-y-6" do |f| %>
  <% if @error %>
    <p class="<%= tw_alert_error_classes %>" role="alert"><%= @error %></p>
  <% end %>

  <div class="grid grid-cols-1 items-start gap-6 @4xl:grid-cols-3">
    <section class="space-y-2">
      <h2 id="input" class="<%= island_title %>"><a href="#input" class="hover:underline">Input</a></h2>
      <div class="<%= island %>">
        <% picked = @slots.each_with_index.map { |(_, photos), index| photos.find { it.id.to_s == params.dig(:media_ids, index.to_s) } } %>
        <% @slots.each_with_index do |(folder, photos), index| %>
          <fieldset data-controller="media-pick" class="group min-w-0">
            <legend class="<%= tw_label_classes %>"><%= index + 1 %>. <%= render "accounts/recipes/slot", folder: %></legend>
            <% if photos.any? %>
              <% selected = picked[index] ||= (photos - picked).sample || photos.sample %>
              <% popover_id = "media-pick-#{index}" %>
              <div class="flex gap-2">
                <button type="button" popovertarget="<%= popover_id %>" style="anchor-name: --<%= popover_id %>"
                        aria-label="Choose <%= folder&.name&.downcase || "media" %>"
                        class="flex min-w-0 flex-1 cursor-pointer items-center justify-between gap-1 rounded-xl border border-ink-900/10 bg-white p-1.5 transition hover:border-ink-900/20 focus-visible:ring-2 focus-visible:ring-rocket/30">
                  <span data-media-pick-target="preview" class="block size-14 shrink-0 overflow-hidden rounded-lg">
                    <%= render "accounts/library/file", media: selected, css: "aspect-square w-full object-cover" %>
                  </span>
                  <%= heroicon "chevron-down", options: { class: "size-5 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
                </button>
                <button type="button" data-action="media-pick#random" class="rb-btn-ghost-on-light shrink-0 gap-1.5 px-3 py-1.5">
                  <%= heroicon "arrow-path", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
                  Random
                </button>
              </div>
              <div id="<%= popover_id %>" popover data-media-pick-target="popover"
                   style="position-anchor: --<%= popover_id %>"
                   class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-96 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-2 shadow-lg">
                <div class="grid grid-cols-4 gap-2">
                  <% photos.each do |media| %>
                    <label class="block cursor-pointer overflow-hidden rounded-lg border border-ink-900/15 transition hover:border-ink-900/30 has-checked:outline-2 has-checked:-outline-offset-2 has-checked:outline-white has-checked:ring-2 has-checked:ring-rocket has-focus-visible:ring-2 has-focus-visible:ring-rocket/30">
                      <%= radio_button_tag "media_ids[#{index}]", media.id, media == selected, class: "sr-only", data: { media_pick_target: "radio", action: "media-pick#pick" } %>
                      <%= render "accounts/library/file", media:, css: "aspect-square w-full object-cover" %>
                    </label>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="rounded-lg bg-ink-900/5 px-3 py-2 text-sm text-ink-600">
                No media in <%= render "accounts/recipes/slot", folder: %>.
                <%= link_to "Add some", folder_path(folder), class: "underline hover:text-ink-900" if folder %>
              </p>
            <% end %>
          </fieldset>
        <% end %>
        <% if @styles %>
          <%= render "pick", name: :style_id, label: "Style", items: @styles,
                selected: @styles.find { it.id.to_s == params[:style_id] } || @styles.sample,
                empty: safe_join([ "No styles yet. ", link_to("Add some", styles_path, class: "underline hover:text-ink-900") ]) %>
        <% end %>
        <% if @shots %>
          <%= render "pick", name: :shot_id, label: "Shot", items: @shots,
                selected: @shots.find { it.id.to_s == params[:shot_id] } || @shots.sample,
                empty: safe_join([ "No #{@recipe.shot_group} shots yet. ", link_to("Add some", shots_path(group: @recipe.shot_group), class: "underline hover:text-ink-900") ]) %>
        <% end %>
      </div>
    </section>

    <section class="space-y-2">
      <h2 id="processing" class="<%= island_title %>"><a href="#processing" class="hover:underline">Processing</a></h2>
      <div class="<%= island %>">
        <% if @recipe.stitch? %>
          <p class="text-sm text-ink-600">Each input plays for 1 second, in order.</p>
        <% else %>
          <details class="group">
            <summary class="inline-flex cursor-pointer items-center gap-1 text-sm font-medium text-ink-700 hover:text-ink-900">
              <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
              Prompt
            </summary>
            <div class="mt-1 space-y-1 rounded-2xl border border-ink-900/10 bg-white p-6">
              <h3 class="text-sm font-semibold text-ink-900"><%= @recipe.name %></h3>
              <p class="text-sm whitespace-pre-line text-ink-600"><%= @recipe.body %></p>
            </div>
          </details>

          <div>
            <%= label_tag "recipe_run_extra_prompt", "Extra prompt", class: tw_label_classes %>
            <%= text_area_tag "recipe_run[extra_prompt]", @run.extra_prompt, rows: 3, placeholder: "Added after the recipe prompt", class: tw_input_classes %>
          </div>

          <details class="group">
            <summary class="inline-flex cursor-pointer items-center gap-1 text-sm font-medium text-ink-700 hover:text-ink-900">
              <%= heroicon "chevron-right", variant: :mini, options: { class: "size-4 transition group-open:rotate-90", "aria-hidden": true } %>
              Options
            </summary>
            <div class="mt-3">
              <%= render "shared/generation_options", record: @run, scope: "recipe_run", refresh_url: new_recipe_run_path(@recipe) %>
            </div>
          </details>
        <% end %>
      </div>
    </section>

    <section class="space-y-2">
      <h2 id="output" class="<%= island_title %>"><a href="#output" class="hover:underline">Output</a></h2>
      <div class="<%= island %>">
        <%= f.button class: "rb-btn-primary w-full justify-center gap-1.5 px-3.5 py-2 text-sm" do %>
          <%= heroicon @recipe.stitch? ? "scissors" : "sparkles", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
          <%= @recipe.stitch? ? "Stitch" : "Generate" %>
        <% end %>
        <p class="flex items-center gap-1.5 text-sm text-ink-600">
          Saves to <%= link_to render("accounts/recipes/slot", folder: @recipe.output_folder), folder_path(@recipe.output_folder), class: "inline-flex rounded-full hover:*:border-ink-900/30" %>
        </p>

        <div class="flex items-baseline justify-between gap-3">
          <h2 class="text-sm font-semibold text-ink-900">Made with <%= @recipe.name %></h2>
          <% if @made.any? %>
            <%= link_to "View all", folder_path(@recipe.output_folder, recipe: @recipe.id), class: "text-sm text-ink-600 underline hover:text-ink-900" %>
          <% end %>
        </div>
        <% if @made.any? %>
          <ul class="grid grid-cols-3 gap-3">
            <% @made.limit(24).each do |media| %>
              <li class="min-w-0">
                <%= link_to library_item_path(media), aria: { label: "Open #{media.kind}" }, class: "block overflow-hidden rounded-lg border border-ink-900/10 transition hover:border-ink-900/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket" do %>
                  <%= render "accounts/library/file", media:, css: "aspect-2/3 w-full object-cover" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-ink-500">Nothing made yet.</p>
        <% end %>
      </div>
    </section>
  </div>
<% end %>
