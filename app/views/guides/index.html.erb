<% content_for(:title, "Guides — Rocketbox") %>

<section class="pb-12 pt-4 lg:pb-16 lg:pt-2">
  <h1 class="mt-6 font-manrope text-[clamp(2.5rem,6vw,5.5rem)] font-extrabold leading-[1.02] tracking-[-0.035em] text-ink-900 text-balance">
    Guides
  </h1>
  <p class="mt-6 max-w-xl text-[17px] font-medium leading-relaxed text-ink-500">
    Online handbooks for keeping the shop sharp — brand, look, and day-to-day standards. Open a cover to read the promo, then start a chapter.
  </p>
</section>

<section class="border-t border-ink-900/10 py-12 lg:py-16" aria-labelledby="guides-shelf-heading">
  <h2 id="guides-shelf-heading" class="sr-only">Bookshelf</h2>
  <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
    <% @guides.each do |guide| %>
      <li>
        <%= link_to guide_path(guide), class: "group block no-underline" do %>
          <div class="origin-bottom group-hover:-translate-y-1 group-hover:rotate-1">
            <%= render "guides/cover", guide: guide, size: :shelf %>
          </div>
          <div class="mt-4 flex items-start justify-between gap-3">
            <div>
              <p class="font-manrope text-xl font-extrabold tracking-[-0.03em] text-ink-900 group-hover:text-rocket"><%= guide.title %></p>
              <p class="mt-1 text-[15px] font-medium leading-relaxed text-ink-500"><%= guide.lede %></p>
            </div>
            <%= render "guides/access_badge", guide: guide %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
