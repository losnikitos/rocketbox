<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Monitor — Rocketbox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white font-sans text-ink-900 antialiased">
    <div class="flex min-h-screen">
      <input type="checkbox" id="monitor-nav-toggle" class="peer sr-only">

      <aside class="hidden w-56 shrink-0 flex-col border-r border-ink-900/10 max-sm:peer-checked:flex sm:flex sm:sticky sm:top-0 sm:h-screen">
        <div class="px-4 pt-5">
          <%= link_to "← Rocketbox", root_path, class: "text-xs font-medium text-ink-500 hover:text-ink-900" %>
          <p class="mt-1 font-manrope text-base font-bold">Monitor</p>
        </div>

        <nav aria-label="Monitor" class="mt-4 flex-1 px-2">
          <ul class="flex flex-col gap-0.5">
            <li>
              <%= link_to "Overview",
                    monitor_path,
                    class: [
                      "block rounded-[10px] px-3 py-2 text-sm font-medium transition hover:bg-ink-900/5",
                      (current_page?(monitor_path) ? "bg-rocket/15 text-ink-900" : "text-ink-700"),
                    ].join(" "),
                    aria: { current: (current_page?(monitor_path) ? "page" : nil) } %>
            </li>
            <li>
              <%= link_to "Media generations",
                    monitor_media_generations_path,
                    class: [
                      "block rounded-[10px] px-3 py-2 text-sm font-medium transition hover:bg-ink-900/5",
                      (controller_name == "monitor_media_generations" ? "bg-rocket/15 text-ink-900" : "text-ink-700"),
                    ].join(" "),
                    aria: { current: (controller_name == "monitor_media_generations" ? "page" : nil) } %>
            </li>
            <li>
              <%= link_to "Jobs",
                    "/jobs",
                    class: "block rounded-[10px] px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5" %>
            </li>
          </ul>
        </nav>

        <div class="border-t border-ink-900/10 px-4 py-3">
          <%= link_to "Admin", "/admin", class: "text-xs font-medium text-ink-500 hover:text-ink-900" %>
        </div>
      </aside>

      <div class="min-w-0 flex-1 bg-stone-50">
        <header class="border-b border-ink-900/10 bg-white">
          <div class="flex items-center gap-3 px-4 pt-3 sm:px-6">
            <label for="monitor-nav-toggle" class="rb-btn-ghost-on-light cursor-pointer px-3 py-1.5 text-xs sm:hidden">
              Menu
            </label>
            <h1 class="font-manrope text-lg font-bold">Monitor</h1>
            <p class="ml-auto truncate text-xs text-ink-500"><%= Current.user&.email %></p>
          </div>
          <nav aria-label="Sections" class="mt-2 flex gap-4 px-4 sm:px-6">
            <%= link_to "Overview",
                  monitor_path,
                  class: [
                    "-mb-px border-b-2 pb-2 text-sm font-medium",
                    (current_page?(monitor_path) ? "border-rocket text-ink-900" : "border-transparent text-ink-500 hover:text-ink-900"),
                  ].join(" "),
                  aria: { current: (current_page?(monitor_path) ? "page" : nil) } %>
            <%= link_to "Media generations",
                  monitor_media_generations_path,
                  class: [
                    "-mb-px border-b-2 pb-2 text-sm font-medium",
                    (controller_name == "monitor_media_generations" ? "border-rocket text-ink-900" : "border-transparent text-ink-500 hover:text-ink-900"),
                  ].join(" "),
                  aria: { current: (controller_name == "monitor_media_generations" ? "page" : nil) } %>
            <%= link_to "Jobs",
                  "/jobs",
                  class: "-mb-px border-b-2 border-transparent pb-2 text-sm font-medium text-ink-500 hover:text-ink-900" %>
          </nav>
        </header>

        <main class="px-4 py-6 sm:px-6">
          <%= yield %>
        </main>
      </div>
    </div>
    <%= render "shared/flashes" %>
  </body>
</html>
