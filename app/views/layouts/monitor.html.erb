<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Monitor — Rocketbox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white font-sans text-ink-900 antialiased">
    <div class="flex min-h-screen">
      <input type="checkbox" id="monitor-nav-toggle" class="peer sr-only">

      <aside class="hidden w-56 shrink-0 flex-col border-r border-ink-900/10 max-sm:peer-checked:flex sm:flex sm:sticky sm:top-0 sm:h-screen">
        <div class="px-4 pt-5">
          <%= link_to "← Rocketbox", root_path, class: "text-xs font-medium text-ink-500 hover:text-ink-900" %>
          <p class="mt-1 font-manrope text-base font-bold">Monitor</p>
        </div>

        <nav aria-label="Monitor" class="mt-4 flex-1 px-2">
          <ul class="flex flex-col gap-0.5">
            <li>
              <%= link_to "Overview",
                    monitor_path,
                    class: "block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-rocket/15 aria-selected:text-ink-900",
                    aria: { selected: current_page?(monitor_path) } %>
            </li>
            <li>
              <%= link_to "Media generations",
                    monitor_media_generations_path,
                    class: "block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-rocket/15 aria-selected:text-ink-900",
                    aria: { selected: controller_name == "monitor_media_generations" } %>
            </li>
            <li class="my-2 border-t border-ink-900/10" aria-hidden="true"></li>
            <li>
              <%= link_to "/jobs",
                    class: "flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                Jobs
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
            <li>
              <%= link_to "/admin",
                    class: "flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                Active Admin
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
          </ul>
        </nav>
      </aside>

      <div class="min-w-0 flex-1 bg-stone-50">
        <header class="border-b border-ink-900/10 bg-white">
          <div class="flex items-center gap-3 px-4 pt-3 sm:px-6">
            <label for="monitor-nav-toggle" class="rb-btn-ghost-on-light cursor-pointer px-3 py-1.5 text-xs sm:hidden">
              Menu
            </label>
            <% if content_for?(:heading) %>
              <%= yield :heading %>
            <% else %>
              <h1 class="font-manrope text-lg font-bold">
                <%= controller_name == "monitor_media_generations" ? "Media generations" : "Overview" %>
              </h1>
            <% end %>
            <p class="ml-auto truncate text-xs text-ink-500"><%= Current.user&.email %></p>
          </div>
          <nav aria-label="Subsections" class="mt-2 flex gap-4 px-4 sm:px-6">
            <span class="-mb-px border-b-2 border-rocket pb-2 text-sm font-medium text-ink-900" aria-current="page">Main</span>
            <span class="-mb-px border-b-2 border-transparent pb-2 text-sm font-medium text-ink-300" aria-disabled="true">Details</span>
            <span class="-mb-px border-b-2 border-transparent pb-2 text-sm font-medium text-ink-300" aria-disabled="true">History</span>
          </nav>
        </header>

        <main class="px-4 py-6 sm:px-6">
          <%= yield %>
        </main>
      </div>
    </div>
    <%= render "shared/flashes" %>
  </body>
</html>
