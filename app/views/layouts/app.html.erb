<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rocketbox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rocketbox">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "swiper-bundle.min", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% section, title, tabs = app_nav %>
  <body class="min-h-screen bg-ink-900/[0.03] font-sans text-ink-900 antialiased">
    <div class="flex min-h-screen" data-controller="drag-move"
         data-action="dragstart->drag-move#start dragover->drag-move#over dragleave->drag-move#leave drop->drag-move#drop dragend->drag-move#end">
      <input type="checkbox" id="app-nav-toggle" class="peer sr-only">

      <aside class="hidden w-60 shrink-0 flex-col max-sm:peer-checked:flex sm:flex sm:sticky sm:top-0 sm:h-screen sm:py-4 sm:pl-3">
        <div class="px-3 pt-2">
          <%= render "shared/logo" %>
        </div>

        <%= render "layouts/app/primary_nav", section: section %>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col px-3 py-3 sm:px-4 sm:py-4 sm:pl-2 <%= "md:h-screen" if content_for?(:fit) %>">
        <header class="flex flex-wrap items-center gap-3 px-1 pt-2 <%= tabs.any? ? "pb-3" : "pb-0" %> sm:px-2">
          <label for="app-nav-toggle" class="rb-btn-ghost-on-light cursor-pointer px-3 py-1.5 text-xs sm:hidden">
            Menu
          </label>
          <% if content_for?(:heading) %>
            <%= yield :heading %>
          <% else %>
            <h1 class="font-manrope text-xl font-bold tracking-tight sm:text-2xl"><%= title %></h1>
          <% end %>
          <% if content_for?(:header_actions) %>
            <div class="ml-auto flex items-center gap-2"><%= yield :header_actions %></div>
          <% end %>
        </header>

        <% if tabs.any? %>
          <%= render "layouts/app/secondary_nav", tabs: tabs %>
        <% end %>

        <% if content_for?(:breadcrumbs) %>
          <div class="mt-2 flex shrink-0 items-center justify-between gap-2 px-1 sm:px-2"><%= yield :breadcrumbs %></div>
        <% end %>

        <div class="mt-3 flex min-h-0 flex-1 gap-3 <%= "max-md:flex-col" if content_for?(:aside) %>">
          <main class="<%= "rb-surface-raised #{content_for?(:fit) ? "p-3 sm:p-4 md:p-0" : "p-5 sm:p-6 lg:p-8"}" unless content_for?(:bare) %> <%= "md:flex md:min-h-0 md:flex-col" if content_for?(:fit) %> min-w-0 flex-1 transition-colors data-[dragging]:bg-rocket/5 data-[dragging]:ring-2 data-[dragging]:ring-inset data-[dragging]:ring-rocket">
            <%= yield %>
          </main>

          <% if content_for?(:aside) %>
            <aside class="flex shrink-0 flex-col gap-3 md:w-96 md:overflow-y-auto lg:w-108">
              <%= yield :aside %>
            </aside>
          <% end %>
        </div>
      </div>
    </div>
    <%= render "shared/flashes" %>
    <%= render "shared/env_switcher" %>
  </body>
</html>
