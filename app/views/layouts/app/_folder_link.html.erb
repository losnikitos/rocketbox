<%# locals: (folder:, current_folder:, count:) %>
<%= link_to folder_path(folder),
      class: "flex min-w-0 flex-1 items-center gap-2 rounded-xl py-1.5 pr-3 text-sm font-medium text-ink-500 transition hover:bg-ink-900/5 aria-[current=page]:bg-ink-900/5 aria-[current=page]:text-ink-900 data-drop-over:bg-rocket/10 data-drop-over:outline-2 data-drop-over:outline-rocket #{folder.root? ? "pl-3" : "pl-9"}",
      aria: { current: ("page" if folder == current_folder) },
      data: { folder_id: folder.id, move_to: (folder.id if Current.user&.admin? && current_folder && folder != current_folder) } do %>
  <%= heroicon "folder", variant: :micro, options: { class: "size-4 shrink-0 #{folder_color(folder)}", "aria-hidden": true } %>
  <span class="truncate"><%= folder.name %></span>
  <span class="-ml-1 shrink-0 text-[10px] tabular-nums text-ink-300"><%= count %></span>
<% end %>
