<%# locals: (section:) %>
<% if Current.user&.admin? %>
  <div class="mt-4 px-2">
    <%= form_with url: request.path, method: :get do %>
      <label for="account_user_id" class="mb-1 block text-xs font-medium text-ink-500">Customer</label>
      <select name="account" id="account_user_id" onchange="this.form.requestSubmit()"
              class="flex w-full items-center gap-2 rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-left text-sm text-ink-900 [appearance:base-select] focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30 [&::picker(select)]:mt-1 [&::picker(select)]:rounded-lg [&::picker(select)]:border [&::picker(select)]:border-ink-900/15 [&::picker(select)]:[appearance:base-select]">
        <button class="min-w-0 flex-1 text-left"><selectedcontent class="flex min-w-0 items-center gap-2"></selectedcontent></button>
        <% User.with_attached_logo.order(:business_name, :email).each do |user| %>
          <option value="<%= user.id %>" <%= "selected" if user.id == Current.account.id %>
                  class="min-w-0 flex items-center gap-2 px-2.5 py-1 checked:bg-ink-900/5 hover:bg-ink-900/5 focus:bg-ink-900/5 [&::checkmark]:hidden">
            <% if user.logo.attached? %>
              <%= image_tag user.logo.variant(resize_to_limit: [ 64, 64 ]), alt: "", class: "size-7 shrink-0 rounded-md object-contain" %>
            <% else %>
              <span class="size-7 shrink-0 rounded-md bg-ink-900/5"></span>
            <% end %>
            <span class="flex min-w-0 flex-col">
              <span class="truncate font-medium"><%= user.business_name.presence || user.account_label %></span>
              <span class="truncate text-xs text-ink-500"><%= [ ("+#{user.whatsapp_phone}" if user.whatsapp_phone), user.email ].compact_blank.join(" · ") %></span>
            </span>
          </option>
        <% end %>
      </select>
    <% end %>
  </div>
<% end %>

<nav aria-label="Primary" class="mt-6 min-h-0 flex-1 overflow-y-auto px-2">
  <ul class="flex flex-col gap-0.5">
    <li>
      <%= link_to overview_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :overview } do %>
        <%= heroicon "home", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Overview
      <% end %>
    </li>
    <% current_folder = @folder || @media&.folder %>
    <li>
      <%= link_to library_folders_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :folders } do %>
        <%= heroicon "photo", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Media
      <% end %>
      <% folder_counts = Current.account.library_media.group(:folder_id).count %>
      <ul aria-label="Folder tree">
        <% Folder.roots.ordered.includes(:children).each do |root| %>
          <% [ root, *root.children ].each do |folder| %>
            <li>
              <%= link_to folder_path(folder),
                    class: "flex items-center gap-2 rounded-xl py-1.5 pr-3 text-sm font-medium text-ink-500 transition hover:bg-ink-900/5 aria-[current=page]:bg-ink-900/5 aria-[current=page]:text-ink-900 data-drop-over:bg-rocket/10 data-drop-over:outline-2 data-drop-over:outline-rocket #{folder.root? ? "pl-3" : "pl-9"}",
                    aria: { current: ("page" if folder == current_folder) },
                    data: { folder_id: (folder.id if Current.user&.admin? && folder != current_folder) } do %>
                <%= heroicon "folder", variant: :micro, options: { class: "size-4 shrink-0 #{folder_color(folder)}", "aria-hidden": true } %>
                <span class="truncate"><%= folder.name %></span>
                <span class="-ml-1 shrink-0 text-[10px] tabular-nums text-ink-300"><%= folder_counts[folder.id] %></span>
              <% end %>
            </li>
          <% end %>
        <% end %>
      </ul>
    </li>
    <li class="mt-2">
      <ol>
        <% [
          [ "Recipes", recipes_path, :recipes, "sparkles", true ],
          [ "Shots", shots_path, :shots ],
          [ "Styles", styles_path, :styles ],
          [ "Layers", layers_path, :layers ],
          [ "Features", features_path, :features ],
          [ "Posts", instagram_posts_path, :posts, "squares-2x2" ]
        ].each do |label, path, key, icon, admin_only| %>
          <li>
            <% if icon && (Current.user&.admin? || !admin_only) %>
              <%= link_to path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == key } do %>
                <%= heroicon icon, options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                <%= label %>
              <% end %>
            <% elsif Current.user&.admin? %>
              <%= link_to label, path,
                    class: "block rounded-xl py-2 pr-3 pl-10 text-sm font-medium text-ink-500 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == key } %>
            <% else %>
              <span class="block py-2 pr-3 pl-10 text-sm font-medium text-ink-500"><%= label %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </li>
    <% business_sections = {
      "Onboarding" => [ onboarding_path, :onboarding, "clipboard-document-check" ],
      "Instagram" => [ instagram_profile_path, :instagram, "brands/instagram.svg" ],
      "WhatsApp" => [ whatsapp_path, :whatsapp, "brands/whatsapp.svg" ],
      "Business" => [ business_path, :business, "building-storefront" ],
      "Calendar" => [ calendar_path, :calendar, "calendar-days" ],
      "Services" => [ services_path, :services, "tag" ],
      "Links" => [ links_path, :links, "link" ],
      "Reviews" => [ reviews_path, :reviews, "star" ],
      "Subscription" => [ subscription_path, :subscription, "credit-card" ],
      "Profile" => [ profile_settings_path, :profile, "user" ]
    } %>
    <li class="mt-2 border-t border-ink-900/10 pt-2">
      <details class="group" <%= "open" if business_sections.values.any? { |_, key| key == section } %>>
        <summary class="flex w-full cursor-pointer list-none items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 [&::-webkit-details-marker]:hidden">
          Business
          <%= heroicon "chevron-right", variant: :mini, options: { class: "ml-auto size-4 shrink-0 text-ink-400 transition group-open:rotate-90", "aria-hidden": true } %>
        </summary>
        <ul class="flex flex-col gap-0.5">
          <% business_sections.each do |label, (path, key, icon)| %>
            <li>
              <%= link_to path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == key } do %>
                <% if icon.end_with?(".svg") %>
                  <%= image_tag icon, class: "size-5 shrink-0", alt: "", aria: { hidden: true } %>
                <% else %>
                  <%= heroicon icon, options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                <% end %>
                <%= label %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    </li>
    <% if Current.user&.admin? %>
      <li class="mt-2 border-t border-ink-900/10 pt-2">
        <details class="group" <%= "open" if section == :admin %>>
          <summary class="flex w-full cursor-pointer list-none items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 [&::-webkit-details-marker]:hidden">
            Admin
            <%= heroicon "chevron-right", variant: :mini, options: { class: "ml-auto size-4 shrink-0 text-ink-400 transition group-open:rotate-90", "aria-hidden": true } %>
          </summary>
          <ul class="flex flex-col gap-0.5">
            <li>
              <%= link_to admin_path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == :admin } do %>
                <%= heroicon "wrench-screwdriver", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Dashboard
              <% end %>
            </li>
            <li>
              <%= link_to "/admin",
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                <%= heroicon "table-cells", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Active Admin
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
            <li>
              <%= link_to "/jobs",
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                <%= heroicon "queue-list", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Jobs
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
          </ul>
        </details>
      </li>
    <% end %>
  </ul>
</nav>

<div class="mt-auto px-2 pb-2">
  <%= button_to "Log out", session_path(Current.session), method: :delete,
        form: { class: "w-full" },
        class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5" %>
</div>
