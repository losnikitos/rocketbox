<%# locals: (section:) %>
<% if Current.user&.admin? %>
  <div class="mt-4 px-2">
    <%= form_with url: account_selection_path, method: :patch do %>
      <label for="account_user_id" class="mb-1 block text-xs font-medium text-ink-500">Customer</label>
      <%= select_tag :user_id,
            options_from_collection_for_select(User.order(:business_name, :email), :id, :account_label, Current.account.id),
            id: "account_user_id",
            class: "block w-full rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-sm text-ink-900 focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30",
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  </div>
<% end %>

<nav aria-label="Primary" class="mt-6 flex-1 px-2">
  <ul class="flex flex-col gap-0.5">
    <li>
      <%= link_to library_uploads_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :library } do %>
        <%= heroicon "photo", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Library
      <% end %>
    </li>
    <li>
      <%= link_to smm_posts_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :smm } do %>
        <%= heroicon "film", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        SMM
      <% end %>
    </li>
    <li class="mt-2 border-t border-ink-900/10 pt-2">
      <%= link_to business_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :business } do %>
        <%= heroicon "building-storefront", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Business
      <% end %>
    </li>
    <li>
      <%= link_to links_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :links } do %>
        <%= heroicon "link", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Links
      <% end %>
    </li>
    <li>
      <%= link_to integrations_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :integrations } do %>
        <%= heroicon "puzzle-piece", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Integrations
      <% end %>
    </li>
    <li>
      <%= link_to subscription_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :subscription } do %>
        <%= heroicon "credit-card", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Subscription
      <% end %>
    </li>
    <li>
      <%= link_to profile_settings_path,
            class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
            aria: { selected: section == :profile } do %>
        <%= heroicon "user", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
        Profile
      <% end %>
    </li>
    <% if Current.user&.admin? %>
      <li class="mt-2 border-t border-ink-900/10 pt-2">
        <%= link_to monitor_path,
              class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5" do %>
          <%= heroicon "cog", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
          Monitor
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>

<div class="mt-auto px-2 pb-2">
  <%= button_to "Log out", session_path(Current.session), method: :delete,
        form: { class: "w-full" },
        class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5" %>
</div>
