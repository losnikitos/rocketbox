<%# locals: (section:) %>
<% accounts = Current.user&.admin? ? User.order(:business_name, :email).to_a : [ Current.account ].compact %>
<% if accounts.any? %>
  <div class="mt-4 px-2">
    <% if accounts.many? %>
      <%= form_with url: request.path, method: :get do %>
        <label for="account_user_id" class="mb-1 block text-xs font-medium text-ink-500">Customer</label>
        <select name="account" id="account_user_id" onchange="this.form.requestSubmit()"
                class="flex w-full items-center gap-2 rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-left text-sm text-ink-900 [appearance:base-select] focus:border-rocket focus:outline-none focus:ring-2 focus:ring-rocket/30 [&::picker(select)]:mt-1 [&::picker(select)]:rounded-lg [&::picker(select)]:border [&::picker(select)]:border-ink-900/15 [&::picker(select)]:[appearance:base-select]">
          <button class="min-w-0 flex-1 text-left"><selectedcontent class="flex min-w-0 items-center gap-2"></selectedcontent></button>
          <% accounts.each do |user| %>
            <option value="<%= user.id %>" <%= "selected" if user.id == Current.account.id %>
                    class="min-w-0 flex items-center gap-2 px-2.5 py-1 checked:bg-ink-900/5 hover:bg-ink-900/5 focus:bg-ink-900/5 [&::checkmark]:hidden">
              <%= render "layouts/app/account_identity", user: %>
            </option>
          <% end %>
        </select>
      <% end %>
    <% else %>
      <div role="group" aria-label="Company" aria-readonly="true"
           class="flex w-full min-w-0 items-center gap-2 rounded-lg border border-ink-900/15 bg-white px-2.5 py-1.5 text-left text-sm text-ink-900">
        <%= render "layouts/app/account_identity", user: accounts.first %>
      </div>
    <% end %>
  </div>
<% end %>

<nav aria-label="Primary" class="mt-6 min-h-0 flex-1 overflow-y-auto px-2">
  <ul class="flex flex-col gap-0.5">
    <% current_folder = @folder || @media&.folder || @prompt&.folder %>
    <li>
      <% folder_counts = [ Current.account.library_media, Prompt.where(user_id: [ nil, Current.account.id ]), Current.account.reviews.active ]
           .map { it.group(:folder_id).count }.reduce(:merge) %>
      <ul aria-label="Folder tree">
        <li>
          <%= link_to recent_path,
                class: "flex min-w-0 flex-1 items-center gap-2 rounded-xl py-1.5 pr-3 pl-3 text-sm font-medium text-ink-500 transition hover:bg-ink-900/5 aria-[current=page]:bg-ink-900/5 aria-[current=page]:text-ink-900",
                aria: { current: ("page" if section == :recent) } do %>
            <%= heroicon "clock", variant: :micro, options: { class: "size-4 shrink-0 text-ink-400", "aria-hidden": true } %>
            <span class="truncate">Recent</span>
          <% end %>
        </li>
        <% sidebar_roots.each do |root| %>
          <li>
            <details class="group" <%= "open" if current_folder&.root == root %>>
              <summary class="flex cursor-pointer list-none items-center rounded-xl [&::-webkit-details-marker]:hidden">
                <%= render "layouts/app/folder_link", folder: root, current_folder:, count: folder_counts[root.id] %>
                <% if root.children.any? %>
                  <%= heroicon "chevron-right", variant: :mini, options: { class: "mx-1 size-6 shrink-0 rounded-lg p-1 text-ink-400 transition hover:bg-ink-900/5 group-open:rotate-90", "aria-hidden": true } %>
                <% end %>
              </summary>
              <ul>
                <% root.children.each do |folder| %>
                  <li><%= render "layouts/app/folder_link", folder:, current_folder:, count: folder_counts[folder.id] %></li>
                <% end %>
              </ul>
            </details>
          </li>
        <% end %>
      </ul>
    </li>
    <li class="mt-2">
      <ol>
        <% if Current.user&.admin? %>
          <li>
            <% current_workflow = @workflow if @workflow&.persisted? %>
            <details class="group" <%= "open" if section == :workflows %>>
              <summary class="flex cursor-pointer list-none items-center rounded-xl [&::-webkit-details-marker]:hidden">
                <%= link_to workflows_path,
                      class: "flex min-w-0 flex-1 items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                      aria: { selected: section == :workflows && !current_workflow } do %>
                  <%= lucide_icon("workflow", class: "size-5 shrink-0", "stroke-width": 1.5, "aria-hidden": true) %>
                  Workflows
                <% end %>
                <%= heroicon "chevron-right", variant: :mini, options: { class: "mx-1 size-6 shrink-0 rounded-lg p-1 text-ink-400 transition hover:bg-ink-900/5 group-open:rotate-90", "aria-hidden": true } %>
              </summary>
              <ul>
                <% Workflow.sidebar.each do |workflow| %>
                  <li>
                    <%= link_to workflow_path(workflow),
                          class: "flex min-w-0 items-center gap-1 rounded-xl py-1.5 pr-3 pl-10 text-sm font-medium text-ink-500 transition hover:bg-ink-900/5 aria-[current=page]:bg-ink-900/5 aria-[current=page]:text-ink-900",
                          aria: { current: ("page" if workflow == current_workflow) } do %>
                      <span class="truncate"><%= workflow.name %></span>
                      <% if workflow.built_in? %>
                        <%= lucide_icon "pin", class: "size-3 shrink-0 text-ink-400", "aria-hidden": true %>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </details>
          </li>
          <li>
            <%= link_to layers_path,
                  class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                  aria: { selected: section == :layers } do %>
              <%= heroicon "square-3-stack-3d", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
              Layers
            <% end %>
          </li>
        <% end %>
        <li>
          <%= link_to rubrics_path,
                class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                aria: { selected: section == :schedule } do %>
            <%= heroicon "calendar", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
            Schedule
          <% end %>
        </li>
      </ol>
    </li>
    <li class="mt-2 border-t border-ink-900/10 pt-2">
      <details class="group" <%= "open" if !Current.user&.admin? || business_sections.any? { |_, _, key| key == section } %>>
        <summary class="flex w-full cursor-pointer list-none items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 [&::-webkit-details-marker]:hidden">
          Business
          <%= heroicon "chevron-right", variant: :mini, options: { class: "ml-auto size-4 shrink-0 text-ink-400 transition group-open:rotate-90", "aria-hidden": true } %>
        </summary>
        <ul class="flex flex-col gap-0.5">
          <% business_sections.each do |label, path, key, icon| %>
            <li>
              <%= link_to path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == key } do %>
                <%= section_icon icon %>
                <%= label %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    </li>
    <% if Current.user&.admin? %>
      <li class="mt-2 border-t border-ink-900/10 pt-2">
        <details class="group" <%= "open" if section.in?(%i[admin transcript]) %>>
          <summary class="flex w-full cursor-pointer list-none items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 [&::-webkit-details-marker]:hidden">
            Admin
            <%= heroicon "chevron-right", variant: :mini, options: { class: "ml-auto size-4 shrink-0 text-ink-400 transition group-open:rotate-90", "aria-hidden": true } %>
          </summary>
          <ul class="flex flex-col gap-0.5">
            <li>
              <%= link_to admin_path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == :admin } do %>
                <%= heroicon "wrench-screwdriver", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Dashboard
              <% end %>
            </li>
            <li>
              <%= link_to transcript_path,
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5 aria-selected:bg-ink-900/5 aria-selected:text-ink-900",
                    aria: { selected: section == :transcript } do %>
                <%= heroicon "chat-bubble-left-right", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Transcript
              <% end %>
            </li>
            <li>
              <%= link_to "/admin",
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                <%= heroicon "table-cells", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Active Admin
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
            <li>
              <%= link_to "/jobs",
                    class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5",
                    target: "_blank",
                    rel: "noopener" do %>
                <%= heroicon "queue-list", options: { class: "size-5 shrink-0", "aria-hidden": true } %>
                Jobs
                <%= heroicon "arrow-up-right", variant: :mini, options: { class: "size-3.5 shrink-0 text-ink-400" } %>
              <% end %>
            </li>
          </ul>
        </details>
      </li>
    <% end %>
  </ul>
</nav>

<div class="mt-auto px-2 pb-2">
  <%= button_to "Log out", session_path(Current.session), method: :delete,
        form: { class: "w-full" },
        class: "inline-flex w-full items-center gap-2 rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-ink-900/5" %>
</div>
