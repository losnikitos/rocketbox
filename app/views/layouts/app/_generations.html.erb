<%# locals: (user:, **) %>
<%# The inside of the layout's #generations <details>: RecipeRun broadcasts update it, so the owner's open/closed choice stays. %>
<% runs = RecipeRun.recent_for(user).to_a %>
<% if runs.any? %>
  <summary class="flex cursor-pointer list-none items-center gap-1.5 px-3 py-2.5 text-sm font-semibold [&::-webkit-details-marker]:hidden" aria-label="Generations">
    <% if runs.any?(&:running?) %>
      <%= heroicon "arrow-path", variant: :mini, options: { class: "size-5 animate-spin text-signal-yellow", "aria-hidden": true } %>
    <% else %>
      <%= heroicon "check-circle", variant: :mini, options: { class: "size-5 text-signal-green", "aria-hidden": true } %>
    <% end %>
    <%= heroicon "sparkles", variant: :mini, options: { class: "size-5 text-ink-500", "aria-hidden": true } %>
    <span class="hidden group-open:inline">Generations</span>
  </summary>
  <ul class="border-t border-ink-900/10 p-2">
    <% runs.each do |run| %>
      <li>
        <%= link_to library_item_path(run.generated_media), class: "flex items-center gap-3 rounded-lg p-2 hover:bg-ink-900/5" do %>
          <span class="flex size-10 shrink-0 overflow-hidden rounded">
            <%= render "accounts/library/file", media: run.generated_media, css: "size-10 object-cover" %>
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-medium"><%= run.recipe.name %></span>
            <% if run.running? %>
              <span class="block text-xs text-ink-500">Generating…</span>
            <% elsif run.failed? %>
              <span class="block text-xs text-signal-red">Failed</span>
            <% else %>
              <span class="block text-xs text-ink-500"><%= time_ago_in_words(run.updated_at) %> ago</span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
