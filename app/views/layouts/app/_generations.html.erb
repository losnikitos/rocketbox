<%# locals: (user:, **) %>
<%# The inside of the layout's #generations popover: TransformationRun broadcasts update it, so an open panel stays open. The pill reads `li` / `data-running` via :has(). %>
<% runs = TransformationRun.recent_for(user).to_a %>
<% if runs.any? %>
  <ul>
    <% runs.each do |run| %>
      <li <%= "data-running" if run.running? %>>
        <%= link_to library_item_path(run.generated_media), class: "flex items-center gap-3 rounded-lg p-2 hover:bg-ink-900/5" do %>
          <span class="flex size-10 shrink-0 overflow-hidden rounded">
            <%= render "accounts/library/file", media: run.generated_media, css: "size-10 object-cover" %>
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-medium"><%= run.recipe.name %></span>
            <% if run.running? %>
              <span class="block text-xs text-ink-500">Generating…</span>
            <% elsif run.failed? %>
              <span class="block text-xs text-signal-red">Failed</span>
            <% else %>
              <span class="block text-xs text-ink-500"><%= time_ago_in_words(run.updated_at) %> ago</span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
