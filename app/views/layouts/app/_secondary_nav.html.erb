<%# locals: (tabs:, show_upload: false) %>
<nav aria-label="Secondary" class="flex flex-wrap items-center gap-1 px-1 sm:px-2">
  <% tabs.each do |tab| %>
    <% if tab == :separator %>
      <span class="mx-1 h-4 w-px bg-ink-900/15" aria-hidden="true"></span>
    <% else %>
      <% path, label, selected = tab %>
      <%= link_to label,
            path,
            class: "rounded-full px-3.5 py-1.5 text-sm font-medium transition aria-selected:bg-ink-900 aria-selected:text-white text-ink-600 hover:bg-ink-900/5 hover:text-ink-900",
            aria: { selected: selected, current: (selected ? "page" : nil) } %>
    <% end %>
  <% end %>
  <% if show_upload %>
    <label for="library-upload-input" class="rb-btn-ghost-on-light ml-auto cursor-pointer gap-1.5 px-3.5 py-1.5 text-sm">
      <%= heroicon "arrow-up-tray", variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
      Upload
    </label>
  <% end %>
</nav>
