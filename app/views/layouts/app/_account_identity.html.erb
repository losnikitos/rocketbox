<%# locals: (user:) %>
<% if (logo = user.logo_media) %>
  <%= image_tag logo.file.variant(resize_to_limit: [ 64, 64 ]), alt: "", class: "size-7 shrink-0 rounded-md object-contain" %>
<% else %>
  <span class="size-7 shrink-0 rounded-md bg-ink-900/5" aria-hidden="true"></span>
<% end %>
<span class="flex min-w-0 flex-col">
  <span class="truncate font-medium"><%= user.business_name.presence || user.account_label %></span>
  <span class="truncate text-xs text-ink-500"><%= [ ("+#{user.whatsapp_phone}" if user.whatsapp_phone), user.email ].compact_blank.join(" · ") %></span>
</span>
