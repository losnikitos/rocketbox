<% content_for(:title, "Enter password — Rocketbox") %>
<%= render layout: "shared/auth_card" do %>
  <h1 class="text-center font-manrope text-xl font-bold tracking-tight text-ink-900 sm:text-2xl">Enter your password</h1>
  <p class="mt-1 text-center text-sm text-ink-600">
    Signing in as <strong><%= @email %></strong>
  </p>

  <%= form_with url: sign_in_password_path, class: "mt-8 space-y-5" do |form| %>
    <%= form.hidden_field :email, value: @email %>
    <div>
      <%= form.label :password, "Password", class: tw_label_classes %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", class: tw_input_classes %>
    </div>
    <div class="pt-1">
      <%= form.submit "Continue", class: tw_btn_primary_classes %>
    </div>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to "Use a code instead", sign_in_otp_path(email: @email), class: "text-sm rb-text-link" %>
  </p>
<% end %>
