<% content_for(:title, "Sign in — Rocketbox") %>
<%= render "shared/auth/email_step",
      form_url: sign_in_path,
      email: @email,
      subtitle: "We’ll email you a login code." %>

<% if Rails.env.development? %>
  <div class="mx-auto w-full max-w-md pb-8">
    <%= button_to "Quick login as losnikitos@gmail.com", dev_sign_in_path, class: tw_btn_secondary_classes %>
  </div>
<% end %>
