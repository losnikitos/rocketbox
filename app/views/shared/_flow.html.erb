<%# locals: (nodes:, edges:, height: "h-[calc(100dvh-10rem)]") %>
<%# nodes: { id => { label:, icon:, cover:, media:, note:, path:, shape: (:folder, :media, :step or :note), color:, x:, y:, frame:, current:, linkable: } }, edges: [[from id, to id, { id:, path:, frame:, current: }], ...] %>
<%# Optional: x and y (centre) pin a node instead of laying it out; frame opens path in that turbo frame; current marks the %>
<%# selected node; linkable adds a port to drag arrows from (flow:linked). A :step is a card with its type's cover left of its label and kind %>
<%# (its options, e.g. model and aspect ratio) and an input port on the left per arrow in (inputs, at least one), or, with slots, a labelled port per slot. A :folder has the same input ports. A :media is its thumbnail, a source nothing links into. An edge's optional path makes it %>
<%# clickable, like a node's; its optional id lets its ends be dragged to other nodes once selected (flow:linked); its optional slot is the port it goes into. %>
<%# A :step's optional status (running, complete or failed) badges its corner, its optional error in the badge's title. %>
<%# An edge's optional media (what went along it) shows on its middle, and opens in a lightbox. %>
<%# A :note is a sticky note: its Markdown note on a card in its color, connecting to nothing. %>
<%# play (a start node's, or a :step's whose inputs are complete; or a run :step's rerun) adds a play button on the node's top-left corner that submits the page's #workflow_play form with node_id. %>
<div class="<%= height %> overflow-auto" data-controller="flow" data-flow-edges-value="<%= edges.map { |from, to, edge| [ from, to, edge&.except(:media) ].compact }.to_json %>"
     data-action="click->flow#clear wheel->flow#wheel:!passive gesturestart->flow#gesture:!passive gesturechange->flow#gesture:!passive scroll->flow#remember
                  pointerdown->flow#lasso pointermove->flow#sweep pointerup->flow#stop pointercancel->flow#stop">
  <%# Laid out by flow_controller; hidden until the nodes are placed. %>
  <div class="invisible relative select-none" data-flow-target="canvas">
    <svg class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
      <pattern id="flow-dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="10" cy="10" r="1" class="fill-ink-900/20" />
      </pattern>
      <rect width="100%" height="100%" fill="url(#flow-dots)" class="pointer-events-none" />
      <g data-flow-target="edges" data-action="click->flow#pick" class="stroke-ink-900/25 motion-safe:animate-march" fill="none" stroke-width="2" stroke-dasharray="6 4"></g>
    </svg>
    <%# Placed on the middle of their arrows by flow_controller; data-v and data-w keep a press from starting a selection or deselecting. %>
    <% edges.each do |from, to, edge| %>
      <% next unless (media = edge&.dig(:media)) %>
      <button type="button" popovertarget="<%= dom_id(media, :quick_view) %>" aria-label="View media" title="View media"
              data-flow-target="output" data-v="<%= from %>" data-w="<%= to %>"
              class="absolute block -translate-1/2 cursor-zoom-in rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket [&_img]:pointer-events-none">
        <%= render "accounts/library/file", media:, play: true, css: "h-24 w-auto rounded-md border-2 border-white shadow-sm" %>
      </button>
    <% end %>
    <% nodes.each do |id, n| %>
      <%= content_tag(n[:path] ? :a : :span, href: n[:path], draggable: "false", aria: { current: ("true" if n[:current]) },
            data: { flow_target: "node", id:, x: n[:x], y: n[:y], step: (true if n[:shape] == :step), source: (true if n[:shape] == :media), note: (true if n[:shape] == :note), turbo_frame: n[:frame], turbo_action: ("advance" if n[:frame]),
                    action: "pointerdown->flow#grab pointermove->flow#drag pointerup->flow#drop pointercancel->flow#drop click->flow#click" },
            class: "#{"group" if n[:path]} absolute flex #{n[:shape].in?(%i[step note]) ? "w-56" : "w-28"} cursor-grab touch-none flex-col items-center gap-1.5 text-center text-sm font-semibold text-ink-900 select-none active:cursor-grabbing") do %>
        <% port = "relative size-4 shrink-0 rounded-full border-2 border-ink-900/30 bg-white group-data-[flow-drop]:border-rocket" %>
        <% if n[:shape] == :step %>
          <span style="<%= "min-height: #{n[:slots].size * 2}rem" if n[:slots] %>"
                class="relative flex w-full items-center gap-3 rounded-2xl border-2 border-ink-900/10 bg-white p-2 text-left hover:border-ink-900/20 hover:bg-stone-50 group-aria-[current=true]:border-rocket group-aria-[current=true]:hover:border-rocket-press group-aria-[current=true]:hover:bg-rocket/5 group-data-[flow-drop]:border-rocket group-data-[flow-drop]:bg-rocket/5">
            <%= image_tag n[:cover], alt: "", draggable: "false", class: "aspect-2/3 w-14 shrink-0 rounded-lg object-cover" %>
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span id="node_<%= id %>_label" class="line-clamp-3 break-words" title="<%= n[:label] %>"><%= n[:label] %></span>
              <span id="node_<%= id %>_kind" class="line-clamp-2 text-xs font-normal text-ink-500" title="<%= n[:kind] %>"><%= n[:kind] %></span>
            </span>
            <% if n[:status] %>
              <% label, icon, css = { "running" => [ "Working", "arrow-path", "bg-signal-yellow [&_svg]:animate-spin" ],
                                      "complete" => [ "Complete", "check", "bg-signal-green" ],
                                      "failed" => [ "Failed", "x-mark", "bg-signal-red" ] }.fetch(n[:status]) %>
              <span role="img" aria-label="<%= label %>" title="<%= [ label, n[:error] ].compact.join(": ") %>"
                    class="absolute -top-2.5 -right-2.5 flex size-6 items-center justify-center rounded-full text-white shadow-sm ring-2 ring-white <%= css %>">
                <%= heroicon icon, variant: :mini, options: { class: "size-4", "aria-hidden": true } %>
              </span>
            <% end %>
          </span>
          <%# Arrows in attach to these, their slot's or else top to bottom in their sources' order (flow_controller). %>
          <span class="absolute inset-y-0 -left-2 flex flex-col justify-evenly" aria-hidden="true">
            <% if n[:slots] %>
              <% n[:slots].each do |slot| %>
                <%# Its label sits above the arrow coming in. %>
                <span data-flow-input data-slot="<%= slot %>" class="<%= port %> hover:border-rocket hover:bg-rocket/10">
                  <span class="absolute right-full bottom-full text-xs font-normal whitespace-nowrap text-ink-500"><%= slot.humanize %></span>
                </span>
              <% end %>
            <% else %>
              <% [ n[:inputs].to_i, 1 ].max.times do %>
                <span data-flow-input class="<%= port %>"></span>
              <% end %>
            <% end %>
          </span>
        <% elsif n[:shape] == :note %>
          <%# Its links are plain text: the node is itself a link, and links can't nest. render_markdown sanitizes. %>
          <div class="w-full space-y-2 rounded-xl border-2 p-3 text-left text-sm font-normal break-words shadow-sm <%= AppHelper::NOTE_COLORS[n[:color]] %>
                       group-aria-[current=true]:border-rocket [&_h1]:text-base [&_h1]:font-bold [&_h2]:font-semibold [&_h3]:font-semibold
                       [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_strong]:font-semibold [&_code]:rounded [&_code]:bg-ink-900/5 [&_code]:px-1
                       [&_blockquote]:border-l-4 [&_blockquote]:border-ink-900/15 [&_blockquote]:pl-3 [&_blockquote]:text-ink-600">
            <% if n[:note].present? %>
              <%= raw strip_links(render_markdown(n[:note])) %>
            <% else %>
              <p class="text-ink-400">Empty note</p>
            <% end %>
          </div>
        <% elsif n[:shape] == :media %>
          <%# Sized from the file's analyzed dimensions, not the loaded image, so flow_controller measures it right away. %>
          <%# Images don't take the pointer, so a press drags the node rather than the picture. %>
          <% size = n[:media].file.attached? ? n[:media].file.metadata.values_at(:width, :height) : [] %>
          <span style="aspect-ratio: <%= size.compact.many? ? size.join(" / ") : "2 / 3" %>"
                class="block w-20 overflow-hidden rounded-lg border-2 border-ink-900/10 hover:border-ink-900/20 group-aria-[current=true]:border-rocket group-aria-[current=true]:hover:border-rocket-press [&_img]:pointer-events-none">
            <%= render "accounts/library/file", media: n[:media], play: true, css: "size-full object-cover" %>
          </span>
          <span class="line-clamp-2 break-all group-aria-[current=true]:text-rocket" title="<%= n[:label] %>"><%= n[:label] %></span>
        <% else %>
          <span class="group/folder relative block w-24 <%= AppHelper::FOLDER_COLORS[n[:color] || "sky"] %>">
            <svg viewBox="0 0 96 76" class="w-24 stroke-current" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 10a6 6 0 0 1 6-6h22l8 8h50a6 6 0 0 1 6 6v50a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6z" class="fill-current/25 group-hover/folder:fill-current/40 group-data-[flow-drop]:fill-current/50" />
              <%# The front panel is opaque so the back doesn't tint it. %>
              <rect x="2" y="20" width="92" height="54" rx="6" fill="white" />
              <rect x="2" y="20" width="92" height="54" rx="6" class="fill-current/10 group-hover/folder:fill-current/20" />
            </svg>
            <span class="absolute inset-x-0 top-5 bottom-0 flex items-center justify-center">
              <%= heroicon n[:icon], options: { class: "size-7", "aria-hidden": true } %>
            </span>
            <%# Centred on the node's left edge, like a step's; many spill above and below the icon. %>
            <span class="absolute inset-y-0 -left-4 flex flex-col justify-center gap-1" aria-hidden="true">
              <% [ n[:inputs].to_i, 1 ].max.times do %>
                <span data-flow-input class="<%= port %>"></span>
              <% end %>
            </span>
          </span>
          <span class="group-aria-[current=true]:text-rocket group-data-[flow-drop]:text-rocket"><%= n[:label] %></span>
        <% end %>
        <% if n[:play] || n[:rerun] %>
          <%# Placed on the top-left corner of the node's first child by flow_controller; a sibling of it, so hovering one doesn't hover the other. %>
          <%# A press neither drags the node nor follows its link. %>
          <% label = n[:play] ? "Run from here" : "Run again" %>
          <button type="submit" form="workflow_play" name="node_id" value="<%= id %>" title="<%= label %>" aria-label="<%= label %>"
                  data-flow-play onpointerdown="event.stopPropagation()" onclick="event.stopPropagation()"
                  class="absolute z-10 -mt-4 -ml-4 flex size-9 cursor-pointer items-center justify-center rounded-lg border border-stone-300 bg-white text-black shadow-sm hover:bg-stone-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rocket">
            <%= heroicon "play", variant: :mini, options: { class: "size-5 translate-x-px", "aria-hidden": true } %>
          </button>
        <% end %>
        <% if n[:linkable] %>
          <%# Placed at the arrows' height by flow_controller. %>
          <span data-flow-handle aria-hidden="true" title="Drag to connect"
                data-action="pointerdown->flow#link:stop pointermove->flow#stretch:stop pointerup->flow#attach:stop pointercancel->flow#attach:stop"
                class="absolute -right-2 size-4 -translate-y-1/2 cursor-crosshair rounded-full border-2 border-ink-900/30 bg-white hover:border-rocket hover:bg-rocket/10 group-data-[flow-drop]:border-rocket"></span>
        <% end %>
      <% end %>
    <% end %>
    <%# The selected edge's draggable ends, above the nodes' ports (flow_controller). %>
    <div data-flow-target="ends" class="pointer-events-none absolute inset-0"></div>
    <%# The selection rectangle (flow_controller). %>
    <div data-flow-target="marquee" hidden class="pointer-events-none absolute rounded-sm border border-rocket bg-rocket/10"></div>
  </div>
</div>
<%# Outside the canvas, so its zoom and the flow's clicks leave them be. %>
<% edges.filter_map { it[2]&.dig(:media) }.uniq.each do |media| %>
  <%= render "accounts/library/quick_view", media:, button: false %>
<% end %>
