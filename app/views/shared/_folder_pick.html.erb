<%# locals: (name:, selected:, label:, roots: Folder.roots) %>
<%# Folder dropdown: the closed state mirrors the picked option's first child. %>
<% roots = roots.ordered.includes(:children).to_a %>
<% selected = roots.flat_map { [ it, *it.children ] }.find { it.id.to_s == selected.to_s } %>
<% counts = Current.account.library_media.group(:folder_id).count %>
<% chip = ->(folder) do
     tag.span class: "flex min-w-0 items-center gap-1.5" do
       safe_join [
         heroicon("folder", variant: :micro, options: { class: "size-3.5 shrink-0 #{folder_color(folder)}", "aria-hidden": true }),
         tag.span(folder.path, class: "truncate"),
         tag.span(counts[folder.id], class: "shrink-0 text-xs tabular-nums text-ink-400")
       ]
     end
   end %>
<div data-controller="folder-pick" class="group min-w-0 flex-1">
  <%= hidden_field_tag name, selected&.id, id: nil, data: { folder_pick_target: "input" } %>
  <template data-folder-pick-target="placeholder"><span class="text-ink-500">Choose folder</span></template>
  <button type="button" data-folder-pick-target="trigger" aria-label="<%= label %>"
          class="flex w-full min-w-0 cursor-pointer items-center gap-1 py-1.5 pr-2 pl-2.5 text-left text-sm focus:outline-none">
    <span data-folder-pick-target="preview" class="flex min-h-5.5 min-w-0 flex-1 items-center">
      <% if selected %><%= chip.(selected) %><% else %><span class="text-ink-500">Choose folder</span><% end %>
    </span>
    <%= heroicon "chevron-down", variant: :mini, options: { class: "size-4 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
  </button>
  <div popover data-folder-pick-target="popover" data-action="toggle->folder-pick#opened"
       class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 min-w-60 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-1 shadow-lg">
    <div class="sticky -top-1 z-10 -mx-1 -mt-1 mb-1 border-b border-ink-900/10 bg-white p-1">
      <input type="search" placeholder="Search folders" aria-label="Search folders" autocomplete="off"
             data-folder-pick-target="search" data-action="input->folder-pick#filter keydown.enter->folder-pick#pickFirst"
             class="w-full rounded-md px-2 py-1.5 text-sm placeholder:text-ink-400 focus:outline-none">
    </div>
    <% roots.each_with_index do |root, index| %>
      <% if index.positive? %><div data-folder-pick-target="separator" class="mx-2 my-1 h-px bg-ink-900/10" aria-hidden="true"></div><% end %>
      <% [ root, *root.children ].each do |folder| %>
        <%= tag.button chip.(folder), type: "button", value: folder.id, aria: { current: ("true" if folder == selected) },
              data: { folder_pick_target: "option", action: "folder-pick#pick" },
              class: "flex w-full cursor-pointer rounded-lg px-2 py-1.5 text-left text-sm text-ink-700 hover:bg-ink-900/5 focus-visible:ring-2 focus-visible:ring-rocket/30 focus-visible:outline-none aria-[current=true]:bg-rocket/10" %>
      <% end %>
    <% end %>
  </div>
</div>
