<%# locals: (name:, icon:) %>
<div class="flex items-center gap-2 rounded-lg border border-ink-900/15 bg-stone-50 px-3 py-2 text-sm font-medium text-ink-900">
  <span class="flex size-5 shrink-0 items-center justify-center rounded border border-sky-300 bg-sky-50 text-sky-600">
    <%= heroicon icon, variant: :micro, options: { class: "size-3.5", "aria-hidden": true } %>
  </span>
  <%= name %>
</div>
