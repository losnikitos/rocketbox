<%# Locals: library_media,
    links (optional hash — :admin, :remove default true; :move default false),
    move_targets (optional, Folder.grouped_options — pass it when rendering many) %>
<% library_media = local_assigns[:library_media] %>
<% links = { admin: true, remove: true, move: false }.merge(local_assigns.fetch(:links, {})) %>
<% if Current.user&.admin? && library_media.present? && links.values.any? %>
  <% popover_id = "library-media-admin-links-#{library_media.id}" %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id:, align: local_assigns.fetch(:align, :right) } do %>
    <% if links[:move] %>
      <% move_id = "library-media-move-#{library_media.id}#{admin_link_id_suffix}" %>
      <button type="button" popovertarget="<%= move_id %>" style="anchor-name: --<%= move_id %>"
              class="flex w-full cursor-pointer items-center gap-2 rounded px-3 py-2 text-left text-sm font-medium text-ink-900 hover:bg-ink-900/5">
        <span class="flex items-center justify-center rounded p-1 text-white bg-blue-600">
          <%= heroicon "folder-arrow-down", variant: :micro, options: { class: "size-3.5" } %>
        </span>
        Move to
        <%= heroicon "chevron-right", variant: :micro, options: { class: "ml-auto size-4 text-ink-400", "aria-hidden": true } %>
      </button>
      <div id="<%= move_id %>" popover style="position-anchor: --<%= move_id %>"
           class="inset-auto m-0 top-[calc(anchor(top)-4px)] left-[calc(anchor(right)+4px)] [position-try-fallbacks:flip-inline,flip-block,flip-block_flip-inline] max-h-96 min-w-40 overflow-y-auto whitespace-nowrap rounded-lg border border-ink-900/15 bg-white p-1 shadow-lg">
        <% local_assigns.fetch(:move_targets) { Folder.grouped_options }.each_with_index do |(_root, options), index| %>
          <% if index.positive? %><div class="mx-2 my-1 h-px bg-ink-900/10" aria-hidden="true"></div><% end %>
          <% options.each do |label, id| %>
            <% current = library_media.folder_id == id %>
            <%= button_to library_media_path(library_media), method: :patch, params: { library_media: { folder_id: id } },
                  aria: { current: ("true" if current) }, disabled: current,
                  class: "flex w-full cursor-pointer items-center justify-between gap-2 rounded px-3 py-1.5 text-left text-sm text-ink-900 hover:bg-ink-900/5 disabled:cursor-default disabled:font-medium" do %>
              <%= label %>
              <% if current %><%= heroicon "check", variant: :micro, options: { class: "size-4 text-rocket", "aria-hidden": true } %><% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% if links[:admin] %>
      <%= render "shared/admin_links/item",
          path: admin_library_media_path(library_media),
          label: "Admin",
          icon: "cog",
          chip: "bg-signal-green" %>
    <% end %>
    <% if links[:remove] %>
      <%= render "shared/admin_links/item",
          path: library_media_path(library_media),
          label: "Remove",
          icon: "trash",
          chip: "bg-signal-red",
          data: { turbo_method: :delete, turbo_confirm: "Remove this media?" } %>
    <% end %>
  <% end %>
<% end %>
