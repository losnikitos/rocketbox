<%# Locals: recipe_run %>
<% recipe_run = local_assigns[:recipe_run] %>
<% if Current.user&.admin? && recipe_run.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "recipe-run-admin-links-#{recipe_run.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: admin_recipe_run_path(recipe_run),
        label: "Admin",
        icon: "cog",
        chip: "bg-signal-green" %>
  <% end %>
<% end %>
