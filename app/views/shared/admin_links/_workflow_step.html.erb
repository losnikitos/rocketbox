<%# Locals: workflow_step %>
<% workflow_step = local_assigns[:workflow_step] %>
<% if Current.user&.admin? && workflow_step.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "workflow-step-admin-links-#{workflow_step.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: admin_workflow_step_path(workflow_step),
        label: "Admin",
        icon: "cog",
        chip: "bg-signal-green" %>
  <% end %>
<% end %>
