<%# Locals: generation %>
<% generation = local_assigns[:generation] %>
<% if Current.user&.admin? && generation.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "generation-admin-links-#{generation.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: admin_generation_path(generation),
        label: "Admin",
        icon: "cog",
        chip: "bg-signal-green" %>
  <% end %>
<% end %>
