<%# Locals: telegram_upload,
    links (optional hash — :avo; default true) %>
<% telegram_upload = local_assigns[:telegram_upload] %>
<% links = { avo: true }.merge(local_assigns.fetch(:links, {})) %>
<% if Current.user&.admin? && telegram_upload.present? && links[:avo] %>
  <% popover_id = "telegram-upload-admin-links-#{telegram_upload.id}" %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id:, align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: avo.resources_telegram_upload_path(telegram_upload),
        label: "Avo",
        icon: "pencil",
        chip: "bg-signal-green" %>
  <% end %>
<% end %>
