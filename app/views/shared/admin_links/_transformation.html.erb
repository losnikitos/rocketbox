<%# Locals: transformation %>
<% transformation = local_assigns[:transformation] %>
<% if Current.user&.admin? && transformation.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "transformation-admin-links-#{transformation.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: admin_transformation_path(transformation),
        label: "Admin",
        icon: "cog",
        chip: "bg-signal-green" %>
    <%= render "shared/admin_links/item",
        path: transformation_path(transformation),
        label: "Delete",
        icon: "trash",
        chip: "bg-signal-red",
        data: { turbo_method: :delete, turbo_confirm: "Delete this transformation?" } %>
  <% end %>
<% end %>
