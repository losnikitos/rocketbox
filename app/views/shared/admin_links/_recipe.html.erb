<%# Locals: recipe %>
<% recipe = local_assigns[:recipe] %>
<% if Current.user&.admin? && recipe.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "recipe-admin-links-#{recipe.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: recipe_path(recipe),
        label: "Remove",
        icon: "trash",
        chip: "bg-signal-red",
        data: { turbo_method: :delete, turbo_confirm: "Remove this recipe?" } %>
  <% end %>
<% end %>
