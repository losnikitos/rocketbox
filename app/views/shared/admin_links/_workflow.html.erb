<%# Locals: workflow %>
<% workflow = local_assigns[:workflow] %>
<% if Current.user&.admin? && workflow.present? %>
  <%= render layout: "shared/admin_links/menu", locals: { popover_id: "workflow-admin-links-#{workflow.id}", align: local_assigns.fetch(:align, :right) } do %>
    <%= render "shared/admin_links/item",
        path: admin_workflow_path(workflow),
        label: "Admin",
        icon: "cog",
        chip: "bg-signal-green" %>
  <% end %>
<% end %>
