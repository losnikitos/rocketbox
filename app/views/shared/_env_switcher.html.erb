<%
  environments = {
    "Dev" => "https://dev.rocketbox.plus",
    "Production" => "https://rocketbox.plus"
  }
%>
<% if Current.user&.admin? %>
  <div data-controller="env-switcher"
       data-action="keydown@document->env-switcher#keydown keyup@document->env-switcher#keyup blur@window->env-switcher#hide"
       class="fixed inset-0 z-50 flex items-center justify-center"
       hidden>
    <div role="listbox" aria-label="Environment" class="min-w-56 space-y-1 rounded-2xl bg-white p-3 text-ink-900 shadow-2xl">
      <% environments.each do |label, origin| %>
        <div role="option" data-env-switcher-target="option" data-origin="<%= origin %>"
             class="cursor-default rounded-xl px-4 py-3 text-center text-lg font-medium aria-selected:bg-ink-900/10">
          <%= label %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
