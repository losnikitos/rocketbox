<%# locals: (name:, selected:, label:, multiple: false, css: "min-w-0 flex-1", padding: "py-1.5") %>
<%# Searchable tag dropdown on the pick controller: one tag id (blank is any tag) into `name`, or with `multiple`
    any number of `selected` ids as `name` checkboxes, a blank first so none clears them. %>
<% tags = Tag.ordered.to_a %>
<% counts = Current.account.library_media.joins(:tags).group("tags.id").count %>
<% placeholder = multiple ? "No tags" : "Any tag" %>
<% chip = ->(item) do
     tag.span class: "flex min-w-0 items-center gap-1.5" do
       safe_join [ render("accounts/tags/tag", tag: item), tag.span(counts[item.id], class: "shrink-0 text-xs tabular-nums text-ink-400") ]
     end
   end %>
<% option_css = "flex w-full cursor-pointer items-center gap-2 rounded-lg px-2 py-1.5 text-left text-sm text-ink-700 hover:bg-ink-900/5 focus-visible:ring-2 focus-visible:ring-rocket/30 focus-visible:outline-none" %>
<%= tag.div class: "group #{css}", data: { controller: "pick", pick_multiple_value: multiple } do %>
  <% if multiple %>
    <%= hidden_field_tag name, "", id: nil %>
  <% else %>
    <%= hidden_field_tag name, selected, id: nil, data: { pick_target: "input" } %>
  <% end %>
  <template data-pick-target="placeholder"><span class="text-ink-500"><%= placeholder %></span></template>
  <button type="button" data-pick-target="trigger" aria-label="<%= label %>"
          class="flex w-full min-w-0 cursor-pointer items-center gap-1 <%= padding %> pr-2 pl-2.5 text-left text-sm focus:outline-none">
    <span data-pick-target="preview" class="flex min-h-5.5 min-w-0 flex-1 flex-wrap items-center gap-1">
      <% if (picked = tags.select { Array(selected).map(&:to_s).include?(it.id.to_s) }).any? %>
        <%= safe_join picked.map(&chip) %>
      <% else %>
        <span class="text-ink-500"><%= placeholder %></span>
      <% end %>
    </span>
    <%= heroicon "chevron-down", variant: :mini, options: { class: "size-4 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
  </button>
  <div popover data-pick-target="popover" data-action="toggle->pick#opened"
       class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-[anchor-size(width)] min-w-60 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-1 shadow-lg">
    <div class="sticky -top-1 z-10 -mx-1 -mt-1 mb-1 border-b border-ink-900/10 bg-white p-1">
      <input type="search" placeholder="Search tags" aria-label="Search tags" autocomplete="off"
             data-pick-target="search" data-action="input->pick#filter keydown.enter->pick#pickFirst"
             class="w-full rounded-md px-2 py-1.5 text-sm placeholder:text-ink-400 focus:outline-none">
    </div>
    <% if multiple %>
      <% tags.each do |item| %>
        <label data-pick-target="option" class="<%= option_css %> has-checked:bg-rocket/10">
          <%= chip.(item) %>
          <%= check_box_tag name, item.id, selected.include?(item.id), id: nil, data: { action: "pick#show" }, class: "ml-auto size-4 shrink-0 accent-rocket" %>
        </label>
      <% end %>
    <% else %>
      <%= tag.button type: "button", value: "", data: { pick_target: "option", action: "pick#pick" }, class: "#{option_css} aria-[current=true]:bg-rocket/10" do %>
        <span class="text-ink-500">Any tag</span>
      <% end %>
      <div data-pick-target="separator" class="mx-2 my-1 h-px bg-ink-900/10" aria-hidden="true"></div>
      <% tags.each do |item| %>
        <%= tag.button type: "button", value: item.id, data: { pick_target: "option", action: "pick#pick" }, class: "#{option_css} aria-[current=true]:bg-rocket/10" do %>
          <%= chip.(item) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
