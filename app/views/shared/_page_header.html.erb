<header class="-mx-4 mb-10 border-b border-ink-900/10 bg-white/50 px-4 pb-6 pt-8 backdrop-blur sm:-mx-6 sm:px-6 sm:pt-12 lg:-mx-8 lg:px-8 lg:pt-12">
  <nav class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between" aria-label="Primary">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
      <%= render "shared/logo" %>
      <%= link_to "Home", root_path, class: class_names("font-medium transition-colors", (current_page?(root_path) ? "text-ink-900" : "text-ink-500 hover:text-ink-900")), aria: (current_page?(root_path) ? { current: "page" } : {}) %>
      <% use_cases_active = controller_name == "use_cases" %>
      <button type="button"
              popovertarget="use-cases-menu"
              style="anchor-name: --use-cases-menu"
              class="<%= class_names("font-medium transition-colors", (use_cases_active ? "text-ink-900" : "text-ink-500 hover:text-ink-900")) %>"
              <% if use_cases_active %>aria-current="page"<% end %>>
        Use cases
      </button>
      <div id="use-cases-menu" popover
           style="position-anchor: --use-cases-menu"
           class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] min-w-44 rounded-lg border border-ink-900/15 bg-white p-1 shadow-lg">
        <% UseCasesController::REGISTRY.each do |slug, use_case| %>
          <%= link_to use_case[:label], use_case_path(slug),
                class: class_names(
                  "block rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors",
                  (params[:slug] == slug ? "bg-ink-900/5 text-ink-900" : "text-ink-500 hover:bg-ink-900/5 hover:text-ink-900")
                ),
                aria: (params[:slug] == slug ? { current: "page" } : {}) %>
        <% end %>
      </div>
      <% if Current.user %>
        <%= link_to "Library", library_path, class: class_names("font-medium transition-colors", (current_page?(library_path) ? "text-ink-900" : "text-ink-500 hover:text-ink-900")), aria: (current_page?(library_path) ? { current: "page" } : {}) %>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-3 sm:justify-end">
      <% if Current.user %>
        <%= link_to "My account", account_path, class: "rb-btn-ghost px-3 py-2 text-sm" %>
      <% else %>
        <%= link_to "Sign in", sign_in_path, class: "rb-btn-ghost px-3 py-2 text-sm" %>
      <% end %>
    </div>
  </nav>
</header>
