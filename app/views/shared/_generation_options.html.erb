<%# locals: (record:, scope:, refresh_url:) %>
<%# A model switch reloads just this frame through the hidden refresh button, so other fields and picked files stay. %>
<turbo-frame id="generation_options" class="block space-y-4">
  <% record.option_choices.each do |key, choices| %>
    <% if key == "model" %>
      <div>
        <div class="flex items-baseline justify-between gap-2">
          <span id="<%= scope %>_options_model" class="<%= tw_label_classes %>">Model</span>
          <% if Current.user&.admin? %>
            <%= link_to "Manage models", admin_models_path(account: nil), target: "_top", class: "text-xs text-ink-600 underline hover:text-ink-900" %>
          <% end %>
        </div>
        <div role="radiogroup" aria-labelledby="<%= scope %>_options_model" class="divide-y divide-ink-900/10 overflow-hidden rounded-xl border border-ink-900/15 bg-white">
          <% record.models.each do |model| %>
            <label class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2 text-sm font-medium text-ink-900 transition hover:bg-stone-50">
              <span class="flex-1"><%= model.model_id %></span>
              <% if (band = model.price_band) %>
                <span role="img" aria-label="Price <%= "£" * band %>" title="<%= "£" * band %>" class="inline-flex">
                  <% 3.times do |i| %>
                    <%= heroicon "currency-pound", variant: :micro, options: { class: "size-4 #{i < band ? "text-ink-700" : "text-ink-900/15"}" } %>
                  <% end %>
                </span>
              <% end %>
              <%= radio_button_tag "#{scope}[options][model]", model.model_id, record.options["model"] == model.model_id, class: "size-4 shrink-0 accent-rocket",
                    onchange: "this.form.requestSubmit(this.form.elements.refresh)" %>
            </label>
          <% end %>
        </div>
      </div>
      <% next %>
    <% end %>
    <% if key == "aspect_ratio" && record.provider == "openai" %>
      <fieldset>
        <legend class="<%= tw_label_classes %>">Aspect ratio</legend>
        <div class="<%= tw_segments_classes %>">
          <% shapes = { "9:16" => [ "Story", "h-6 aspect-9/16" ], "4:5" => [ "Portrait", "h-6 aspect-4/5" ],
                        "1:1" => [ "Square", "h-5 aspect-square" ], "4:3" => [ "Classic", "w-6 aspect-4/3" ],
                        "16:9" => [ "Landscape", "w-7 aspect-video" ] } %>
          <% choices.each do |value| %>
            <% name, shape = shapes.fetch(value) %>
            <label class="<%= tw_segment_classes %> flex flex-col items-center gap-1 p-2 before:inset-y-4">
              <%= radio_button_tag "#{scope}[options][aspect_ratio]", value, record.options["aspect_ratio"] == value, class: "sr-only" %>
              <span class="flex h-6 items-center"><span class="<%= shape %> rounded-sm border-2 border-current text-ink-700" aria-hidden="true"></span></span>
              <span class="text-sm font-medium text-ink-900"><%= name %></span>
              <span class="text-xs text-ink-500"><%= value %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <% next %>
    <% end %>
    <% if key == "quality" || (key == "resolution" && !record.video?) %>
      <fieldset>
        <legend class="<%= tw_label_classes %>"><%= key == "quality" ? "Quality" : "Size" %></legend>
        <div class="<%= tw_segments_classes %>">
          <% [ ("" if key == "quality"), *choices ].compact.each do |value| %>
            <label class="<%= tw_segment_classes %> px-3 py-1.5 text-center text-sm font-medium text-ink-900 before:inset-y-2">
              <%= radio_button_tag "#{scope}[options][#{key}]", value, record.options[key].to_s == value, class: "sr-only" %>
              <%= value.blank? ? "Auto" : key == "quality" ? value.capitalize : value.upcase %>
            </label>
          <% end %>
        </div>
      </fieldset>
      <% next %>
    <% end %>
    <div>
      <%= label_tag "#{scope}_options_#{key}", key.humanize, class: tw_label_classes %>
      <%= select_tag "#{scope}[options][#{key}]",
            options_for_select(choices.map { [ key == "duration" ? "#{it} s" : it, it ] }, record.options[key]),
            id: "#{scope}_options_#{key}", include_blank: "Auto", class: tw_input_classes %>
    </div>
  <% end %>
  <%= tag.button name: "refresh", formaction: refresh_url, formmethod: "get", formnovalidate: true, hidden: true, data: { turbo_frame: "generation_options" } %>
</turbo-frame>
