<%# locals: (name:, selected:, label: "Source image") %>
<%# Media bank image dropdown. Value is the LibraryMedia bank id. %>
<% items = LibraryMedia.bank.with_attached_file.includes(:tags).order(created_at: :desc).to_a %>
<% selected_id = selected.to_s.presence %>
<% selected_media = items.find { it.id.to_s == selected_id } %>
<% value = selected_media&.id.to_s %>
<% chip = ->(media) do
     tags = media.tags.ordered.map { "##{it.name}" }.join(" ")
     tag.span class: "flex min-w-0 items-center gap-2" do
       safe_join [
         (if media.file.attached? && media.file.representable?
            image_tag(media.file.representation(resize_to_fill: [ 64, 64 ]), alt: "", loading: "lazy",
              class: "size-8 shrink-0 rounded-md bg-ink-900/5 object-cover")
          else
            tag.span(class: "size-8 shrink-0 rounded-md bg-ink-900/5")
          end),
         tag.span(class: "min-w-0 truncate") do
           safe_join [
             tag.span("##{media.id}", class: "font-medium text-ink-900"),
             (tag.span(" #{tags}", class: "text-ink-500") if tags.present?)
           ]
         end
       ]
     end
   end %>
<div data-controller="pick" class="group rounded-lg border border-ink-900/15 bg-white focus-within:border-rocket focus-within:ring-2 focus-within:ring-rocket/30">
  <%= hidden_field_tag name, value, id: nil, data: { pick_target: "input" } %>
  <template data-pick-target="placeholder"><span class="text-ink-500">Choose source image</span></template>
  <button type="button" data-pick-target="trigger" aria-label="<%= label %>"
          class="flex w-full min-w-0 cursor-pointer items-center gap-2 py-1.5 pr-2 pl-2.5 text-left text-sm focus:outline-none">
    <span data-pick-target="preview" class="flex min-h-8 min-w-0 flex-1 items-center">
      <% if selected_media %><%= chip.(selected_media) %><% else %><span class="text-ink-500">Choose source image</span><% end %>
    </span>
    <%= heroicon "chevron-down", variant: :mini, options: { class: "size-4 shrink-0 text-ink-400 transition group-has-[:popover-open]:rotate-180", "aria-hidden": true } %>
  </button>
  <div popover data-pick-target="popover" data-action="toggle->pick#opened"
       class="inset-auto m-0 top-[calc(anchor(bottom)+4px)] left-[calc(anchor(left))] [position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] max-h-96 w-[anchor-size(width)] min-w-72 overflow-y-auto rounded-xl border border-ink-900/15 bg-white p-1 shadow-lg">
    <div class="sticky -top-1 z-10 -mx-1 -mt-1 mb-1 border-b border-ink-900/10 bg-white p-1">
      <input type="search" placeholder="Search media bank" aria-label="Search media bank" autocomplete="off"
             data-pick-target="search" data-action="input->pick#filter keydown.enter->pick#pickFirst"
             class="w-full rounded-md px-2 py-1.5 text-sm placeholder:text-ink-400 focus:outline-none">
    </div>
    <% if items.empty? %>
      <p class="px-2 py-3 text-sm text-ink-500">No images yet. Upload in Media bank.</p>
    <% else %>
      <% items.each do |media| %>
        <%= tag.button type: "button", value: media.id,
              aria: { current: ("true" if media == selected_media) },
              data: { pick_target: "option", action: "pick#pick" },
              class: "flex w-full cursor-pointer rounded-lg px-2 py-1.5 text-left text-sm text-ink-700 hover:bg-ink-900/5 focus-visible:ring-2 focus-visible:ring-rocket/30 focus-visible:outline-none aria-[current=true]:bg-rocket/10" do %>
          <%= chip.(media) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
